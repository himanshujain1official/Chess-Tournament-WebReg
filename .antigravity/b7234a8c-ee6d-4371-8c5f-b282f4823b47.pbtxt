    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "import React, { useState, useEffect } from \'react\';\nimport { motion } from \'motion/react\';\nimport { Trophy, Users, Calendar, ArrowRight, Play, Flame, Swords, ShieldCheck, Sparkles, Clock } from \'lucide-react\';\nimport { KingIcon, QueenIcon, KnightIcon, BishopIcon, RookIcon } from \'./ChessGraphics\';\n\ninterface HeroProps {\n  onOpenRegister: () => void;\n}\n\nexport const Hero: React.FC<HeroProps> = ({ onOpenRegister }) => {\n  // Countdown Timer to Tournament Kickoff (Mock target date)\n  const [timeLeft, setTimeLeft] = useState({\n    days: 4,\n    hours: 14,\n    minutes: 32,\n    seconds: 45\n  });\n\n  useEffect(() => {\n    const timer = setInterval(() => {\n      setTimeLeft(prev => {\n        if (prev.seconds > 0) {\n          return { ...prev, seconds: prev.seconds - 1 };\n        } else if (prev.minutes > 0) {\n          return { ...prev, minutes: 59, seconds: 59 };\n        } else if (prev.hours > 0) {\n          return { ...prev, hours: prev.hours - 1, minutes: 59, seconds: 59 };\n        } else if (prev.days > 0) {\n          return { ...prev, days: prev.days - 1, hours: 23, minutes: 59, seconds: 59 };\n        }\n        return prev;\n      });\n    }, 1000);\n    return () => clearInterval(timer);\n  }, []);\n\n  return (\n    <section id=\"hero\" className=\"relative min-h-screen flex items-center justify-center pt-24 pb-16 overflow-hidden chess-grid-bg\">\n      {/* Dynamic Ambient Background Glows */}\n      <div className=\"absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] sm:w-[800px] h-[400px] bg-gradient-to-tr from-violet-600/25 via-indigo-600/20 to-amber-500/15 blur-[120px] rounded-full pointer-events-none -z-10\" />\n      <div className=\"absolute bottom-10 left-10 w-72 h-72 bg-violet-600/15 blur-[90px] rounded-full pointer-events-none -z-10\" />\n      <div className=\"absolute top-20 right-10 w-80 h-80 bg-amber-500/10 blur-[100px] rounded-full pointer-events-none -z-10\" />\n\n      {/* Floating Animated Chess Pieces in Background */}\n      <motion.div\n        animate={{ y: [0, -18, 0], rotate: [0, 5, 0] }}\n        transition={{ duration: 6, repeat: Infinity, ease: \"easeInOut\" }}\n        className=\"hidden lg:block absolute left-8 xl:left-20 top-1/3 opacity-30 text-violet-400 pointer-events-none\"\n      >\n        <KingIcon className=\"w-24 h-24\" glow />\n      </motion.div>\n\n      <motion.div\n        animate={{ y: [0, 20, 0], rotate: [0, -6, 0] }}\n        transition={{ duration: 7, repeat: Infinity, ease: \"easeInOut\", delay: 1 }}\n        className=\"hidden lg:block absolute right-12 xl:right-24 top-1/4 opacity-30 text-amber-400 pointer-events-none\"\n      >\n        <QueenIcon className=\"w-24 h-24\" glow />\n      </motion.div>\n\n      <motion.div\n        animate={{ y: [0, -14, 0], rotate: [0, 8, 0] }}\n        transition={{ duration: 5.5, repeat: Infinity, ease: \"easeInOut\", delay: 0.5 }}\n        className=\"hidden xl:block absolute right-32 bottom-28 opacity-20 text-indigo-400 pointer-events-none\"\n      >\n        <KnightIcon className=\"w-20 h-20\" />\n      </motion.div>\n\n      <motion.div\n        animate={{ y: [0, 15, 0], rotate: [0, -5, 0] }}\n        transition={{ duration: 6.5, repeat: Infinity, ease: \"easeInOut\", delay: 1.5 }}\n        className=\"hidden xl:block absolute left-28 bottom-32 opacity-20 text-purple-400 pointer-events-none\"\n      >\n        <RookIcon className=\"w-20 h-20\" />\n      </motion.div>\n\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full\">\n        {/* Section Badge from Flyer */}\n        <motion.div\n          initial={{ opacity: 0, y: -20 }}\n          animate={{ opacity: 1, y: 0 }}\n          transition={{ duration: 0.6 }}\n          className=\"flex flex-col sm:flex-row items-center justify-between gap-4 mb-6 border-b border-violet-500/20 pb-4\"\n        >\n          <div className=\"flex items-center gap-3\">\n            <span className=\"px-3 py-1 rounded bg-amber-400/10 border border-amber-400/30 text-amber-300 font-mono text-xs font-bold tracking-wider uppercase flex items-center gap-1.5\">\n              <Sparkles className=\"w-3.5 h-3.5 text-amber-400\" />\n              Are you ready to make your move?\n            </span>\n          </div>\n\n          <div className=\"flex items-center gap-4 text-xs font-mono tracking-widest text-slate-400 uppercase\">\n            <span className=\"text-violet-400 font-bold\">STRATEGY</span>\n            <span className=\"text-slate-600\">\342\200\242</span>\n            <span className=\"text-amber-400 font-bold\">FOCUS</span>\n            <span className=\"text-slate-600\">\342\200\242</span>\n            <span className=\"text-emerald-400 font-bold\">VICTORY</span>\n            <span className=\"ml-2 px-2 py-0.5 rounded bg-violet-900/60 border border-violet-500/40 text-violet-300 font-bold\">01</span>\n          </div>\n        </motion.div>\n\n        {/* Main Hero Grid */}\n        <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-center\">\n          \n          {/* Left Column: Headlines & Stats & CTA */}\n          <motion.div\n            initial={{ opacity: 0, x: -30 }}\n            animate={{ opacity: 1, x: 0 }}\n            transition={{ duration: 0.7 }}\n            className=\"lg:col-span-7 text-center lg:text-left\"\n          >\n            {/* Immersive Subtitle */}\n            <h2 className=\"text-[10px] font-bold tracking-[0.4em] text-violet-400 uppercase mb-3\">\n              Grand Invitational 2026 \342\200\242 Inter-College Championship\n            </h2>\n\n            {/* Main Bold Title */}\n            <h1 className=\"text-5xl sm:text-6xl md:text-7xl font-black leading-[0.9] tracking-tight mb-4 uppercase\">\n              CHESS <span className=\"text-gradient-violet\">eSPORTS</span>\n              <br />\n              <span className=\"text-2xl sm:text-4xl text-white font-extrabold tracking-tight\">\n                COMPETE. THINK. CONQUER.\n              </span>\n            </h1>\n\n            {/* Immersive Stat Cards with Left Accent Borders & Glows */}\n            <div className=\"flex flex-col sm:flex-row gap-4 mb-6\">\n              <div className=\"glass p-4 rounded-xl flex-1 border-l-4 border-l-violet-500 glow-violet text-left\">\n                <div className=\"text-2xl sm:text-3xl font-black text-white\">2 DAYS</div>\n                <div className=\"text-[10px] uppercase text-slate-400 font-bold tracking-wider\">Global Event</div>\n              </div>\n\n              <div className=\"glass p-4 rounded-xl flex-1 border-l-4 border-l-amber-500 glow-gold text-left\">\n                <div className=\"text-2xl sm:text-3xl font-black text-white\">100 PLAYERS</div>\n                <div className=\"text-[10px] uppercase text-slate-400 font-bold tracking-wider\">Swiss System</div>\n              </div>\n\n              <div className=\"glass p-4 rounded-xl flex-1 border-l-4 border-l-emerald-500 text-left\">\n                <div className=\"text-2xl sm:text-3xl font-black text-amber-300\">1 CHAMPION</div>\n                <div className=\"text-[10px] uppercase text-slate-400 font-bold tracking-wider\">Grand Crown</div>\n              </div>\n            </div>\n\n            <p className=\"text-slate-300 text-sm sm:text-base leading-relaxed mb-8 pr-0 lg:pr-8\">\n              Experience the ultimate fusion of classic strategy and modern competitive gaming. 100 collegiate tacticians clash under stadium lights with real-time sensor boards and live grandmaster commentary.\n            </p>\n\n            {/* Action Buttons */}\n            <div className=\"flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 mb-8\">\n              <button\n                id=\"hero-register-btn\"\n                onClick={onOpenRegister}\n                className=\"w-full sm:w-64 py-4 bg-violet-600 hover:bg-violet-500 text-white font-bold rounded-lg uppercase tracking-widest shadow-lg shadow-violet-500/25 hover:shadow-violet-500/40 transition-all flex items-center justify-center gap-2 group\"\n              >\n                <Flame className=\"w-5 h-5 text-amber-300 group-hover:scale-110 transition-transform\" />\n                <span>Register Now</span>\n                <ArrowRight className=\"w-4 h-4 group-hover:translate-x-1 transition-transform\" />\n              </button>\n\n              <a\n                href=\"#schedule\"\n                id=\"hero-view-schedule-btn\"\n                className=\"w-full sm:w-auto px-6 py-4 glass border-white/10 hover:border-violet-500/40 text-slate-300 hover:text-white font-bold text-xs uppercase tracking-widest rounded-lg transition-all flex items-center justify-center gap-2\"\n              >\n                <Calendar className=\"w-4 h-4 text-violet-400\" />\n                <span>Explore Schedule</span>\n              </a>\n            </div>\n\n            {/* Tournament Format Box from Immersive UI Spec */}\n            <div className=\"glass p-5 sm:p-6 rounded-2xl text-left\">\n              <h3 className=\"text-xs font-bold uppercase tracking-widest mb-4 text-slate-300 flex items-center justify-between\">\n                <span>Tournament Format</span>\n                <span className=\"text-[10px] font-mono text-violet-400\">10m + 5s Rapid</span>\n              </h3>\n              <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n                <div className=\"flex items-center gap-3\">\n                  <div className=\"w-8 h-8 rounded-full bg-violet-900/50 flex items-center justify-center text-xs font-mono font-bold text-white border border-violet-500 shrink-0\">\n                    01\n                  </div>\n                  <div>\n                    <p className=\"text-xs font-bold text-white\">Day 1: Swiss Rounds</p>\n                    <p className=\"text-[10px] text-slate-400\">5 Rounds \342\200\242 Top 32 Qualify</p>\n                  </div>\n                </div>\n\n                <div className=\"flex items-center gap-3\">\n                  <div className=\"w-8 h-8 rounded-full bg-slate-800 flex items-center justify-center text-xs font-mono font-bold text-amber-400 border border-slate-700 shrink-0\">\n                    02\n                  </div>\n                  <div>\n                    <p className=\"text-xs font-bold text-white\">Day 2: Knockouts</p>\n                    <p className=\"text-[10px] text-slate-400\">Best of 3 \342\200\242 Blitz / Armageddon</p>\n                  </div>\n                </div>\n              </div>\n            </div>\n          </motion.div>\n\n          {/* Right Column: Visual eSports Trophy & Countdown Card */}\n          <motion.div\n            initial={{ opacity: 0, x: 30 }}\n            animate={{ opacity: 1, x: 0 }}\n            transition={{ duration: 0.7, delay: 0.2 }}\n            className=\"lg:col-span-5\"\n          >\n            <div className=\"relative rounded-2xl p-6 sm:p-8 glass glow-violet border-white/10 overflow-hidden shadow-2xl\">\n              \n              {/* Corner decorative light */}\n              <div className=\"absolute top-0 right-0 w-32 h-32 bg-amber-400/10 rounded-full blur-2xl\" />\n              <div className=\"absolute bottom-0 left-0 w-32 h-32 bg-violet-600/20 rounded-full blur-2xl\" />\n\n              {/* Tournament Centerpiece Visual */}\n              <div className=\"relative text-center mb-6\">\n                <div className=\"relative inline-block mx-auto mb-3\">\n                  {/* Glowing Trophy Ring */}\n                  <div className=\"w-24 h-24 sm:w-28 sm:h-28 rounded-2xl bg-gradient-to-b from-amber-400/20 via-violet-600/20 to-indigo-900/40 border border-amber-400/40 flex items-center justify-center relative shadow-2xl shadow-amber-500/20 group\">\n                    <KingIcon className=\"w-14 h-14 sm:w-16 sm:h-16 text-amber-400 drop-shadow-[0_0_20px_rgba(251,191,36,0.6)]\" glow />\n                    \n                    {/* Orbiting piece badge */}\n                    <div className=\"absolute -top-2 -right-2 w-7 h-7 rounded-lg bg-violet-600 border border-violet-400 flex items-center justify-center text-white shadow-lg\">\n                      <Swords className=\"w-3.5 h-3.5 text-amber-300\" />\n                    </div>\n                  </div>\n                </div>\n\n                <h2 className=\"text-lg sm:text-xl font-display font-extrabold text-white tracking-wide uppercase\">\n                  Championship Countdown\n                </h2>\n                <p className=\"text-[10px] text-slate-400 font-mono mt-0.5\">\n                  Official Kickoff & First Board Move\n                </p>\n              </div>\n\n              {/* Live Ticking Countdown Timer */}\n              <div className=\"grid grid-cols-4 gap-2 sm:gap-3 mb-6\">\n                <div className=\"flex flex-col items-center justify-center p-3 rounded-xl bg-black/40 border border-white/5\">\n                  <span className=\"font-mono text-2xl sm:text-3xl font-black text-amber-400\">\n                    {String(timeLeft.days).padStart(2, \'0\')}\n                  </span>\n                  <span className=\"text-[9px] font-mono uppercase tracking-wider text-slate-400 mt-1\">Days</span>\n                </div>\n\n                <div className=\"flex flex-col items-center justify-center p-3 rounded-xl bg-black/40 border border-white/5\">\n                  <span className=\"font-mono text-2xl sm:text-3xl font-black text-white\">\n                    {String(timeLeft.hours).padStart(2, \'0\')}\n                  </span>\n                  <span className=\"text-[9px] font-mono uppercase tracking-wider text-slate-400 mt-1\">Hours</span>\n                </div>\n\n                <div className=\"flex flex-col items-center justify-center p-3 rounded-xl bg-black/40 border border-white/5\">\n                  <span className=\"font-mono text-2xl sm:text-3xl font-black text-white\">\n                    {String(timeLeft.minutes).padStart(2, \'0\')}\n                  </span>\n                  <span className=\"text-[9px] font-mono uppercase tracking-wider text-slate-400 mt-1\">Mins</span>\n                </div>\n\n                <div className=\"flex flex-col items-center justify-center p-3 rounded-xl bg-black/40 border border-white/5\">\n                  <span className=\"font-mono text-2xl sm:text-3xl font-black text-violet-400 animate-pulse\">\n                    {String(timeLeft.seconds).padStart(2, \'0\')}\n                  </span>\n                  <span className=\"text-[9px] font-mono uppercase tracking-wider text-slate-400 mt-1\">Secs</span>\n                </div>\n              </div>\n\n              {/* Tournament Key Highlights Pill */}\n              <div className=\"space-y-2 pt-2 border-t border-white/10 text-xs text-slate-300\">\n                <div className=\"flex items-center justify-between p-2 rounded-lg bg-white/5 border border-white/5\">\n                  <span className=\"text-slate-400 flex items-center gap-2 text-xs\">\n                    <ShieldCheck className=\"w-3.5 h-3.5 text-emerald-400\" />\n                    Rating Cap\n                  </span>\n                  <span className=\"font-mono font-bold text-xs text-white\">Open to All Tiers</span>\n                </div>\n\n                <div className=\"flex items-center justify-between p-2 rounded-lg bg-white/5 border border-white/5\">\n                  <span className=\"text-slate-400 flex items-center gap-2 text-xs\">\n                    <Clock className=\"w-3.5 h-3.5 text-violet-400\" />\n                    Time Control\n                  </span>\n                  <span className=\"font-mono font-bold text-xs text-white\">10m + 5s Rapid</span>\n                </div>\n\n                <div className=\"flex items-center justify-between p-2 rounded-lg bg-white/5 border border-white/5\">\n                  <span className=\"text-slate-400 flex items-center gap-2 text-xs\">\n                    <Trophy className=\"w-3.5 h-3.5 text-amber-400\" />\n                    Grand Awards\n                  </span>\n                  <span className=\"font-mono font-bold text-xs text-amber-300\">8 Official Titles</span>\n                </div>\n              </div>\n\n            </div>\n          </motion.div>\n\n        </div>\n      </div>\n    </section>\n  );\n};"
      replacement_content: "import React, { useState, useEffect } from \'react\';\nimport { motion } from \'motion/react\';\nimport { Trophy, Calendar, ArrowRight, Clock, ShieldCheck } from \'lucide-react\';\nimport { KingIcon } from \'./ChessGraphics\';\n\ninterface HeroProps {\n  onOpenRegister: () => void;\n}\n\nexport const Hero: React.FC<HeroProps> = ({ onOpenRegister }) => {\n  const [timeLeft, setTimeLeft] = useState({\n    days: 4,\n    hours: 14,\n    minutes: 32,\n    seconds: 45\n  });\n\n  useEffect(() => {\n    const timer = setInterval(() => {\n      setTimeLeft(prev => {\n        if (prev.seconds > 0) {\n          return { ...prev, seconds: prev.seconds - 1 };\n        } else if (prev.minutes > 0) {\n          return { ...prev, minutes: 59, seconds: 59 };\n        } else if (prev.hours > 0) {\n          return { ...prev, hours: prev.hours - 1, minutes: 59, seconds: 59 };\n        } else if (prev.days > 0) {\n          return { ...prev, days: prev.days - 1, hours: 23, minutes: 59, seconds: 59 };\n        }\n        return prev;\n      });\n    }, 1000);\n    return () => clearInterval(timer);\n  }, []);\n\n  return (\n    <section id=\"hero\" className=\"relative min-h-[90vh] flex items-center justify-center pt-28 pb-20 overflow-hidden bw-grid-bg\">\n      {/* Dynamic Ambient Background Shadow & Vignette */}\n      <div className=\"absolute inset-0 bw-radial-shadow pointer-events-none\" />\n      <div className=\"absolute top-0 left-0 right-0 h-40 bg-gradient-to-b from-black to-transparent pointer-events-none\" />\n      <div className=\"absolute bottom-0 left-0 right-0 h-40 bg-gradient-to-t from-black to-transparent pointer-events-none\" />\n\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full relative z-10\">\n        \n        {/* Top Minimal Badge */}\n        <motion.div\n          initial={{ opacity: 0, y: -15 }}\n          animate={{ opacity: 1, y: 0 }}\n          transition={{ duration: 0.5 }}\n          className=\"flex flex-col sm:flex-row items-center justify-between gap-4 mb-8 border-b border-zinc-800 pb-4\"\n        >\n          <div className=\"flex items-center gap-2\">\n            <span className=\"w-2 h-2 rounded-full bg-white animate-ping\" />\n            <span className=\"text-zinc-400 font-mono text-xs font-semibold tracking-widest uppercase\">\n              INTER-COLLEGE INVITATIONAL \342\200\242 2026\n            </span>\n          </div>\n\n          <div className=\"flex items-center gap-3 text-xs font-mono tracking-widest text-zinc-400 uppercase\">\n            <span className=\"text-white font-bold\">STRATEGY</span>\n            <span className=\"text-zinc-700\">\342\200\242</span>\n            <span className=\"text-white font-bold\">FOCUS</span>\n            <span className=\"text-zinc-700\">\342\200\242</span>\n            <span className=\"text-white font-bold\">VICTORY</span>\n          </div>\n        </motion.div>\n\n        {/* Main Hero Content Grid */}\n        <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center\">\n          \n          {/* Left Column: Headlines & Pillars */}\n          <motion.div\n            initial={{ opacity: 0, x: -20 }}\n            animate={{ opacity: 1, x: 0 }}\n            transition={{ duration: 0.6 }}\n            className=\"lg:col-span-7 text-center lg:text-left\"\n          >\n            <div className=\"inline-block px-3 py-1 mb-4 rounded border border-zinc-800 bg-zinc-950 text-zinc-400 font-mono text-xs uppercase tracking-widest\">\n              Are you ready to make your move?\n            </div>\n\n            {/* Main Bold Monochrome Title */}\n            <h1 className=\"text-5xl sm:text-6xl md:text-7xl font-black leading-[0.92] tracking-tight mb-5 uppercase text-white font-display\">\n              CHESS <span className=\"text-zinc-400 font-light\">eSPORTS</span>\n              <br />\n              <span className=\"text-2xl sm:text-3xl text-zinc-300 font-medium tracking-normal block mt-2\">\n                COMPETE. THINK. CONQUER.\n              </span>\n            </h1>\n\n            {/* Minimal Stat Cards in Black & White */}\n            <div className=\"grid grid-cols-3 gap-3 mb-6\">\n              <div className=\"bw-card p-4 rounded-lg text-left\">\n                <div className=\"text-2xl sm:text-3xl font-mono font-bold text-white\">2 DAYS</div>\n                <div className=\"text-[10px] font-mono uppercase text-zinc-400 font-medium tracking-wider\">Tournament</div>\n              </div>\n\n              <div className=\"bw-card p-4 rounded-lg text-left\">\n                <div className=\"text-2xl sm:text-3xl font-mono font-bold text-white\">100</div>\n                <div className=\"text-[10px] font-mono uppercase text-zinc-400 font-medium tracking-wider\">Players Max</div>\n              </div>\n\n              <div className=\"bw-card p-4 rounded-lg text-left\">\n                <div className=\"text-2xl sm:text-3xl font-mono font-bold text-white\">1</div>\n                <div className=\"text-[10px] font-mono uppercase text-zinc-400 font-medium tracking-wider\">Grand Champion</div>\n              </div>\n            </div>\n\n            <p className=\"text-zinc-400 text-sm sm:text-base leading-relaxed mb-8 max-w-2xl\">\n              The premier collegiate chess championship bringing 100 tacticians together in standard Swiss rounds and sudden-death knockout eliminations under official FIDE rapid regulations.\n            </p>\n\n            {/* Action Buttons */}\n            <div className=\"flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 mb-8\">\n              <button\n                id=\"hero-register-btn\"\n                onClick={onOpenRegister}\n                className=\"w-full sm:w-auto px-8 py-3.5 bw-btn-primary font-mono font-bold text-xs uppercase tracking-wider rounded-md flex items-center justify-center gap-2 group\"\n              >\n                <span>Register Now</span>\n                <ArrowRight className=\"w-4 h-4 group-hover:translate-x-1 transition-transform\" />\n              </button>\n\n              <a\n                href=\"#schedule\"\n                id=\"hero-view-schedule-btn\"\n                className=\"w-full sm:w-auto px-6 py-3.5 bw-btn-secondary font-mono font-semibold text-xs uppercase tracking-wider rounded-md flex items-center justify-center gap-2\"\n              >\n                <Calendar className=\"w-4 h-4 text-zinc-400\" />\n                <span>Explore Timeline</span>\n              </a>\n            </div>\n\n            {/* Format Summary Mini Bar */}\n            <div className=\"bw-card p-4 rounded-lg flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 text-xs font-mono text-zinc-300\">\n              <div className=\"flex items-center gap-2\">\n                <Clock className=\"w-4 h-4 text-zinc-400\" />\n                <span>Time Control: <strong>10m + 5s Rapid</strong></span>\n              </div>\n              <div className=\"flex items-center gap-2\">\n                <ShieldCheck className=\"w-4 h-4 text-zinc-400\" />\n                <span>Format: <strong>5 Swiss Rounds + Top 32 Knockouts</strong></span>\n              </div>\n            </div>\n          </motion.div>\n\n          {/* Right Column: Shadowed Countdown & Event Specification Card */}\n          <motion.div\n            initial={{ opacity: 0, x: 20 }}\n            animate={{ opacity: 1, x: 0 }}\n            transition={{ duration: 0.6, delay: 0.15 }}\n            className=\"lg:col-span-5\"\n          >\n            <div className=\"bw-panel-deep p-6 sm:p-8 rounded-xl relative overflow-hidden\">\n              \n              {/* Header */}\n              <div className=\"text-center mb-6 pb-6 border-b border-zinc-800\">\n                <div className=\"w-16 h-16 mx-auto mb-3 rounded-lg bg-zinc-900 border border-zinc-700 flex items-center justify-center text-white shadow-inner\">\n                  <KingIcon className=\"w-9 h-9\" />\n                </div>\n                <h3 className=\"text-lg font-display font-bold text-white tracking-wider uppercase\">\n                  Tournament Countdown\n                </h3>\n                <p className=\"text-xs font-mono text-zinc-400 mt-1\">\n                  Official Match Day Kickoff\n                </p>\n              </div>\n\n              {/* Countdown Digits */}\n              <div className=\"grid grid-cols-4 gap-2 mb-6\">\n                <div className=\"flex flex-col items-center justify-center p-3 rounded bg-zinc-900 border border-zinc-800\">\n                  <span className=\"font-mono text-2xl sm:text-3xl font-bold text-white\">\n                    {String(timeLeft.days).padStart(2, \'0\')}\n                  </span>\n                  <span className=\"text-[9px] font-mono uppercase tracking-widest text-zinc-400 mt-1\">Days</span>\n                </div>\n\n                <div className=\"flex flex-col items-center justify-center p-3 rounded bg-zinc-900 border border-zinc-800\">\n                  <span className=\"font-mono text-2xl sm:text-3xl font-bold text-white\">\n                    {String(timeLeft.hours).padStart(2, \'0\')}\n                  </span>\n                  <span className=\"text-[9px] font-mono uppercase tracking-widest text-zinc-400 mt-1\">Hours</span>\n                </div>\n\n                <div className=\"flex flex-col items-center justify-center p-3 rounded bg-zinc-900 border border-zinc-800\">\n                  <span className=\"font-mono text-2xl sm:text-3xl font-bold text-white\">\n                    {String(timeLeft.minutes).padStart(2, \'0\')}\n                  </span>\n                  <span className=\"text-[9px] font-mono uppercase tracking-widest text-zinc-400 mt-1\">Mins</span>\n                </div>\n\n                <div className=\"flex flex-col items-center justify-center p-3 rounded bg-zinc-900 border border-zinc-800\">\n                  <span className=\"font-mono text-2xl sm:text-3xl font-bold text-white\">\n                    {String(timeLeft.seconds).padStart(2, \'0\')}\n                  </span>\n                  <span className=\"text-[9px] font-mono uppercase tracking-widest text-zinc-400 mt-1\">Secs</span>\n                </div>\n              </div>\n\n              {/* Event Specification List */}\n              <div className=\"space-y-2 text-xs font-mono text-zinc-300\">\n                <div className=\"flex items-center justify-between py-2 border-b border-zinc-800/80\">\n                  <span className=\"text-zinc-400\">Total Capacity</span>\n                  <span className=\"text-white font-bold\">100 Players</span>\n                </div>\n\n                <div className=\"flex items-center justify-between py-2 border-b border-zinc-800/80\">\n                  <span className=\"text-zinc-400\">Eligibility</span>\n                  <span className=\"text-white font-bold\">Open to All Ratings</span>\n                </div>\n\n                <div className=\"flex items-center justify-between py-2 border-b border-zinc-800/80\">\n                  <span className=\"text-zinc-400\">Prizes & Honours</span>\n                  <span className=\"text-white font-bold\">8 Official Awards</span>\n                </div>\n\n                <div className=\"flex items-center justify-between py-2\">\n                  <span className=\"text-zinc-400\">Chief Arbiter</span>\n                  <span className=\"text-white font-bold\">FIDE Certified Panel</span>\n                </div>\n              </div>\n\n            </div>\n          </motion.div>\n\n        </div>\n      </div>\n    </section>\n  );\n};"
    }
