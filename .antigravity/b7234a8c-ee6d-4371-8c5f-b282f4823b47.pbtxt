        }
        lines {
          text: "                <div className=\"pt-3 border-t border-white/10 flex items-center justify-between text-[11px] font-mono text-slate-400\">"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "                  <span>Day 1 Swiss Round 1: 10:00 AM</span>"
