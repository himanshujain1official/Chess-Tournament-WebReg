  file_change {
    absolute_path_uri: "file:///src/index.css"
    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "@import \"tailwindcss\";\n\n@layer base {\n  body {\n    font-family: \'Outfit\', -apple-system, BlinkMacSystemFont, \'Segoe UI\', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;\n  }\n  \n  h1, h2, h3, h4, h5, h6, .font-display {\n    font-family: \'Rajdhani\', \'Outfit\', sans-serif;\n    letter-spacing: 0.02em;\n  }\n\n  .font-mono {\n    font-family: \'JetBrains Mono\', monospace;\n  }\n}\n\n/* Glassmorphism & eSports Glow Styles */\n.glass-panel {\n  background: rgba(15, 23, 42, 0.7);\n  backdrop-filter: blur(16px);\n  -webkit-backdrop-filter: blur(16px);\n  border: 1px solid rgba(139, 92, 246, 0.15);\n  box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);\n}\n\n.glass-panel-glow {\n  background: rgba(17, 24, 39, 0.75);\n  backdrop-filter: blur(16px);\n  -webkit-backdrop-filter: blur(16px);\n  border: 1px solid rgba(139, 92, 246, 0.25);\n  box-shadow: 0 0 25px -5px rgba(139, 92, 246, 0.15), 0 8px 32px 0 rgba(0, 0, 0, 0.4);\n}\n\n.glass-panel-gold {\n  background: rgba(23, 20, 13, 0.75);\n  backdrop-filter: blur(16px);\n  -webkit-backdrop-filter: blur(16px);\n  border: 1px solid rgba(251, 191, 36, 0.3);\n  box-shadow: 0 0 25px -5px rgba(251, 191, 36, 0.2), 0 8px 32px 0 rgba(0, 0, 0, 0.4);\n}\n\n.chess-grid-bg {\n  background-image: \n    linear-gradient(to right, rgba(139, 92, 246, 0.07) 1px, transparent 1px),\n    linear-gradient(to bottom, rgba(139, 92, 246, 0.07) 1px, transparent 1px);\n  background-size: 40px 40px;\n}\n\n.chess-subtle-pattern {\n  background-image: radial-gradient(rgba(139, 92, 246, 0.15) 1px, transparent 1px);\n  background-size: 24px 24px;\n}\n\n/* Custom glowing effects */\n.neon-glow-violet {\n  box-shadow: 0 0 20px rgba(139, 92, 246, 0.45);\n}\n\n.neon-glow-gold {\n  box-shadow: 0 0 20px rgba(251, 191, 36, 0.45);\n}\n\n.neon-glow-cyan {\n  box-shadow: 0 0 20px rgba(6, 182, 212, 0.45);\n}\n\n.text-glow-violet {\n  text-shadow: 0 0 15px rgba(168, 85, 247, 0.6);\n}\n\n.text-glow-gold {\n  text-shadow: 0 0 15px rgba(251, 191, 36, 0.6);\n}\n\n/* Custom scrollbar */\n::-webkit-scrollbar {\n  width: 8px;\n  height: 8px;\n}\n::-webkit-scrollbar-track {\n  background: #0b0f19;\n}\n::-webkit-scrollbar-thumb {\n  background: #2e1065;\n  border-radius: 4px;\n  border: 1px solid rgba(139, 92, 246, 0.3);\n}\n::-webkit-scrollbar-thumb:hover {\n  background: #7c3aed;\n}"
      replacement_content: "@import \"tailwindcss\";\n\n@layer base {\n  body {\n    font-family: \'Outfit\', -apple-system, BlinkMacSystemFont, \'Segoe UI\', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;\n    background-color: #0f172a;\n    color: #f8fafc;\n  }\n  \n  h1, h2, h3, h4, h5, h6, .font-display {\n    font-family: \'Rajdhani\', \'Outfit\', sans-serif;\n    letter-spacing: 0.02em;\n  }\n\n  .font-mono {\n    font-family: \'JetBrains Mono\', monospace;\n  }\n}\n\n/* Immersive UI Theme Styles */\n.glass {\n  background: rgba(255, 255, 255, 0.03);\n  backdrop-filter: blur(12px);\n  -webkit-backdrop-filter: blur(12px);\n  border: 1px solid rgba(255, 255, 255, 0.1);\n}\n\n.glow-violet {\n  box-shadow: 0 0 30px rgba(139, 92, 246, 0.2);\n}\n\n.glow-gold {\n  box-shadow: 0 0 30px rgba(251, 191, 36, 0.2);\n}\n\n.text-gradient-violet {\n  background: linear-gradient(135deg, #a78bfa, #8b5cf6);\n  -webkit-background-clip: text;\n  -webkit-text-fill-color: transparent;\n}\n\n.bg-mesh {\n  background-image: \n    radial-gradient(circle at 0% 0%, rgba(139, 92, 246, 0.15) 0%, transparent 40%),\n    radial-gradient(circle at 100% 100%, rgba(251, 191, 36, 0.1) 0%, transparent 40%),\n    radial-gradient(circle at 50% 50%, rgba(99, 102, 241, 0.08) 0%, transparent 50%);\n}\n\n/* Glassmorphism & eSports Glow Styles */\n.glass-panel {\n  background: rgba(15, 23, 42, 0.65);\n  backdrop-filter: blur(14px);\n  -webkit-backdrop-filter: blur(14px);\n  border: 1px solid rgba(255, 255, 255, 0.08);\n  box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);\n}\n\n.glass-panel-glow {\n  background: rgba(15, 23, 42, 0.8);\n  backdrop-filter: blur(16px);\n  -webkit-backdrop-filter: blur(16px);\n  border: 1px solid rgba(139, 92, 246, 0.3);\n  box-shadow: 0 0 30px rgba(139, 92, 246, 0.2), 0 8px 32px 0 rgba(0, 0, 0, 0.4);\n}\n\n.glass-panel-gold {\n  background: rgba(23, 20, 13, 0.8);\n  backdrop-filter: blur(16px);\n  -webkit-backdrop-filter: blur(16px);\n  border: 1px solid rgba(251, 191, 36, 0.35);\n  box-shadow: 0 0 30px rgba(251, 191, 36, 0.2), 0 8px 32px 0 rgba(0, 0, 0, 0.4);\n}\n\n.chess-grid-bg {\n  background-image: \n    linear-gradient(to right, rgba(139, 92, 246, 0.06) 1px, transparent 1px),\n    linear-gradient(to bottom, rgba(139, 92, 246, 0.06) 1px, transparent 1px);\n  background-size: 40px 40px;\n}\n\n.chess-subtle-pattern {\n  background-image: radial-gradient(rgba(139, 92, 246, 0.15) 1px, transparent 1px);\n  background-size: 24px 24px;\n}\n\n/* Custom glowing effects */\n.neon-glow-violet {\n  box-shadow: 0 0 20px rgba(139, 92, 246, 0.45);\n}\n\n.neon-glow-gold {\n  box-shadow: 0 0 20px rgba(251, 191, 36, 0.45);\n}\n\n.neon-glow-cyan {\n  box-shadow: 0 0 20px rgba(6, 182, 212, 0.45);\n}\n\n.text-glow-violet {\n  text-shadow: 0 0 15px rgba(168, 85, 247, 0.6);\n}\n\n.text-glow-gold {\n  text-shadow: 0 0 15px rgba(251, 191, 36, 0.6);\n}\n\n/* Custom scrollbar */\n::-webkit-scrollbar {\n  width: 8px;\n  height: 8px;\n}\n::-webkit-scrollbar-track {\n  background: #0b0f19;\n}\n::-webkit-scrollbar-thumb {\n  background: #2e1065;\n  border-radius: 4px;\n  border: 1px solid rgba(139, 92, 246, 0.3);\n}\n::-webkit-scrollbar-thumb:hover {\n  background: #7c3aed;\n}"
    }
