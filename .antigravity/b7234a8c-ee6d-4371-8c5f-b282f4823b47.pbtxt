sName=\"flex items-center justify-between p-2 rounded-lg bg-white/5 border border-white/5\">\n                  <span className=\"text-slate-400 flex items-center gap-2 text-xs\">\n                    <ShieldCheck className=\"w-3.5 h-3.5 text-emerald-400\" />\n                    Rating Cap\n                  </span>\n                  <span className=\"font-mono font-bold text-xs text-white\">Open to All Tiers</span>\n                </div>\n\n                <div className=\"flex items-center justify-between p-2 rounded-lg bg-white/5 border border-white/5\">\n                  <span className=\"text-slate-400 flex items-center gap-2 text-xs\">\n                    <Clock className=\"w-3.5 h-3.5 text-violet-400\" />\n                    Time Control\n                  </span>\n                  <span className=\"font-mono font-bold text-xs text-white\">10m + 5s Rapid</span>\n                </div>\n\n                <div className=\"flex items-center justify-between p-2 rounded-lg bg-white/5 border border-white/5\">\n                  <span className=\"text-slate-400 flex items-center gap-2 text-xs\">\n                    <Trophy className=\"w-3.5 h-3.5 text-amber-400\" />\n                    Grand Awards\n                  </span>\n                  <span className=\"font-mono font-bold text-xs text-amber-300\">8 Official Titles</span>\n                </div>\n              </div>\n\n            </div>\n          </motion.div>\n\n        </div>"
