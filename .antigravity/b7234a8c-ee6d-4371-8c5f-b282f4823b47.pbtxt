}}\n          className=\"rounded-3xl p-6 sm:p-8 glass-panel-glow border-violet-500/30 mb-12 relative overflow-hidden\"\n        >\n          <div className=\"absolute top-0 right-0 w-64 h-64 bg-violet-600/10 rounded-full blur-3xl pointer-events-none\" />\n          \n          <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-6 items-center\">\n            <div className=\"lg:col-span-8\">\n              <p className=\"text-lg sm:text-xl text-slate-200 font-medium leading-relaxed mb-4\">\n                <strong className=\"text-white font-semibold\">Chess eSports</strong> is an exciting inter-college chess tournament that brings together <span className=\"text-amber-300 font-bold\">100 players</span> to compete, think strategically, and fight for the ultimate title.\n              </p>\n              <p className=\"text-base sm:text-lg text-violet-300/90 font-display font-bold tracking-wide uppercase flex items-center gap-2\">\n                <Target className=\"w-5 h-5 text-amber-400\" />\n                <span>It&apos;s more than a game \342\200\224 it&apos;s a battle of minds!</span>\n              </p>\n            </div>\n\n            <div className=\"lg:col-span-4 flex flex-col sm:flex-row lg:flex-col gap-3 justify-center\">\n              <div className=\"flex items-center gap-3 p-3 rounded-xl bg-slate-900/80 border border-slate-800\">\n                <div className=\"w-10 h-10 rounded-lg bg-violet-900/40 border border-violet-500/30 flex items-center justify-center text-violet-300\">\n                  <Users className=\"w-5 h-5\" />\n                </div>\n                <div>\n                  <div className=\"text-xs text-slate-400 font-mono\">Competitor Cap</div>\n                  <div className=\"text-sm font-bold text-white font-mono\">100 Collegiate Players</div>\n                </div>\n              </div>\n\n              <div className=\"flex items-center gap-3 p-3 rounded-xl bg-slate-900/80 border border-slate-800\">\n                <div className=\"w-10 h-10 rounded-lg bg-amber-900/30 border border-amber-500/30 flex items-center justify-center text-amber-300\">\n                  <Flame className=\"w-5 h-5 text-amber-400\" />\n                </div>\n                <div>\n                  <div className=\"text-xs text-slate-400 font-mono\">Championship Crown</div>\n                  <div className=\"text-sm font-bold text-amber-300 font-mono\">1 Undisputed King</div>\n                </div>\n              </div>\n            </div>\n          </div>\n        </motion.div>\n\n        {/* 4 Core Features Grid from Flyer */}\n        <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6\">\n          {ABOUT_FEATURES.map((feature, index) => (\n            <motion.div\n              key={feature.id}\n              initial={{ opacity: 0, y: 25 }}\n              whileInView={{ opacity: 1, y: 0 }}\n              viewport={{ once: true }}\n              transition={{ duration: 0.5, delay: index * 0.1 }}\n              whileHover={{ y: -6 }}\n              className={`rounded-2xl p-6 glass-panel transition-all duration-300 ${borderColors[feature.id]} flex flex-col justify-between group shadow-xl`}\n            >\n              <div>\n                {/* Header Icon + Stage tag */}\n                <div className=\"flex items-center justify-between mb-4\">\n                  <div className=\"w-12 h-12 rounded-xl bg-slate-900/90 border border-slate-700/80 group-hover:border-violet-500/40 flex items-center justify-center transition-colors\">\n                    {iconMap[feature.icon]}\n                  </div>\n                  <span className=\"text-[11px] font-mono font-bold text-slate-400 px-2 py-0.5 rounded bg-slate-900 border border-slate-800\">\n                    {feature.badge}\n                  </span>\n                </div>\n\n                <div className=\"text-xs font-mono font-semibold uppercase tracking-wider text-violet-400 mb-1\">\n                  {feature.tagline