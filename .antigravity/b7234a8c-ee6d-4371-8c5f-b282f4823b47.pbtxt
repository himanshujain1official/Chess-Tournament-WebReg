          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              {/* Action Buttons */}"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              <div className=\"flex flex-col sm:flex-row gap-3\">"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "              <div className=\"flex flex-col sm:flex-row gap-2\">"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
