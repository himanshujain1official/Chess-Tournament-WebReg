assName=\"w-3.5 h-3.5 text-violet-400\" />\n          </button>\n        </div>\n\n      </div>\n    </footer>"
        replacement_content: "  return (\n    <footer className=\"relative text-slate-400 pt-20 pb-12 overflow-hidden border-t border-white/10\">\n      \n      {/* Ambient background glows */}\n      <div className=\"absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[300px] bg-gradient-to-b from-violet-600/10 via-amber-500/5 to-transparent blur-[120px] pointer-events-none\" />\n\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10\">\n        \n        {/* Grand CTA Banner from Flyer (Stage 10) */}\n        <motion.div\n          initial={{ opacity: 0, y: 25 }}\n          whileInView={{ opacity: 1, y: 0 }}\n          viewport={{ once: true }}\n          transition={{ duration: 0.6 }}\n          className=\"rounded-2xl p-8 sm:p-12 glass glow-gold border-amber-500/30 text-center relative overflow-hidden mb-16 shadow-2xl\"\n        >\n          {/* Decorative chess pieces in background */}\n          <div className=\"absolute left-6 top-6 opacity-20 text-violet-400 hidden sm:block\">\n            <KingIcon className=\"w-16 h-16\" glow />\n          </div>\n          <div className=\"absolute right-6 bottom-6 opacity-20 text-amber-400 hidden sm:block\">\n            <QueenIcon className=\"w-16 h-16\" glow />\n          </div>\n\n          <div className=\"inline-flex items-center gap-2 px-3 py-1 rounded-full bg-violet-950/80 border border-violet-500/40 text-violet-300 text-xs font-mono uppercase tracking-widest mb-4 font-semibold\">\n            <Sparkles className=\"w-3.5 h-3.5 text-amber-400\" />\n            <span>Final Call For Tacticians</span>\n          </div>\n\n          <h2 className=\"text-3xl sm:text-5xl md:text-6xl font-display font-black text-white uppercase tracking-tight leading-none mb-3\">\n            YOUR MOVE. <span className=\"text-gradient-violet\">YOUR LEGACY!</span>\n          </h2>\n\n          <div className=\"text-lg sm:text-xl font-display font-bold text-amber-300 tracking-wider uppercase mb-4\">\n            THINK DEEP. MOVE SMART. BE THE CHAMPION!\n          </div>\n\n          <p className=\"text-slate-300 text-sm sm:text-base max-w-2xl mx-auto mb-8 leading-relaxed font-sans\">\n            Prepare today, conquer tomorrow! 100 players enter the arena, only 1 will claim the Grand Trophy. Secure your board position before registrations reach capacity.\n          </p>\n\n          <div className=\"flex flex-col sm:flex-row items-center justify-center gap-4\">\n            <button\n              id=\"footer-register-btn\"\n              onClick={onOpenRegister}\n              className=\"w-full sm:w-auto px-8 py-3.5 rounded-xl bg-amber-400 text-slate-950 font-bold text-base uppercase tracking-wider shadow-lg shadow-amber-500/20 hover:scale-105 active:scale-95 transition-all flex items-center justify-center gap-2\"\n            >\n              <Flame className=\"w-4 h-4 text-slate-950\" />\n              <span>Claim Player Pass</span>\n            </button>\n\n            <a\n              href=\"#schedule\"\n              className=\"w-full sm:w-auto px-6 py-3.5 rounded-xl glass border-white/10 hover:border-violet-500 text-white font-bold text-sm uppercase tracking-wider transition-colors flex items-center justify-center gap-2\"\n            >\n              <span>Explore Timeline</span>\n            </a>\n          </div>\n\n          <div className=\"mt-8 pt-6 border-t border-white/10 font-mono text-xs text-amber-400 font-bold uppercase tracking-widest flex items-center justify-center gap-2\">\n            <span>SEE YOU AT THE BOARD!</span>\n            <span className=\"px-2 py-0.5 rounded bg-violet-900/60 border border-violet-500/30 text-violet-300\">STAGE 10</span>\n          </div>\n        </motion.div>\n\n        {/* Footer Navigation & Brand columns */}\n        <div className=\"grid grid-cols-1 md:grid-cols-4 gap-8 pb-12 border-b border-white/10\">\n          \n          {/* Brand Info */}\n          <div className=\"md:col-span-2 space-y-4\">\n            <div className=\"flex items-center gap-3\">\n              <div className=\"w-10 h-10 rounded-xl bg-gradient-to-br from-violet-600 to-indigo-800 p-0.5 shadow-lg shadow-violet-600/30\">\n                <div className=\"w-full h-full bg-[#0f172a] rounded-[10px] flex items-center justify-center text-amber-400\">\n                  <KingIcon className=\"w-6 h-6\" glow />\n                </div>\n              </div>\n              <div>\n                <span className=\"font-display font-black text-2xl tracking-wider text-white\">\n                  CHESS <span className=\"text-violet-400\">eSPORTS</span>\n                </span>\n                <span className=\"block text-[10px] font-mono tracking-widest text-amber-400 uppercase -mt-1 font-semibold\">\n                  Compete \342\200\242 Think \342\200\242 Conquer\n                </span>\n              </div>\n            </div>\n\n            <p className=\"text-sm text-slate-400 max-w-md leading-relaxed\">\n              The premier inter-college chess championship combining grandmaster tactical depth with electric arena broadcast standards, live digital sensor boards, and audience challenges.\n            </p>\n          </div>\n\n          {/* Quick Links */}\n          <div>\n            <h4 className=\"font-bold text-white text-base uppercase tracking-wider mb-3 font-display\">\n              Navigation\n            </h4>\n            <ul className=\"space-y-2 text-sm\">\n              <li><a href=\"#about\" className=\"hover:text-violet-300 transition-colors\">About the Event</a></li>\n              <li><a href=\"#overview\" className=\"hover:text-violet-300 transition-colors\">Progression Flowchart</a></li>\n              <li><a href=\"#schedule\" className=\"hover:text-violet-300 transition-colors\">Day 1 & Day 2 Schedule</a></li>\n              <li><a href=\"#awards\" className=\"hover:text-violet-300 transition-colors\">Awards & Recognition</a></li>\n              <li><a href=\"#arena\" className=\"hover:text-violet-300 transition-colors\">eSports Arena Stream</a></li>\n              <li><a href=\"#rules\" className=\"hover:text-violet-300 transition-colors\">Rules at a Glance</a></li>\n            </ul>\n          </div>\n\n          {/* Event Venue & Contact */}\n          <div>\n            <h4 className=\"font-bold text-white text-base uppercase tracking-wider mb-3 font-display\">\n              Tournament Arena\n            </h4>\n            <ul className=\"space-y-2.5 text-xs font-mono text-slate-400\">\n              <li className=\"flex items-start gap-2\">\n                <MapPin className=\"w-4 h-4 text-violet-400 shrink-0 mt-0.5\" />\n                <span>Grand Arena Hall, University Campus Central Auditorium</span>\n              </li>\n              <li className=\"flex items-center gap-2\">\n                <ShieldCheck className=\"w-4 h-4 text-emerald-400 shrink-0\" />\n                <span>FIDE Arbiter Certified</span>\n              </li>\n              <li className=\"flex items-center gap-2\">\n                <Mail className=\"w-4 h-4 text-amber-400 shrink-0\" />\n                <span>info@chessesports.org</span>\n              </li>\n            </ul>\n          </div>\n\n        </div>\n\n        {/* Bottom copyright bar */}\n        <div className=\"pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-mono text-slate-400\">\n          <div>\n            \302\251 2026 Chess eSports Championship. All rights reserved.\n          </div>\n\n          <button\n            onClick={scrollToTop}\n            className=\"flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-black/40 border border-white/10 hover:border-violet-500 text-slate-300 hover:text-white transition-colors\"\n          >\n            <span>Back to Top</span>\n            <ArrowUp className=\"w-3.5 h-3.5 text-violet-400\" />\n          </button>\n        </div>\n\n      </div>\n    </footer>\n  );"
      }
      num_matches: 1
    }
  }
}
