    replacement_chunks {
      target_content: "import React, { useState } from \'react\';\nimport { motion } from \'motion/react\';\nimport { Sparkles, Trophy, CheckCircle2, XCircle, RotateCcw, ArrowRight, Flame, Brain } from \'lucide-react\';\nimport confetti from \'canvas-confetti\';\nimport { SAMPLE_PUZZLE } from \'../data/tournamentData\';\nimport { QueenIcon, KingIcon, BishopIcon } from \'./ChessGraphics\';\n\nexport const InteractivePuzzle: React.FC = () => {\n  const [selectedOption, setSelectedOption] = useState<string | null>(null);\n  const [hasSubmitted, setHasSubmitted] = useState(false);\n  const [showCelebration, setShowCelebration] = useState(false);\n\n  const handleSelect = (optId: string) => {\n    setSelectedOption(optId);\n    setHasSubmitted(true);\n\n    const chosen = SAMPLE_PUZZLE.options.find(o => o.id === optId);\n    if (chosen?.isCorrect) {\n      setShowCelebration(true);\n      try {\n        confetti({\n          particleCount: 80,\n          spread: 70,\n          origin: { y: 0.6 },\n          colors: [\'#8b5cf6\', \'#fbbf24\', \'#06b6d4\', \'#ec4899\']\n        });\n      } catch {\n        // Confetti fallback\n      }\n    } else {\n      setShowCelebration(false);\n    }\n  };\n\n  const handleReset = () => {\n    setSelectedOption(null);\n    setHasSubmitted(false);\n    setShowCelebration(false);\n  };\n\n  const currentOption = SAMPLE_PUZZLE.options.find(o => o.id === selectedOption);\n\n  return (\n    <section id=\"tactics-challenge\" className=\"py-16 relative overflow-hidden\">\n      <div className=\"max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10\">\n        \n        <div className=\"rounded-2xl p-6 sm:p-8 glass glow-violet border-white/10 shadow-2xl relative overflow-hidden\">\n          {/* Header */}\n          <div className=\"flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-6 pb-4 border-b border-white/10\">\n            <div className=\"flex items-center gap-3\">\n              <div className=\"w-11 h-11 rounded-xl bg-violet-600/30 border border-violet-500/50 flex items-center justify-center text-amber-400 shadow-md\">\n                <Brain className=\"w-5 h-5\" />\n              </div>\n              <div>\n                <span className=\"px-2 py-0.5 rounded bg-violet-900/60 border border-violet-500/30 text-violet-300 text-[10px] font-mono uppercase font-bold tracking-wider\">\n                  Audience Mini-Challenge\n                </span>\n                <h3 className=\"text-xl sm:text-2xl font-display font-extrabold text-white uppercase tracking-wide\">\n                  {SAMPLE_PUZZLE.title}\n                </h3>\n              </div>\n            </div>\n\n            <button\n              onClick={handleReset}\n              className=\"px-3.5 py-1.5 rounded-lg bg-black/40 border border-white/10 hover:border-violet-500 text-xs font-mono text-slate-300 hover:text-white flex items-center gap-1.5 transition-colors\"\n            >\n              <RotateCcw className=\"w-3.5 h-3.5\" />\n              <span>Reset Board</span>\n            </button>\n          </div>\n\n          {/* Puzzle Body */}\n          <div className=\"grid grid-cols-1 md:grid-cols-12 gap-6 items-center\">\n            \n            {/* Visual Mini Board Graphic */}\n            <div className=\"md:col-span-5 flex flex-col items-center justify-center p-6 rounded-xl bg-black/40 border border-white/10 text-center\">\n              <div className=\"relative mb-4\">\n                {/* 8x8 Visual Mini Grid */}\n                <div className=\"grid grid-cols-4 gap-1 p-2 rounded-xl bg-slate-950 border border-violet-500/40\">\n                  <div className=\"w-10 h-10 bg-violet-900/50 rounded flex items-center justify-center text-white\">\n                    <KingIcon className=\"w-6 h-6 text-slate-400\" />\n                  </div>\n                  <div className=\"w-10 h-10 bg-slate-800/50 rounded flex items-center justify-center\">\n                    <span className=\"text-xs font-mono text-slate-500\">f7</span>\n                  </div>\n                  <div className=\"w-10 h-10 bg-amber-500/20 rounded flex items-center justify-center border border-amber-400/40 animate-pulse\">\n                    <QueenIcon className=\"w-6 h-6 text-amber-400\" glow />\n                  </div>\n                  <div className=\"w-10 h-10 bg-violet-900/50 rounded flex items-center justify-center\">\n                    <BishopIcon className=\"w-6 h-6 text-violet-300\" />\n                  </div>\n                </div>\n              </div>\n\n              <div className=\"text-xs font-mono text-slate-400\">\n                White Queen on e4 + Bishop on d3 battery aiming at h7.\n              </div>\n              <div className=\"mt-2 text-xs font-mono font-bold text-amber-300 uppercase\">\n                Find the fastest checkmate!\n              </div>\n            </div>\n\n            {/* Tactical Options */}\n            <div className=\"md:col-span-7 space-y-2.5\">\n              <span className=\"text-xs font-mono uppercase tracking-wider text-slate-400 font-semibold block mb-2\">\n                Select White&apos;s Best Move:\n              </span>\n\n              {SAMPLE_PUZZLE.options.map((option) => {\n                const isSelected = selectedOption === option.id;\n                let btnStyle = \'border-white/5 bg-white/5 hover:border-violet-500/50 text-slate-200\';\n\n                if (hasSubmitted && isSelected) {\n                  btnStyle = option.isCorrect\n                    ? \'border-emerald-500 bg-emerald-950/70 text-emerald-200 ring-1 ring-emerald-400\'\n                    : \'border-rose-500 bg-rose-950/70 text-rose-200 ring-1 ring-rose-400\';\n                } else if (hasSubmitted && option.isCorrect) {\n                  btnStyle = \'border-emerald-500/60 bg-emerald-950/40 text-emerald-300\';\n                }\n\n                return (\n                  <button\n                    key={option.id}\n                    onClick={() => handleSelect(option.id)}\n                    className={`w-full p-3 rounded-xl border text-left font-mono text-xs sm:text-sm transition-all duration-200 flex items-center justify-between ${btnStyle}`}\n                  >\n                    <span className=\"font-bold\">{option.label}</span>\n                    {hasSubmitted && isSelected && (\n                      option.isCorrect ? (\n                        <CheckCircle2 className=\"w-4 h-4 text-emerald-400\" />\n                      ) : (\n                        <XCircle className=\"w-4 h-4 text-rose-400\" />\n                      )\n                    )}\n                  </button>\n                );\n              })}\n\n              {/* Feedback Alert */}\n              {hasSubmitted && currentOption && (\n                <motion.div\n                  initial={{ opacity: 0, y: 10 }}\n                  animate={{ opacity: 1, y: 0 }}\n                  className={`p-3.5 rounded-xl border mt-3 text-xs leading-relaxed ${\n                    currentOption.isCorrect\n                      ? \'bg-emerald-950/60 border-emerald-500/40 text-emerald-200\'\n                      : \'bg-rose-950/60 border-rose-500/40 text-rose-200\'\n                  }`}\n                >\n                  <div className=\"font-bold font-mono text-xs mb-1 flex items-center gap-1.5\">\n                    {currentOption.isCorrect ? (\n                      <>\n                        <Trophy className=\"w-3.5 h-3.5 text-amber-400\" />\n                        <span>Brilliant! Checkmate Found!</span>\n                      </>\n                    ) : (\n                      <>\n                        <XCircle className=\"w-3.5 h-3.5 text-rose-400\" />\n                        <span>Not quite optimal!</span>\n                      </>\n                    )}\n                  </div>\n                  <p>{currentOption.explanation}</p>\n                </motion.div>\n              )}\n            </div>\n\n          </div>\n\n        </div>\n\n      </div>\n    </section>\n  );\n};"
      replacement_content: "import React, { useState } from \'react\';\nimport { motion } from \'motion/react\';\nimport { CheckCircle2, XCircle, RotateCcw, Brain } from \'lucide-react\';\nimport { SAMPLE_PUZZLE } from \'../data/tournamentData\';\nimport { QueenIcon, KingIcon, BishopIcon } from \'./ChessGraphics\';\n\nexport const InteractivePuzzle: React.FC = () => {\n  const [selectedOption, setSelectedOption] = useState<string | null>(null);\n  const [hasSubmitted, setHasSubmitted] = useState(false);\n\n  const handleSelect = (optId: string) => {\n    setSelectedOption(optId);\n    setHasSubmitted(true);\n  };\n\n  const handleReset = () => {\n    setSelectedOption(null);\n    setHasSubmitted(false);\n  };\n\n  const currentOption = SAMPLE_PUZZLE.options.find(o => o.id === selectedOption);\n\n  return (\n    <section id=\"tactics-challenge\" className=\"py-16 relative overflow-hidden bg-black\">\n      <div className=\"max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10\">\n        \n        <div className=\"rounded-xl p-6 sm:p-8 bw-card bw-card-hover relative overflow-hidden\">\n          {/* Header */}\n          <div className=\"flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-6 pb-4 border-b border-zinc-800\">\n            <div className=\"flex items-center gap-3\">\n              <div className=\"w-10 h-10 rounded-lg bg-zinc-900 border border-zinc-800 flex items-center justify-center text-white\">\n                <Brain className=\"w-5 h-5\" />\n              </div>\n              <div>\n                <span className=\"text-zinc-400 text-[10px] font-mono uppercase font-bold tracking-widest block mb-0.5\">\n                  Interactive Tactics\n                </span>\n                <h3 className=\"text-xl font-display font-black text-white uppercase tracking-wide\">\n                  {SAMPLE_PUZZLE.title}\n                </h3>\n              </div>\n            </div>\n\n            <button\n              onClick={handleReset}\n              className=\"px-3 py-1.5 rounded bg-zinc-900 border border-zinc-800 hover:border-zinc-600 text-xs font-mono text-zinc-300 hover:text-white flex items-center gap-1.5 transition-colors\"\n            >\n              <RotateCcw className=\"w-3.5 h-3.5\" />\n              <span>Reset</span>\n            </button>\n          </div>\n\n          {/* Puzzle Body */}\n          <div className=\"grid grid-cols-1 md:grid-cols-12 gap-6 items-center\">\n            \n            {/* Visual Mini Board Graphic */}\n            <div className=\"md:col-span-5 flex flex-col items-center justify-center p-6 rounded-lg bg-zinc-950 border border-zinc-800 text-center font-mono\">\n              <div className=\"grid grid-cols-4 gap-1 p-2 rounded-lg bg-black border border-zinc-800 mb-4\">\n                <div className=\"w-9 h-9 bg-zinc-900 rounded flex items-center justify-center text-zinc-400\">\n                  <KingIcon className=\"w-5 h-5\" />\n                </div>\n                <div className=\"w-9 h-9 bg-zinc-950 rounded flex items-center justify-center text-[10px] text-zinc-600\">\n                  f7\n                </div>\n                <div className=\"w-9 h-9 bg-zinc-900 rounded flex items-center justify-center text-white border border-zinc-700\">\n                  <QueenIcon className=\"w-5 h-5\" />\n                </div>\n                <div className=\"w-9 h-9 bg-zinc-900 rounded flex items-center justify-center text-zinc-300\">\n                  <BishopIcon className=\"w-5 h-5\" />\n                </div>\n              </div>\n\n              <div className=\"text-xs text-zinc-400\">\n                White Queen on e4 + Bishop on d3 battery aiming at h7.\n              </div>\n              <div className=\"mt-2 text-xs font-bold text-white uppercase\">\n                Find the fastest checkmate\n              </div>\n            </div>\n\n            {/* Tactical Options */}\n            <div className=\"md:col-span-7 space-y-2 font-mono\">\n              <span className=\"text-xs uppercase tracking-wider text-zinc-400 font-semibold block mb-2\">\n                Select White&apos;s Move:\n              </span>\n\n              {SAMPLE_PUZZLE.options.map((option) => {\n                const isSelected = selectedOption === option.id;\n                let btnStyle = \'border-zinc-800 bg-zinc-900 hover:border-zinc-600 text-zinc-300\';\n\n                if (hasSubmitted && isSelected) {\n                  btnStyle = option.isCorrect\n                    ? \'border-white bg-white text-black font-bold\'\n                    : \'border-zinc-600 bg-zinc-800 text-white\';\n                } else if (hasSubmitted && option.isCorrect) {\n                  btnStyle = \'border-zinc-600 bg-zinc-900 text-white\';\n                }\n\n                return (\n                  <button\n                    key={option.id}\n                    onClick={() => handleSelect(option.id)}\n                    className={`w-full p-3 rounded border text-left text-xs transition-all duration-150 flex items-center justify-between ${btnStyle}`}\n                  >\n                    <span>{option.label}</span>\n                    {hasSubmitted && isSelected && (\n                      option.isCorrect ? (\n                        <CheckCircle2 className=\"w-4 h-4 text-black\" />\n                      ) : (\n                        <XCircle className=\"w-4 h-4 text-zinc-400\" />\n                      )\n                    )}\n                  </button>\n                );\n              })}\n\n              {/* Feedback Alert */}\n              {hasSubmitted && currentOption && (\n                <motion.div\n                  initial={{ opacity: 0, y: 5 }}\n                  animate={{ opacity: 1, y: 0 }}\n                  className=\"p-3.5 rounded border border-zinc-800 bg-zinc-950 mt-3 text-xs leading-relaxed text-zinc-300 font-mono\"\n                >\n                  <div className=\"font-bold text-xs mb-1 flex items-center gap-1.5 text-white\">\n                    {currentOption.isCorrect ? (\n                      <span>\342\234\223 Solution Verified! Checkmate Found!</span>\n                    ) : (\n                      <span>\342\234\225 Alternative line. Keep calculating.</span>\n                    )}\n                  </div>\n                  <p className=\"text-zinc-400\">{currentOption.explanation}</p>\n                </motion.div>\n              )}\n            </div>\n\n          </div>\n\n        </div>\n\n      </div>\n    </section>\n  );\n};"
