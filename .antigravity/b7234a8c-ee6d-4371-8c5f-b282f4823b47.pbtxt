    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "import React, { useState } from \'react\';\nimport { motion, AnimatePresence } from \'motion/react\';\nimport { \n  GitFork, \n  Trophy, \n  Swords, \n  Flame, \n  HelpCircle, \n  CheckCircle2, \n  Zap, \n  Clock, \n  ShieldAlert, \n  Layers, \n  Award,\n  ChevronDown,\n  Info\n} from \'lucide-react\';\nimport { KingIcon, QueenIcon, KnightIcon, BishopIcon, RookIcon, PawnIcon } from \'./ChessGraphics\';\n\nexport const TournamentOverview: React.FC = () => {\n  const [activeTab, setActiveTab] = useState<\'flowchart\' | \'format_rules\'>(\'flowchart\');\n  const [selectedStage, setSelectedStage] = useState<string>(\'grand_final\');\n\n  const stages = [\n    {\n      id: \'swiss\',\n      day: \'Day 1\',\n      title: \'Swiss System 5 Rounds\',\n      players: \'100 \342\206\222 Top 32 Qualify\',\n      format: \'100 players compete in 5 rapid rounds (10+5). Points: Win = 1, Draw = 0.5, Loss = 0. Top 32 on Buchholz advance.\',\n      icon: <PawnIcon className=\"w-5 h-5 text-indigo-400\" />,\n      color: \'border-indigo-500/40 bg-indigo-950/30\'\n    },\n    {\n      id: \'r32\',\n      day: \'Day 1\',\n      title: \'Round of 32\',\n      players: \'32 \342\206\222 16 Players\',\n      format: \'Best of 3 rapid series. Sudden death elimination. 1-1 ties settled with Blitz playoff.\',\n      icon: <KnightIcon className=\"w-5 h-5 text-purple-400\" />,\n      color: \'border-purple-500/40 bg-purple-950/30\'\n    },\n    {\n      id: \'r16\',\n      day: \'Day 2\',\n      title: \'Round of 16\',\n      players: \'16 \342\206\222 8 Players\',\n      format: \'Best of 3 rapid games. Broadcast spotlights on top 4 boards.\',\n      icon: <BishopIcon className=\"w-5 h-5 text-violet-400\" />,\n      color: \'border-violet-500/40 bg-violet-950/30\'\n    },\n    {\n      id: \'quarter\',\n      day: \'Day 2\',\n      title: \'Quarter Finals\',\n      players: \'8 \342\206\222 4 Players\',\n      format: \'Best of 3 rapid games. Intense tactical clash for the Final Four seats.\',\n      icon: <RookIcon className=\"w-5 h-5 text-cyan-400\" />,\n      color: \'border-cyan-500/40 bg-cyan-950/30\'\n    },\n    {\n      id: \'semi\',\n      day: \'Day 2\',\n      title: \'Semi Finals\',\n      players: \'4 \342\206\222 2 Players\',\n      format: \'Best of 3 / 5 match series. Main stage lighting with crowd prediction.\',\n      icon: <QueenIcon className=\"w-5 h-5 text-pink-400\" />,\n      color: \'border-pink-500/40 bg-pink-950/30\'\n    },\n    {\n      id: \'grand_final\',\n      day: \'Day 2\',\n      title: \'Grand Final\',\n      players: \'2 \342\206\222 1 Champion\',\n      format: \'Best of 5 championship series. Ties go to Blitz (3+2), followed by Armageddon (5 min White vs 4 min Black with draw odds for Black).\',\n      icon: <KingIcon className=\"w-5 h-5 text-amber-400\" glow />,\n      color: \'border-amber-500/60 bg-amber-950/40 shadow-lg shadow-amber-500/20\'\n    }\n  ];\n\n  return (\n    <section id=\"overview\" className=\"py-20 relative overflow-hidden\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10\">\n        \n        {/* Section Header */}\n        <div className=\"flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-10 pb-4 border-b border-white/10\">\n          <div>\n            <div className=\"inline-flex items-center gap-2 px-3 py-1 rounded-full bg-violet-950/80 border border-violet-500/40 text-violet-300 text-xs font-mono uppercase tracking-widest mb-2 font-semibold\">\n              <Layers className=\"w-3.5 h-3.5 text-violet-400\" />\n              Tournament Progression\n            </div>\n            <h2 className=\"text-3xl sm:text-5xl font-display font-extrabold text-white tracking-wide uppercase\">\n              TOURNAMENT <span className=\"text-gradient-violet\">OVERVIEW & FORMAT</span>\n            </h2>\n          </div>\n\n          <div className=\"flex items-center gap-3\">\n            <span className=\"text-xs font-mono tracking-widest text-slate-400 uppercase\">Progression Tree</span>\n            <span className=\"px-2.5 py-1 rounded bg-violet-900/60 border border-violet-500/40 text-violet-300 font-mono font-bold text-sm\">\n              03 / 06\n            </span>\n          </div>\n        </div>\n\n        {/* View Mode Toggle Buttons */}\n        <div className=\"flex items-center justify-center mb-10\">\n          <div className=\"p-1.5 rounded-xl glass border border-white/10 flex gap-2\">\n            <button\n              id=\"tab-flowchart-btn\"\n              onClick={() => setActiveTab(\'flowchart\')}\n              className={`px-5 py-2.5 rounded-lg font-bold text-xs sm:text-sm tracking-wider uppercase transition-all duration-300 flex items-center gap-2 ${\n                activeTab === \'flowchart\'\n                  ? \'bg-violet-600 text-white shadow-lg shadow-violet-600/30\'\n                  : \'text-slate-400 hover:text-white hover:bg-white/5\'\n              }`}\n            >\n              <GitFork className=\"w-4 h-4\" />\n              <span>Progression Flowchart</span>\n            </button>\n\n            <button\n              id=\"tab-rules-btn\"\n              onClick={() => setActiveTab(\'format_rules\')}\n              className={`px-5 py-2.5 rounded-lg font-bold text-xs sm:text-sm tracking-wider uppercase transition-all duration-300 flex items-center gap-2 ${\n                activeTab === \'format_rules\'\n                  ? \'bg-violet-600 text-white shadow-lg shadow-violet-600/30\'\n                  : \'text-slate-400 hover:text-white hover:bg-white/5\'\n              }`}\n            >\n              <Info className=\"w-4 h-4\" />\n              <span>Format Rules & Tie-Breaks</span>\n            </button>\n          </div>\n        </div>\n\n        {/* Dynamic Tab Content */}\n        <AnimatePresence mode=\"wait\">\n          {activeTab === \'flowchart\' ? (\n            <motion.div\n              key=\"flowchart-view\"\n              initial={{ opacity: 0, y: 15 }}\n              animate={{ opacity: 1, y: 0 }}\n              exit={{ opacity: 0, y: -15 }}\n              transition={{ duration: 0.35 }}\n              className=\"space-y-8\"\n            >\n              {/* Flowchart Diagram matching the Flyer Graphic */}\n              <div className=\"p-6 sm:p-8 rounded-2xl glass glow-violet border-white/10 relative overflow-hidden\">\n                {/* 100 Players Top Pillar */}\n                <div className=\"flex flex-col items-center justify-center mb-8\">\n                  <div className=\"px-8 py-3.5 rounded-xl bg-gradient-to-r from-amber-500 via-amber-400 to-yellow-500 text-slate-950 font-black text-lg sm:text-xl tracking-widest uppercase shadow-xl shadow-amber-500/30 flex items-center gap-3\">\n                    <KingIcon className=\"w-6 h-6 text-slate-950\" />\n                    <span>100 PLAYERS</span>\n                  </div>\n                  <div className=\"w-0.5 h-6 bg-gradient-to-b from-amber-400 to-violet-500 my-1\" />\n                </div>\n\n                {/* Day 1 & Day 2 Progression Columns */}\n                <div className=\"grid grid-cols-1 lg:grid-cols-2 gap-6 relative\">\n                  \n                  {/* DAY 1 BRACKET */}\n                  <div className=\"rounded-xl p-5 bg-black/40 border border-white/10 border-l-4 border-l-violet-500 relative\">\n                    <div className=\"inline-flex items-center gap-2 px-3 py-1 rounded bg-violet-600 text-white font-mono font-bold text-xs uppercase tracking-wider mb-5 shadow-md\">\n                      <span>DAY 1 STAGES</span>\n                    </div>\n\n                    <div className=\"space-y-3\">\n                      {/* Swiss System Card */}\n                      <div \n                        onClick={() => setSelectedStage(\'swiss\')}\n                        className={`p-4 rounded-xl border transition-all duration-300 cursor-pointer ${\n                          selectedStage === \'swiss\' \n                            ? \'border-violet-400 bg-violet-950/60 shadow-lg glow-violet\' \n                            : \'border-white/5 bg-white/5 hover:border-white/20\'\n                        }`}\n                      >\n                        <div className=\"flex items-center justify-between mb-1.5\">\n                          <span className=\"font-bold text-base text-white uppercase flex items-center gap-2\">\n                            <PawnIcon className=\"w-4 h-4 text-violet-400\" />\n                            SWISS SYSTEM (5 ROUNDS)\n                          </span>\n                          <span className=\"text-[10px] font-mono font-bold px-2 py-0.5 rounded bg-violet-900/60 text-violet-300\">\n                            100 Players\n                          </span>\n                        </div>\n                        <div className=\"text-xs text-amber-300 font-mono font-bold flex items-center gap-1.5\">\n                          <CheckCircle2 className=\"w-3.5 h-3.5 text-emerald-400\" />\n                          <span>TOP 32 PLAYERS QUALIFY</span>\n                        </div>\n                      </div>\n\n                      {/* Arrow Down */}\n                      <div className=\"flex justify-center text-violet-400\">\n                        <ChevronDown className=\"w-5 h-5 animate-bounce\" />\n                      </div>\n\n                      {/* Round of 32 Card */}\n                      <div \n                        onClick={() => setSelectedStage(\'r32\')}\n                        className={`p-4 rounded-xl border transition-all duration-300 cursor-pointer ${\n                          selectedStage === \'r32\' \n                            ? \'border-violet-400 bg-violet-950/60 shadow-lg glow-violet\' \n                            : \'border-white/5 bg-white/5 hover:border-white/20\'\n                        }`}\n                      >\n                        <div className=\"flex items-center justify-between mb-1.5\">\n                          <span className=\"font-bold text-base text-white uppercase flex items-center gap-2\">\n                            <KnightIcon className=\"w-4 h-4 text-purple-400\" />\n                            ROUND OF 32\n                          </span>\n                          <span className=\"text-[10px] font-mono font-bold px-2 py-0.5 rounded bg-purple-900/60 text-purple-300\">\n                            Knockout (Best of 3)\n                          </span>\n                        </div>\n                        <div className=\"text-xs text-slate-300 font-mono flex items-center justify-between\">\n                          <span>32 \342\206\222 16 PLAYERS SURVIVE</span>\n                          <span className=\"text-violet-400 font-bold\">Advances to Day 2 \342\206\222</span>\n                        </div>\n                      </div>\n                    </div>\n                  </div>\n\n                  {/* DAY 2 BRACKET */}\n                  <div className=\"rounded-xl p-5 bg-black/40 border border-white/10 border-l-4 border-l-amber-500 relative\">\n                    <div className=\"inline-flex items-center gap-2 px-3 py-1 rounded bg-amber-500 text-slate-950 font-mono font-bold text-xs uppercase tracking-wider mb-5 shadow-md\">\n                      <span>DAY 2 FINALS</span>\n                    </div>\n\n                    <div className=\"space-y-2.5\">\n                      {/* Round of 16 */}\n                      <div \n                        onClick={() => setSelectedStage(\'r16\')}\n                        className={`p-3 rounded-xl border transition-all duration-300 cursor-pointer flex items-center justify-between ${\n                          selectedStage === \'r16\' \n                            ? \'border-violet-400 bg-violet-950/60 shadow-md\' \n                            : \'border-white/5 bg-white/5 hover:border-white/20\'\n                        }`}\n                      >\n                        <span className=\"font-bold text-sm text-white uppercase flex items-center gap-2\">\n                          <BishopIcon className=\"w-4 h-4 text-violet-400\" />\n                          ROUND OF 16\n                        </span>\n                        <span className=\"font-mono text-[11px] font-bold text-slate-300 bg-black/40 px-2 py-0.5 rounded\">\n                          16 \342\206\222 8 PLAYERS\n                        </span>\n                      </div>\n\n                      {/* Quarter Final */}\n                      <div \n                        onClick={() => setSelectedStage(\'quarter\')}\n                        className={`p-3 rounded-xl border transition-all duration-300 cursor-pointer flex items-center justify-between ${\n                          selectedStage === \'quarter\' \n                            ? \'border-cyan-400 bg-cyan-950/60 shadow-md\' \n                            : \'border-white/5 bg-white/5 hover:border-white/20\'\n                        }`}\n                      >\n                        <span className=\"font-bold text-sm text-white uppercase flex items-center gap-2\">\n                          <RookIcon className=\"w-4 h-4 text-cyan-400\" />\n                          QUARTER FINAL\n                        </span>\n                        <span className=\"font-mono text-[11px] font-bold text-slate-300 bg-black/40 px-2 py-0.5 rounded\">\n                          8 \342\206\222 4 PLAYERS\n                        </span>\n                      </div>\n\n                      {/* Semi Final */}\n                      <div \n                        onClick={() => setSelectedStage(\'semi\')}\n                        className={`p-3 rounded-xl border transition-all duration-300 cursor-pointer flex items-center justify-between ${\n                          selectedStage === \'semi\' \n                            ? \'border-pink-400 bg-pink-950/60 shadow-md\' \n                            : \'border-white/5 bg-white/5 hover:border-white/20\'\n                        }`}\n                      >\n                        <span className=\"font-bold text-sm text-white uppercase flex items-center gap-2\">\n                          <QueenIcon className=\"w-4 h-4 text-pink-400\" />\n                          SEMI FINAL\n                        </span>\n                        <span className=\"font-mono text-[11px] font-bold text-slate-300 bg-black/40 px-2 py-0.5 rounded\">\n                          4 \342\206\222 2 PLAYERS\n                        </span>\n                      </div>\n\n                      {/* Grand Final Centerpiece */}\n                      <div \n                        onClick={() => setSelectedStage(\'grand_final\')}\n                        className={`p-3.5 rounded-xl border-2 transition-all duration-300 cursor-pointer flex items-center justify-between ${\n                          selectedStage === \'grand_final\' \n                            ? \'border-amber-400 bg-amber-950/60 shadow-lg glow-gold\' \n                            : \'border-amber-500/40 bg-black/40 hover:border-amber-400\'\n                        }`}\n                      >\n                        <span className=\"font-black text-base text-amber-300 uppercase flex items-center gap-2\">\n                          <KingIcon className=\"w-5 h-5 text-amber-400\" glow />\n                          GRAND FINAL\n                        </span>\n                        <span className=\"font-mono text-xs font-black text-slate-950 bg-amber-400 px-2.5 py-1 rounded uppercase tracking-wider\">\n                          2 \342\206\222 1 CHAMPION \360\237\221\221\n                        </span>\n                      </div>\n                    </div>\n                  </div>\n                </div>\n\n                {/* Selected Stage Detail Inspector */}\n                {selectedStage && (\n                  <motion.div\n                    key={selectedStage}\n                    initial={{ opacity: 0, y: 10 }}\n                    animate={{ opacity: 1, y: 0 }}\n                    className=\"mt-6 p-4 rounded-xl bg-black/40 border border-white/10 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4\"\n                  >\n                    <div className=\"flex items-center gap-3\">\n                      <div className=\"w-10 h-10 rounded-lg bg-violet-900/40 border border-violet-500/40 flex items-center justify-center\">\n                        {stages.find(s => s.id === selectedStage)?.icon}\n                      </div>\n                      <div>\n                        <div className=\"text-[10px] font-mono uppercase text-violet-400 font-bold\">\n                          {stages.find(s => s.id === selectedStage)?.day} Focus\n                        </div>\n                        <h4 className=\"text-base font-bold text-white uppercase\">\n                          {stages.find(s => s.id === selectedStage)?.title} ({stages.find(s => s.id === selectedStage)?.players})\n                        </h4>\n                      </div>\n                    </div>\n\n                    <p className=\"text-xs sm:text-sm text-slate-300 max-w-xl\">\n                      {stages.find(s => s.id === selectedStage)?.format}\n                    </p>\n                  </motion.div>\n                )}\n              </div>\n            </motion.div>\n          ) : (\n            <motion.div\n              key=\"rules-view\"\n              initial={{ opacity: 0, y: 15 }}\n              animate={{ opacity: 1, y: 0 }}\n              exit={{ opacity: 0, y: -15 }}\n              transition={{ duration: 0.35 }}\n              className=\"grid grid-cols-1 md:grid-cols-2 gap-6\"\n            >\n              {/* Box 1: Swiss System (Day 1) from Flyer */}\n              <div className=\"rounded-2xl p-6 glass glow-violet border-l-4 border-l-violet-500 relative\">\n                <div className=\"flex items-center gap-3 mb-6 pb-3 border-b border-white/10\">\n                  <div className=\"w-9 h-9 rounded-lg bg-violet-600 text-white flex items-center justify-center font-bold text-lg shadow-md\">\n                    1\n                  </div>\n                  <div>\n                    <h3 className=\"text-xl font-extrabold text-white uppercase tracking-wide\">\n                      SWISS SYSTEM <span className=\"text-violet-400\">(DAY 1)</span>\n                    </h3>\n                    <span className=\"text-[10px] text-slate-400 font-mono\">100-Player Qualification Engine</span>\n                  </div>\n                </div>\n\n                <ul className=\"space-y-3 text-slate-300 text-sm\">\n                  <li className=\"flex items-start gap-3 p-3 rounded-lg bg-black/30 border border-white/5\">\n                    <span className=\"w-1.5 h-1.5 rounded-full bg-violet-400 mt-2 shrink-0\" />\n                    <span><strong>All 100 players</strong> will play 5 rounds across digital sensor boards.</span>\n                  </li>\n\n                  <li className=\"flex items-start gap-3 p-3 rounded-lg bg-black/30 border border-white/5\">\n                    <span className=\"w-1.5 h-1.5 rounded-full bg-violet-400 mt-2 shrink-0\" />\n                    <span><strong>Pairings based on performance:</strong> High scorers play fellow leaders in every round.</span>\n                  </li>\n\n                  <li className=\"flex items-start gap-3 p-3 rounded-lg bg-violet-950/40 border border-violet-500/30\">\n                    <span className=\"w-1.5 h-1.5 rounded-full bg-amber-400 mt-2 shrink-0\" />\n                    <span className=\"font-mono text-xs text-amber-300 font-bold\">\n                      Scoring: Win = 1 point | Draw = 0.5 point | Loss = 0 point\n                    </span>\n                  </li>\n\n                  <li className=\"flex items-start gap-3 p-3 rounded-lg bg-black/30 border border-white/5\">\n                    <span className=\"w-1.5 h-1.5 rounded-full bg-emerald-400 mt-2 shrink-0\" />\n                    <span className=\"text-emerald-300 font-semibold\">\n                      <strong>Top 32 players</strong> on the leaderboard qualify directly for the knockout phase.\n                    </span>\n                  </li>\n                </ul>\n              </div>\n\n              {/* Box 2: Knockout Matches (Day 1 & Day 2) from Flyer */}\n              <div className=\"rounded-2xl p-6 glass glow-gold border-l-4 border-l-amber-500 relative\">\n                <div className=\"flex items-center gap-3 mb-6 pb-3 border-b border-white/10\">\n                  <div className=\"w-9 h-9 rounded-lg bg-amber-400 text-slate-950 flex items-center justify-center font-bold text-lg shadow-md\">\n                    2\n                  </div>\n                  <div>\n                    <h3 className=\"text-xl font-extrabold text-white uppercase tracking-wide\">\n                      KNOCKOUT MATCHES <span className=\"text-amber-400\">(DAY 1 & 2)</span>\n                    </h3>\n                    <span className=\"text-[10px] text-slate-400 font-mono\">Single Elimination & Tie-Breaks</span>\n                  </div>\n                </div>\n\n                <ul className=\"space-y-3 text-slate-300 text-sm\">\n                  <li className=\"flex items-start gap-3 p-3 rounded-lg bg-black/30 border border-white/5\">\n                    <span className=\"w-1.5 h-1.5 rounded-full bg-amber-400 mt-2 shrink-0\" />\n                    <span><strong>Round of 32 to Semi Final:</strong> Best of 3 Rapid Games series.</span>\n                  </li>\n\n                  <li className=\"flex items-start gap-3 p-3 rounded-lg bg-black/30 border border-white/5\">\n                    <span className=\"w-1.5 h-1.5 rounded-full bg-amber-400 mt-2 shrink-0\" />\n                    <span><strong>Grand Final:</strong> Best of 5 Championship clash under stadium spotlights.</span>\n                  </li>\n\n                  <li className=\"flex items-start gap-3 p-3 rounded-lg bg-black/30 border border-white/5\">\n                    <span className=\"w-1.5 h-1.5 rounded-full bg-violet-400 mt-2 shrink-0\" />\n                    <span><strong>Best of 3 Tie-Break:</strong> If score is 1-1 \342\206\222 Sudden death Blitz Tie break (3m + 2s).</span>\n                  </li>\n\n                  <li className=\"flex items-start gap-3 p-3 rounded-lg bg-amber-950/50 border border-amber-500/40 text-amber-200\">\n                    <span className=\"w-1.5 h-1.5 rounded-full bg-amber-300 mt-2 shrink-0\" />\n                    <span>\n                      <strong>Grand Final Tie-Break:</strong> If score is equal in Best of 5 \342\206\222 Blitz Tie break \342\206\222 <strong>Armageddon</strong> (White 5 min, Black 4 min with draw odds for Black).\n                    </span>\n                  </li>\n                </ul>\n              </div>\n            </motion.div>\n          )}\n        </AnimatePresence>\n\n      </div>\n    </section>\n  );\n};"
      replacement_content: "import React, { useState } from \'react\';\nimport { motion, AnimatePresence } from \'motion/react\';\nimport { \n  GitFork, \n  CheckCircle2, \n  Layers, \n  ChevronDown,\n  Info\n} from \'lucide-react\';\nimport { KingIcon, QueenIcon, KnightIcon, BishopIcon, RookIcon, PawnIcon } from \'./ChessGraphics\';\n\nexport const TournamentOverview: React.FC = () => {\n  const [activeTab, setActiveTab] = useState<\'flowchart\' | \'format_rules\'>(\'flowchart\');\n  const [selectedStage, setSelectedStage] = useState<string>(\'grand_final\');\n\n  const stages = [\n    {\n      id: \'swiss\',\n      day: \'Day 1\',\n      title: \'Swiss System 5 Rounds\',\n      players: \'100 \342\206\222 Top 32 Qualify\',\n      format: \'100 players compete in 5 rapid rounds (10+5). Points: Win = 1, Draw = 0.5, Loss = 0. Top 32 on Buchholz advance.\',\n      icon: <PawnIcon className=\"w-4 h-4 text-white\" />\n    },\n    {\n      id: \'r32\',\n      day: \'Day 1\',\n      title: \'Round of 32\',\n      players: \'32 \342\206\222 16 Players\',\n      format: \'Best of 3 rapid series. Sudden death elimination. 1-1 ties settled with Blitz playoff.\',\n      icon: <KnightIcon className=\"w-4 h-4 text-white\" />\n    },\n    {\n      id: \'r16\',\n      day: \'Day 2\',\n      title: \'Round of 16\',\n      players: \'16 \342\206\222 8 Players\',\n      format: \'Best of 3 rapid games. Broadcast spotlights on top 4 boards.\',\n      icon: <BishopIcon className=\"w-4 h-4 text-white\" />\n    },\n    {\n      id: \'quarter\',\n      day: \'Day 2\',\n      title: \'Quarter Finals\',\n      players: \'8 \342\206\222 4 Players\',\n      format: \'Best of 3 rapid games. Intense tactical clash for the Final Four seats.\',\n      icon: <RookIcon className=\"w-4 h-4 text-white\" />\n    },\n    {\n      id: \'semi\',\n      day: \'Day 2\',\n      title: \'Semi Finals\',\n      players: \'4 \342\206\222 2 Players\',\n      format: \'Best of 3 / 5 match series. Main stage lighting with spectator prediction.\',\n      icon: <QueenIcon className=\"w-4 h-4 text-white\" />\n    },\n    {\n      id: \'grand_final\',\n      day: \'Day 2\',\n      title: \'Grand Final\',\n      players: \'2 \342\206\222 1 Champion\',\n      format: \'Best of 5 championship series. Ties go to Blitz (3+2), followed by Armageddon (5 min White vs 4 min Black with draw odds for Black).\',\n      icon: <KingIcon className=\"w-4 h-4 text-white\" />\n    }\n  ];\n\n  return (\n    <section id=\"overview\" className=\"py-24 relative overflow-hidden bg-black\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10\">\n        \n        {/* Section Header */}\n        <div className=\"flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-12 pb-4 border-b border-zinc-800\">\n          <div>\n            <div className=\"text-zinc-400 text-xs font-mono uppercase tracking-widest mb-1\">\n              Tournament Progression\n            </div>\n            <h2 className=\"text-3xl sm:text-4xl font-display font-black text-white tracking-wide uppercase\">\n              TOURNAMENT <span className=\"text-zinc-400 font-light\">OVERVIEW & FORMAT</span>\n            </h2>\n          </div>\n\n          <div className=\"flex items-center gap-3\">\n            <span className=\"text-xs font-mono tracking-widest text-zinc-400 uppercase\">Progression Tree</span>\n            <span className=\"px-2.5 py-1 rounded bg-zinc-900 border border-zinc-800 text-zinc-300 font-mono font-bold text-xs\">\n              STAGE 02\n            </span>\n          </div>\n        </div>\n\n        {/* View Mode Toggle Buttons */}\n        <div className=\"flex items-center justify-center mb-10\">\n          <div className=\"p-1 rounded-lg bg-zinc-900 border border-zinc-800 flex gap-1\">\n            <button\n              id=\"tab-flowchart-btn\"\n              onClick={() => setActiveTab(\'flowchart\')}\n              className={`px-5 py-2.5 rounded font-mono font-bold text-xs tracking-wider uppercase transition-all duration-200 flex items-center gap-2 ${\n                activeTab === \'flowchart\'\n                  ? \'bg-white text-black shadow-md\'\n                  : \'text-zinc-400 hover:text-white hover:bg-zinc-800\'\n              }`}\n            >\n              <GitFork className=\"w-3.5 h-3.5\" />\n              <span>Progression Flowchart</span>\n            </button>\n\n            <button\n              id=\"tab-rules-btn\"\n              onClick={() => setActiveTab(\'format_rules\')}\n              className={`px-5 py-2.5 rounded font-mono font-bold text-xs tracking-wider uppercase transition-all duration-200 flex items-center gap-2 ${\n                activeTab === \'format_rules\'\n                  ? \'bg-white text-black shadow-md\'\n                  : \'text-zinc-400 hover:text-white hover:bg-zinc-800\'\n              }`}\n            >\n              <Info className=\"w-3.5 h-3.5\" />\n              <span>Format Rules & Tie-Breaks</span>\n            </button>\n          </div>\n        </div>\n\n        {/* Dynamic Tab Content */}\n        <AnimatePresence mode=\"wait\">\n          {activeTab === \'flowchart\' ? (\n            <motion.div\n              key=\"flowchart-view\"\n              initial={{ opacity: 0, y: 10 }}\n              animate={{ opacity: 1, y: 0 }}\n              exit={{ opacity: 0, y: -10 }}\n              transition={{ duration: 0.25 }}\n              className=\"space-y-6\"\n            >\n              {/* Flowchart Diagram */}\n              <div className=\"p-6 sm:p-8 rounded-xl bw-panel-deep relative overflow-hidden\">\n                \n                {/* 100 Players Top Pillar */}\n                <div className=\"flex flex-col items-center justify-center mb-8\">\n                  <div className=\"px-8 py-3 rounded-lg bg-white text-black font-mono font-black text-base tracking-widest uppercase shadow-md flex items-center gap-2.5\">\n                    <KingIcon className=\"w-5 h-5 text-black\" />\n                    <span>100 PLAYERS FIELD</span>\n                  </div>\n                  <div className=\"w-px h-6 bg-zinc-700 my-1\" />\n                </div>\n\n                {/* Day 1 & Day 2 Progression Columns */}\n                <div className=\"grid grid-cols-1 lg:grid-cols-2 gap-6 relative\">\n                  \n                  {/* DAY 1 BRACKET */}\n                  <div className=\"rounded-xl p-5 bg-zinc-900/60 border border-zinc-800 relative\">\n                    <div className=\"inline-flex items-center gap-2 px-3 py-1 rounded bg-zinc-800 text-white font-mono font-bold text-[10px] uppercase tracking-wider mb-5\">\n                      <span>DAY 1: QUALIFYING</span>\n                    </div>\n\n                    <div className=\"space-y-3\">\n                      {/* Swiss System Card */}\n                      <div \n                        onClick={() => setSelectedStage(\'swiss\')}\n                        className={`p-4 rounded-lg border transition-all duration-200 cursor-pointer ${\n                          selectedStage === \'swiss\' \n                            ? \'border-white bg-zinc-800 text-white\' \n                            : \'border-zinc-800 bg-zinc-950/60 text-zinc-300 hover:border-zinc-700\'\n                        }`}\n                      >\n                        <div className=\"flex items-center justify-between mb-1.5\">\n                          <span className=\"font-bold text-sm text-white uppercase flex items-center gap-2 font-mono\">\n                            <PawnIcon className=\"w-4 h-4 text-zinc-400\" />\n                            SWISS SYSTEM (5 ROUNDS)\n                          </span>\n                          <span className=\"text-[10px] font-mono font-bold px-2 py-0.5 rounded bg-zinc-800 text-zinc-300\">\n                            100 Players\n                          </span>\n                        </div>\n                        <div className=\"text-xs text-zinc-300 font-mono flex items-center gap-1.5\">\n                          <CheckCircle2 className=\"w-3.5 h-3.5 text-white\" />\n                          <span>TOP 32 PLAYERS ADVANCE</span>\n                        </div>\n                      </div>\n\n                      {/* Arrow Down */}\n                      <div className=\"flex justify-center text-zinc-600\">\n                        <ChevronDown className=\"w-4 h-4\" />\n                      </div>\n\n                      {/* Round of 32 Card */}\n                      <div \n                        onClick={() => setSelectedStage(\'r32\')}\n                        className={`p-4 rounded-lg border transition-all duration-200 cursor-pointer ${\n                          selectedStage === \'r32\' \n                            ? \'border-white bg-zinc-800 text-white\' \n                            : \'border-zinc-800 bg-zinc-950/60 text-zinc-300 hover:border-zinc-700\'\n                        }`}\n                      >\n                        <div className=\"flex items-center justify-between mb-1.5\">\n                          <span className=\"font-bold text-sm text-white uppercase flex items-center gap-2 font-mono\">\n                            <KnightIcon className=\"w-4 h-4 text-zinc-400\" />\n                            ROUND OF 32\n                          </span>\n                          <span className=\"text-[10px] font-mono font-bold px-2 py-0.5 rounded bg-zinc-800 text-zinc-300\">\n                            Best of 3\n                          </span>\n                        </div>\n                        <div className=\"text-xs text-zinc-400 font-mono flex items-center justify-between\">\n                          <span>32 \342\206\222 16 SURVIVE</span>\n                          <span className=\"text-white font-bold\">Advances to Day 2 \342\206\222</span>\n                        </div>\n                      </div>\n                    </div>\n                  </div>\n\n                  {/* DAY 2 BRACKET */}\n                  <div className=\"rounded-xl p-5 bg-zinc-900/60 border border-zinc-800 relative\">\n                    <div className=\"inline-flex items-center gap-2 px-3 py-1 rounded bg-zinc-800 text-white font-mono font-bold text-[10px] uppercase tracking-wider mb-5\">\n                      <span>DAY 2: CHAMPIONSHIP FINALS</span>\n                    </div>\n\n                    <div className=\"space-y-2.5\">\n                      {/* Round of 16 */}\n                      <div \n                        onClick={() => setSelectedStage(\'r16\')}\n                        className={`p-3 rounded-lg border transition-all duration-200 cursor-pointer flex items-center justify-between ${\n                          selectedStage === \'r16\' \n                            ? \'border-white bg-zinc-800 text-white\' \n                            : \'border-zinc-800 bg-zinc-950/60 text-zinc-300 hover:border-zinc-700\'\n                        }`}\n                      >\n                        <span className=\"font-bold text-xs text-white uppercase flex items-center gap-2 font-mono\">\n                          <BishopIcon className=\"w-3.5 h-3.5 text-zinc-400\" />\n                          ROUND OF 16\n                        </span>\n                        <span className=\"font-mono text-[10px] font-bold text-zinc-400 bg-zinc-900 px-2 py-0.5 rounded\">\n                          16 \342\206\222 8 PLAYERS\n                        </span>\n                      </div>\n\n                      {/* Quarter Final */}\n                      <div \n                        onClick={() => setSelectedStage(\'quarter\')}\n                        className={`p-3 rounded-lg border transition-all duration-200 cursor-pointer flex items-center justify-between ${\n                          selectedStage === \'quarter\' \n                            ? \'border-white bg-zinc-800 text-white\' \n                            : \'border-zinc-800 bg-zinc-950/60 text-zinc-300 hover:border-zinc-700\'\n                        }`}\n                      >\n                        <span className=\"font-bold text-xs text-white uppercase flex items-center gap-2 font-mono\">\n                          <RookIcon className=\"w-3.5 h-3.5 text-zinc-400\" />\n                          QUARTER FINAL\n                        </span>\n                        <span className=\"font-mono text-[10px] font-bold text-zinc-400 bg-zinc-900 px-2 py-0.5 rounded\">\n                          8 \342\206\222 4 PLAYERS\n                        </span>\n                      </div>\n\n                      {/* Semi Final */}\n                      <div \n                        onClick={() => setSelectedStage(\'semi\')}\n                        className={`p-3 rounded-lg border transition-all duration-200 cursor-pointer flex items-center justify-between ${\n                          selectedStage === \'semi\' \n                            ? \'border-white bg-zinc-800 text-white\' \n                            : \'border-zinc-800 bg-zinc-950/60 text-zinc-300 hover:border-zinc-700\'\n                        }`}\n                      >\n                        <span className=\"font-bold text-xs text-white uppercase flex items-center gap-2 font-mono\">\n                          <QueenIcon className=\"w-3.5 h-3.5 text-zinc-400\" />\n                          SEMI FINAL\n                        </span>\n                        <span className=\"font-mono text-[10px] font-bold text-zinc-400 bg-zinc-900 px-2 py-0.5 rounded\">\n                          4 \342\206\222 2 PLAYERS\n                        </span>\n                      </div>\n\n                      {/* Grand Final Centerpiece */}\n                      <div \n                        onClick={() => setSelectedStage(\'grand_final\')}\n                        className={`p-3.5 rounded-lg border-2 transition-all duration-200 cursor-pointer flex items-center justify-between ${\n                          selectedStage === \'grand_final\' \n                            ? \'border-white bg-zinc-800 text-white\' \n                            : \'border-zinc-700 bg-zinc-950/80 text-zinc-300 hover:border-zinc-600\'\n                        }`}\n                      >\n                        <span className=\"font-black text-sm text-white uppercase flex items-center gap-2 font-mono\">\n                          <KingIcon className=\"w-4 h-4 text-white\" />\n                          GRAND FINAL\n                        </span>\n                        <span className=\"font-mono text-xs font-black text-black bg-white px-2 py-0.5 rounded uppercase tracking-wider\">\n                          2 \342\206\222 1 CHAMPION\n                        </span>\n                      </div>\n                    </div>\n                  </div>\n                </div>\n\n                {/* Selected Stage Detail Inspector */}\n                {selectedStage && (\n                  <motion.div\n                    key={selectedStage}\n                    initial={{ opacity: 0, y: 5 }}\n                    animate={{ opacity: 1, y: 0 }}\n                    className=\"mt-6 p-4 rounded-lg bg-zinc-900 border border-zinc-800 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4\"\n                  >\n                    <div className=\"flex items-center gap-3\">\n                      <div className=\"w-9 h-9 rounded bg-black border border-zinc-700 flex items-center justify-center text-white\">\n                        {stages.find(s => s.id === selectedStage)?.icon}\n                      </div>\n                      <div>\n                        <div className=\"text-[10px] font-mono uppercase text-zinc-400 font-bold\">\n                          {stages.find(s => s.id === selectedStage)?.day}\n                        </div>\n                        <h4 className=\"text-sm font-bold text-white uppercase font-mono\">\n                          {stages.find(s => s.id === selectedStage)?.title} ({stages.find(s => s.id === selectedStage)?.players})\n                        </h4>\n                      </div>\n                    </div>\n\n                    <p className=\"text-xs text-zinc-400 max-w-xl font-mono leading-relaxed\">\n                      {stages.find(s => s.id === selectedStage)?.format}\n                    </p>\n                  </motion.div>\n                )}\n              </div>\n            </motion.div>\n          ) : (\n            <motion.div\n              key=\"rules-view\"\n              initial={{ opacity: 0, y: 10 }}\n              animate={{ opacity: 1, y: 0 }}\n              exit={{ opacity: 0, y: -10 }}\n              transition={{ duration: 0.25 }}\n              className=\"grid grid-cols-1 md:grid-cols-2 gap-6\"\n            >\n              {/* Box 1: Swiss System */}\n              <div className=\"bw-panel-deep rounded-xl p-6 relative\">\n                <div className=\"flex items-center gap-3 mb-6 pb-3 border-b border-zinc-800\">\n                  <div className=\"w-8 h-8 rounded bg-zinc-900 text-white flex items-center justify-center font-bold text-sm border border-zinc-700 font-mono\">\n                    1\n                  </div>\n                  <div>\n                    <h3 className=\"text-lg font-black text-white uppercase tracking-wide font-display\">\n                      SWISS SYSTEM <span className=\"text-zinc-400 font-light\">(DAY 1)</span>\n                    </h3>\n                    <span className=\"text-[10px] text-zinc-400 font-mono\">100-Player Qualification Stage</span>\n                  </div>\n                </div>\n\n                <ul className=\"space-y-3 text-zinc-300 text-xs font-mono\">\n                  <li className=\"flex items-start gap-2.5 p-3 rounded bg-zinc-900 border border-zinc-800\">\n                    <span className=\"w-1.5 h-1.5 rounded-full bg-white mt-1.5 shrink-0\" />\n                    <span><strong>All 100 players</strong> will play 5 rounds across digital sensor boards.</span>\n                  </li>\n\n                  <li className=\"flex items-start gap-2.5 p-3 rounded bg-zinc-900 border border-zinc-800\">\n                    <span className=\"w-1.5 h-1.5 rounded-full bg-white mt-1.5 shrink-0\" />\n                    <span><strong>Pairings based on performance:</strong> High scorers play fellow leaders each round.</span>\n                  </li>\n\n                  <li className=\"flex items-start gap-2.5 p-3 rounded bg-zinc-900 border border-zinc-800 text-white\">\n                    <span className=\"w-1.5 h-1.5 rounded-full bg-white mt-1.5 shrink-0\" />\n                    <span className=\"font-bold\">\n                      Scoring: Win = 1 point | Draw = 0.5 point | Loss = 0 point\n                    </span>\n                  </li>\n\n                  <li className=\"flex items-start gap-2.5 p-3 rounded bg-zinc-900 border border-zinc-800\">\n                    <span className=\"w-1.5 h-1.5 rounded-full bg-white mt-1.5 shrink-0\" />\n                    <span>\n                      <strong>Top 32 players</strong> on the leaderboard qualify directly for the knockout phase.\n                    </span>\n                  </li>\n                </ul>\n              </div>\n\n              {/* Box 2: Knockout Matches */}\n              <div className=\"bw-panel-deep rounded-xl p-6 relative\">\n                <div className=\"flex items-center gap-3 mb-6 pb-3 border-b border-zinc-800\">\n                  <div className=\"w-8 h-8 rounded bg-zinc-900 text-white flex items-center justify-center font-bold text-sm border border-zinc-700 font-mono\">\n                    2\n                  </div>\n                  <div>\n                    <h3 className=\"text-lg font-black text-white uppercase tracking-wide font-display\">\n                      KNOCKOUT MATCHES <span className=\"text-zinc-400 font-light\">(DAY 1 & 2)</span>\n                    </h3>\n                    <span className=\"text-[10px] text-zinc-400 font-mono\">Single Elimination & Tie-Breaks</span>\n                  </div>\n                </div>\n\n                <ul className=\"space-y-3 text-zinc-300 text-xs font-mono\">\n                  <li className=\"flex items-start gap-2.5 p-3 rounded bg-zinc-900 border border-zinc-800\">\n                    <span className=\"w-1.5 h-1.5 rounded-full bg-white mt-1.5 shrink-0\" />\n                    <span><strong>Round of 32 to Semi Final:</strong> Best of 3 Rapid Games series.</span>\n                  </li>\n\n                  <li className=\"flex items-start gap-2.5 p-3 rounded bg-zinc-900 border border-zinc-800\">\n                    <span className=\"w-1.5 h-1.5 rounded-full bg-white mt-1.5 shrink-0\" />\n                    <span><strong>Grand Final:</strong> Best of 5 Championship clash under tournament spotlights.</span>\n                  </li>\n\n                  <li className=\"flex items-start gap-2.5 p-3 rounded bg-zinc-900 border border-zinc-800\">\n                    <span className=\"w-1.5 h-1.5 rounded-full bg-white mt-1.5 shrink-0\" />\n                    <span><strong>Best of 3 Tie-Break:</strong> If score is 1-1 \342\206\222 Sudden death Blitz Tie break (3m + 2s).</span>\n                  </li>\n\n                  <li className=\"flex items-start gap-2.5 p-3 rounded bg-zinc-900 border border-zinc-800\">\n                    <span className=\"w-1.5 h-1.5 rounded-full bg-white mt-1.5 shrink-0\" />\n                    <span>\n                      <strong>Grand Final Tie-Break:</strong> If score is tied in Best of 5 \342\206\222 Blitz Tie break \342\206\222 <strong>Armageddon</strong> (White 5 min, Black 4 min with draw odds for Black).\n                    </span>\n                  </li>\n                </ul>\n              </div>\n            </motion.div>\n          )}\n        </AnimatePresence>\n\n      </div>\n    </section>\n  );\n};"
    }
