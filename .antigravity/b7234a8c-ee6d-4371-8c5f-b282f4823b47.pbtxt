    instruction: "Apply Shadowed Black and White styling to RulesSection"
    replacement_infos {
      original_chunk {
        target_content: "import React, { useState } from \'react\';\nimport { motion } from \'motion/react\';\nimport { \n  ShieldCheck, \n  BookOpen, \n  Handshake, \n  PhoneOff, \n  Scale, \n  Clock, \n  AlertTriangle,\n  CheckCircle2,\n  ChevronDown,\n  Info\n} from \'lucide-react\';\nimport { RULES_LIST } from \'../data/tournamentData\';\n\nexport const RulesSection: React.FC = () => {\n  const [expandedRule, setExpandedRule] = useState<string | null>(null);\n\n  const iconMapping: Record<string, React.ReactNode> = {\n    BookOpen: <BookOpen className=\"w-5 h-5 text-indigo-400\" />,\n    Handshake: <Handshake className=\"w-5 h-5 text-emerald-400\" />,\n    SmartphoneOff: <PhoneOff className=\"w-5 h-5 text-rose-400\" />,\n    Scale: <Scale className=\"w-5 h-5 text-amber-400\" />,\n    Clock: <Clock className=\"w-5 h-5 text-violet-400\" />\n  };\n\n  return (\n    <section id=\"rules\" className=\"py-20 relative overflow-hidden\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10\">\n        \n        {/* Section Header */}\n        <div className=\"flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-10 pb-4 border-b border-white/10\">\n          <div>\n            <div className=\"inline-flex items-center gap-2 px-3 py-1 rounded-full bg-violet-950/80 border border-violet-500/40 text-violet-300 text-xs font-mono uppercase tracking-widest mb-2 font-semibold\">\n              <ShieldCheck className=\"w-3.5 h-3.5 text-emerald-400\" />\n              Tournament Code of Conduct\n            </div>\n            <h2 className=\"text-3xl sm:text-5xl font-display font-extrabold text-white tracking-wide uppercase\">\n              RULES AT A <span className=\"text-gradient-violet\">GLANCE</span>\n            </h2>\n          </div>\n\n          <div className=\"flex items-center gap-3\">\n            <span className=\"text-xs font-mono tracking-widest text-slate-400 uppercase\">Fair Play Charter</span>\n            <span className=\"px-2.5 py-1 rounded bg-violet-900/60 border border-violet-500/40 text-violet-300 font-mono font-bold text-sm\">\n              07 / 07\n            </span>\n          </div>\n        </div>\n\n        {/* Rules Grid & Arbiter Panel */}\n        <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8 items-start\">\n          \n          {/* Main 5 Flyer Rules List */}\n          <div className=\"lg:col-span-8 space-y-3.5\">\n            {RULES_LIST.map((rule, index) => {\n              const isExpanded = expandedRule === rule.id;\n\n              return (\n                <motion.div\n                  key={rule.id}\n                  initial={{ opacity: 0, x: -15 }}\n                  whileInView={{ opacity: 1, x: 0 }}\n                  viewport={{ once: true }}\n                  transition={{ duration: 0.3, delay: index * 0.08 }}\n                  className={`p-5 rounded-2xl glass border-l-4 ${\n                    rule.critical ? \'border-l-rose-500 hover:glow-violet\' : \'border-l-violet-500 hover:glow-violet\'\n                  } border-white/10 transition-all duration-300 cursor-pointer`}\n                  onClick={() => setExpandedRule(isExpanded ? null : rule.id)}\n                >\n                  <div className=\"flex items-center justify-between gap-4\">\n                    <div className=\"flex items-center gap-3.5\">\n                      <div className=\"w-10 h-10 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center shrink-0\">\n                        {iconMapping[rule.icon]}\n                      </div>\n\n                      <div className=\"flex items-center gap-2\">\n                        <CheckCircle2 className=\"w-4 h-4 text-amber-400 shrink-0\" />\n                        <h4 className=\"font-display font-bold text-base sm:text-lg text-white uppercase tracking-wide\">\n                          {rule.text}\n                        </h4>\n                      </div>\n                    </div>\n\n                    <div className=\"flex items-center gap-2 shrink-0\">\n                      {rule.critical && (\n                        <span className=\"hidden sm:inline-block px-2 py-0.5 rounded bg-rose-950/60 border border-rose-500/40 text-rose-300 text-[10px] font-mono uppercase font-bold\">\n                          Strict\n                        </span>\n                      )}\n                      <ChevronDown className={`w-5 h-5 text-slate-400 transition-transform duration-200 ${isExpanded ? \'rotate-180 text-violet-400\' : \'\'}`} />\n                    </div>\n                  </div>\n\n                  {/* Expanded detail explanation */}\n                  {isExpanded && (\n                    <motion.div\n                      initial={{ opacity: 0, height: 0 }}\n                      animate={{ opacity: 1, height: \'auto\' }}\n                      className=\"mt-4 pt-3 border-t border-white/10 text-xs sm:text-sm text-slate-300 pl-14 leading-relaxed\"\n                    >\n                      {rule.detail}\n                    </motion.div>\n                  )}\n                </motion.div>\n              );\n            })}\n          </div>\n\n          {/* Arbiter & Anti-Cheating Protocol Sidebar */}\n          <div className=\"lg:col-span-4 space-y-6\">\n            \n            {/* Anti-Cheating Notice */}\n            <div className=\"p-6 rounded-2xl glass glow-violet border-white/10 relative overflow-hidden\">\n              <div className=\"flex items-center gap-3 mb-4 text-amber-400 font-display font-bold text-base uppercase\">\n                <AlertTriangle className=\"w-5 h-5\" />\n                <span>Zero Tolerance Policy</span>\n              </div>\n              <p className=\"text-xs sm:text-sm text-slate-300 leading-relaxed mb-4\">\n                Metal detectors and wireless signal scanners will be active in the playing arena. Any unauthorized communication or assistance results in immediate disqualification and FIDE reporting.\n              </p>\n              <div className=\"p-3 rounded-xl bg-black/40 border border-white/10 text-xs font-mono text-slate-400 space-y-1\">\n                <div>\342\200\242 Storage lockers provided at entrance</div>\n                <div>\342\200\242 Emergency calls routed via arbiter desk</div>\n              </div>\n            </div>\n\n            {/* Time Control Summary Pill */}\n            <div className=\"p-6 rounded-2xl glass border-white/10\">\n              <div className=\"flex items-center gap-2.5 text-white font-display font-bold text-base uppercase mb-3\">\n                <Clock className=\"w-5 h-5 text-violet-400\" />\n                <span>Clock Settings</span>\n              </div>\n              <div className=\"space-y-2 text-xs font-mono text-slate-300\">\n                <div className=\"flex justify-between p-2 rounded-lg bg-black/40 border border-white/5\">\n                  <span className=\"text-slate-400\">Swiss & Knockout:</span>\n                  <span className=\"text-amber-300 font-bold\">10 min + 5s inc</span>\n                </div>\n                <div className=\"flex justify-between p-2 rounded-lg bg-black/40 border border-white/5\">\n                  <span className=\"text-slate-400\">Blitz Tie-Break:</span>\n                  <span className=\"text-violet-300 font-bold\">3 min + 2s inc</span>\n                </div>\n                <div className=\"flex justify-between p-2 rounded-lg bg-black/40 border border-white/5\">\n                  <span className=\"text-slate-400\">Armageddon Decider:</span>\n                  <span className=\"text-rose-300 font-bold\">5m (W) vs 4m (B)</span>\n                </div>\n              </div>\n            </div>\n\n          </div>\n\n        </div>\n\n      </div>\n    </section>\n  );\n};"
        replacement_content: "import React, { useState } from \'react\';\nimport { motion } from \'motion/react\';\nimport { \n  ShieldCheck, \n  BookOpen, \n  Handshake, \n  PhoneOff, \n  Scale, \n  Clock, \n  AlertTriangle,\n  ChevronDown\n} from \'lucide-react\';\nimport { RULES_LIST } from \'../data/tournamentData\';\n\nexport const RulesSection: React.FC = () => {\n  const [expandedRule, setExpandedRule] = useState<string | null>(null);\n\n  const iconMapping: Record<string, React.ReactNode> = {\n    BookOpen: <BookOpen className=\"w-4 h-4 text-white\" />,\n    Handshake: <Handshake className=\"w-4 h-4 text-white\" />,\n    SmartphoneOff: <PhoneOff className=\"w-4 h-4 text-white\" />,\n    Scale: <Scale className=\"w-4 h-4 text-white\" />,\n    Clock: <Clock className=\"w-4 h-4 text-white\" />\n  };\n\n  return (\n    <section id=\"rules\" className=\"py-24 relative overflow-hidden bg-black\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10\">\n        \n        {/* Section Header */}\n        <div className=\"flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-12 pb-4 border-b border-zinc-800\">\n          <div>\n            <div className=\"text-zinc-400 text-xs font-mono uppercase tracking-widest mb-1\">\n              Tournament Code of Conduct\n            </div>\n            <h2 className=\"text-3xl sm:text-4xl font-display font-black text-white tracking-wide uppercase\">\n              RULES AT A <span className=\"text-zinc-400 font-light\">GLANCE</span>\n            </h2>\n          </div>\n\n          <div className=\"flex items-center gap-3\">\n            <span className=\"text-xs font-mono tracking-widest text-zinc-400 uppercase\">Fair Play</span>\n            <span className=\"px-2.5 py-1 rounded bg-zinc-900 border border-zinc-800 text-zinc-300 font-mono font-bold text-xs\">\n              STAGE 06\n            </span>\n          </div>\n        </div>\n\n        {/* Rules Grid & Arbiter Panel */}\n        <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8 items-start\">\n          \n          {/* Main Rules List */}\n          <div className=\"lg:col-span-8 space-y-3\">\n            {RULES_LIST.map((rule, index) => {\n              const isExpanded = expandedRule === rule.id;\n\n              return (\n                <motion.div\n                  key={rule.id}\n                  initial={{ opacity: 0, y: 5 }}\n                  whileInView={{ opacity: 1, y: 0 }}\n                  viewport={{ once: true }}\n                  transition={{ duration: 0.2, delay: index * 0.04 }}\n                  className=\"p-5 rounded-xl bw-card bw-card-hover transition-all cursor-pointer\"\n                  onClick={() => setExpandedRule(isExpanded ? null : rule.id)}\n                >\n                  <div className=\"flex items-center justify-between gap-4\">\n                    <div className=\"flex items-center gap-3.5\">\n                      <div className=\"w-9 h-9 rounded-lg bg-zinc-900 border border-zinc-800 flex items-center justify-center shrink-0\">\n                        {iconMapping[rule.icon]}\n                      </div>\n\n                      <div>\n                        <h4 className=\"font-mono font-bold text-sm text-white uppercase tracking-wide\">\n                          {rule.text}\n                        </h4>\n                      </div>\n                    </div>\n\n                    <div className=\"flex items-center gap-2 shrink-0\">\n                      {rule.critical && (\n                        <span className=\"hidden sm:inline-block px-2 py-0.5 rounded bg-zinc-900 border border-zinc-700 text-white text-[10px] font-mono uppercase font-bold\">\n                          Mandatory\n                        </span>\n                      )}\n                      <ChevronDown className={`w-4 h-4 text-zinc-400 transition-transform duration-200 ${isExpanded ? \'rotate-180 text-white\' : \'\'}`} />\n                    </div>\n                  </div>\n\n                  {/* Expanded detail explanation */}\n                  {isExpanded && (\n                    <motion.div\n                      initial={{ opacity: 0, height: 0 }}\n                      animate={{ opacity: 1, height: \'auto\' }}\n                      className=\"mt-4 pt-3 border-t border-zinc-800 text-xs text-zinc-400 pl-12 font-mono leading-relaxed\"\n                    >\n                      {rule.detail}\n                    </motion.div>\n                  )}\n                </motion.div>\n              );\n            })}\n          </div>\n\n          {/* Arbiter & Protocol Sidebar */}\n          <div className=\"lg:col-span-4 space-y-6\">\n            \n            {/* Zero Tolerance Policy */}\n            <div className=\"p-6 rounded-xl bw-panel-deep font-mono\">\n              <div className=\"flex items-center gap-2 mb-3 text-white font-bold text-sm uppercase\">\n                <AlertTriangle className=\"w-4 h-4 text-zinc-300\" />\n                <span>Fair Play Enforcement</span>\n              </div>\n              <p className=\"text-xs text-zinc-400 leading-relaxed mb-4\">\n                Anti-cheating protocols and metal screening will be strictly conducted prior to all match sessions. Unregistered communication devices are prohibited in the competition area.\n              </p>\n              <div className=\"p-3 rounded bg-zinc-950 border border-zinc-800 text-[11px] text-zinc-400 space-y-1\">\n                <div>\342\200\242 Designated equipment lockers on site</div>\n                <div>\342\200\242 FIDE standard arbiter review for disputes</div>\n              </div>\n            </div>\n\n            {/* Time Control Summary */}\n            <div className=\"p-6 rounded-xl bw-panel-deep font-mono\">\n              <div className=\"flex items-center gap-2 text-white font-bold text-sm uppercase mb-3\">\n                <Clock className=\"w-4 h-4 text-zinc-300\" />\n                <span>Time Controls</span>\n              </div>\n              <div className=\"space-y-2 text-xs\">\n                <div className=\"flex justify-between p-2.5 rounded bg-zinc-950 border border-zinc-800\">\n                  <span className=\"text-zinc-400\">Swiss & Knockout:</span>\n                  <span className=\"text-white font-bold\">10 min + 5s</span>\n                </div>\n                <div className=\"flex justify-between p-2.5 rounded bg-zinc-950 border border-zinc-800\">\n                  <span className=\"text-zinc-400\">Blitz Tie-Break:</span>\n                  <span className=\"text-white font-bold\">3 min + 2s</span>\n                </div>\n                <div className=\"flex justify-between p-2.5 rounded bg-zinc-950 border border-zinc-800\">\n                  <span className=\"text-zinc-400\">Armageddon:</span>\n                  <span className=\"text-white font-bold\">5m (W) vs 4m (B)</span>\n                </div>\n              </div>\n            </div>\n\n          </div>\n\n        </div>\n\n      </div>\n    </section>\n  );\n};"
