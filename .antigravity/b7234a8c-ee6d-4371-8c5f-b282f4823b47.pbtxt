        }
        lines {
          text: "                  className=\"flex-1 py-3 rounded-xl bg-black/40 border border-white/10 hover:border-violet-500 text-slate-200 text-sm font-mono flex items-center justify-center gap-2 transition-colors\""
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "                >"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "                  {copiedId ? <Check className=\"w-4 h-4 text-emerald-400\" /> : <Copy className=\"w-4 h-4\" />}"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "                  <span>{copiedId ? \'Pass ID Copied!\' : \'Copy Pass ID\'}</span>"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "                  className=\"flex-1 py-2.5 rounded bw-btn-secondary text-xs flex items-center justify-center gap-1.5\""
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                >"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                  {copiedId ? <Check className=\"w-3.5 h-3.5\" /> : <Copy className=\"w-3.5 h-3.5\" />}"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                  <span>{copiedId ? \'Copied\' : \'Copy Pass ID\'}</span>"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                </button>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
