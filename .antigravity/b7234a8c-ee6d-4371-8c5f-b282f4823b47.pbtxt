    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState, useEffect } from \'react\';\nimport { motion } from \'motion/react\';\nimport { \n  Tv, \n  Mic, \n  Users, \n  BarChart3, \n  Radio, \n  Volume2, \n  Maximize2, \n  Play, \n  Eye, \n  Flame, \n  Sparkles,\n  MessageSquare\n} from \'lucide-react\';\nimport { ESPORTS_HIGHLIGHTS } from \'../data/tournamentData\';\nimport { KingIcon, QueenIcon } from \'./ChessGraphics\';\n\nexport const ESportsArenaSection: React.FC = () => {\n  const [activeTab, setActiveTab] = useState<\'board1\' | \'board2\'>(\'board1\');\n  const [commentaryLine, setCommentaryLine] = useState(0);\n\n  const commentaryFeed = [\n    { caster: \"GM Alex Vance\", time: \"14:22\", text: \"Look at that Knight sacrifice on e5! Absolute tactical audacity in Round 4!\", tag: \"Brilliant !!\" },\n    { caster: \"IM Sarah Chen\", time: \"14:23\", text: \"Black has only 35 seconds on the clock. The King is forced out into the open!\", tag: \"Time Trouble\" },\n    { caster: \"GM Alex Vance\", time: \"14:24\", text: \"Rook to d8 with check! The arena crowd is on their feet!\", tag: \"Decisive Move\" },\n    { caster: \"Host Desk\", time: \"14:25\", text: \"Audience poll: 78% predicted Qxh7#. Let\'s see if the engine confirms mate in 3!\", tag: \"Crowd Poll\" }\n  ];\n\n  useEffect(() => {\n    const timer = setInterval(() => {\n      setCommentaryLine(prev => (prev + 1) % commentaryFeed.length);\n    }, 4000);\n    return () => clearInterval(timer);\n  }, [commentaryFeed.length]);\n\n  return (\n    <section id=\"arena\" className=\"py-20 relative overflow-hidden bg-[#0b0f19] border-t border-b border-violet-950/40\">\n      \n      {/* Background ambient lighting */}\n      <div className=\"absolute top-1/2 right-1/4 w-96 h-96 bg-purple-600/10 blur-[140px] rounded-full pointer-events-none\" />\n      <div className=\"absolute bottom-0 left-10 w-80 h-80 bg-cyan-600/10 blur-[140px] rounded-full pointer-events-none\" />\n\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10\">\n        \n        {/* Section Header */}\n        <div className=\"flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-12 pb-4 border-b border-slate-800\">\n          <div>\n            <div className=\"inline-flex items-center gap-2 px-3 py-1 rounded-full bg-violet-950/80 border border-violet-500/40 text-violet-300 text-xs font-mono uppercase tracking-widest mb-2 font-semibold\">\n              <Radio className=\"w-3.5 h-3.5 text-rose-400 animate-pulse\" />\n              Arena Production & Broadcast\n            </div>\n            <h2 className=\"text-3xl sm:text-5xl font-display font-extrabold text-white tracking-wide uppercase\">\n              eSPORTS <span className=\"text-transparent bg-clip-text bg-gradient-to-r from-violet-400 via-pink-400 to-amber-300\">EXPERIENCE</span>\n            </h2>\n          </div>\n\n          <div className=\"flex items-center gap-3\">\n            <span className=\"text-xs font-mono tracking-widest text-slate-400 uppercase\">Broadcast Specs</span>\n            <span className=\"px-2.5 py-1 rounded bg-violet-900/60 border border-violet-500/40 text-violet-300 font-mono font-bold text-sm\">\n              08\n            </span>\n          </div>\n        </div>\n\n        {/* Live Broadcast Arena Preview Mockup */}\n        <div className=\"rounded-3xl p-4 sm:p-6 glass-panel-glow border-violet-500/40 mb-12 shadow-2xl relative\">\n          \n          {/* Top Broadcast Bar */}\n          <div className=\"flex items-center justify-between px-3 py-2 mb-4 bg-slate-950/80 rounded-xl border border-slate-800\">\n            <div className=\"flex items-center gap-3\">\n              <span className=\"flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-rose-600 text-white font-mono text-xs font-black uppercase tracking-wider animate-pulse\">\n                <Radio className=\"w-3.5 h-3.5\" />\n                LIVE ARENA STREAM\n              </span>\n              <span className=\"hidden sm:inline-block text-xs font-mono text-slate-400\">\n                Board 1: Grand Final Spotlight \342\200\242 Best of 5\n              </span>\n            </div>\n\n            <div className=\"flex items-center gap-2\">\n              <div className=\"flex items-center gap-1 text-xs font-mono text-amber-300 px-2.5 py-1 rounded bg-amber-950/40 border border-amber-500/30\">\n                <Eye className=\"w-3.5 h-3.5 text-amber-400\" />\n                <span>1,420 Spectators</span>\n              </div>\n            </div>\n          </div>\n\n          {/* Broadcast Stage Layout */}\n          <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-6 items-center\">\n            \n            {/* Visual Chess Stream Arena View */}\n            <div className=\"lg:col-span-8 bg-slate-950 rounded-2xl p-4 sm:p-6 border border-violet-500/20 relative overflow-hidden\">\n              \n              {/* Player 2 Header (Black) */}\n              <div className=\"flex items-center justify-between p-3 rounded-xl bg-slate-900/80 border border-slate-800 mb-4\">\n                <div className=\"flex items-center gap-3\">\n                  <div className=\"w-9 h-9 rounded-lg bg-slate-800 border border-slate-700 flex items-center justify-center font-bold text-white text-sm font-mono\">\n                    VK\n                  </div>\n                  <div>\n                    <span className=\"font-display font-bold text-white text-sm sm:text-base\">Vikram &apos;Tactician&apos; K.</span>\n                    <span className=\"block text-[11px] font-mono text-slate-400\">Rating: 2140 \342\200\242 IIT Delhi</span>\n                  </div>\n                </div>\n\n                <div className=\"font-mono text-lg font-black text-rose-400 bg-slate-950 px-3 py-1 rounded-lg border border-slate-800\">\n                  01:42\n                </div>\n              </div>\n\n              {/* Center Chessboard Visual Simulation */}\n              <div className=\"aspect-video w-full rounded-xl bg-gradient-to-br from-slate-900 via-indigo-950/60 to-slate-900 border border-violet-500/30 flex flex-col items-center justify-center relative p-4\">\n                \n                {/* Simulated Eval Bar on Left */}\n                <div className=\"absolute left-3 top-4 bottom-4 w-3 bg-slate-800 rounded-full overflow-hidden border border-slate-700 hidden sm:flex flex-col justify-end\">\n                  <div className=\"w-full bg-gradient-to-t from-violet-400 to-amber-300 h-[68%]\" />\n                </div>\n\n                {/* Animated Chess Clash Graphic */}\n                <div className=\"relative flex items-center justify-center gap-6 sm:gap-12\">\n                  <motion.div\n                    animate={{ scale: [1, 1.06, 1], y: [0, -4, 0] }}\n                    transition={{ duration: 3, repeat: Infinity }}\n                    className=\"p-4 rounded-2xl bg-amber-500/10 border border-amber-400/40 text-amber-400 shadow-lg shadow-amber-500/20\"\n                  >\n                    <KingIcon className=\"w-14 h-14 sm:w-20 sm:h-20\" glow />\n                    <span className=\"block text-center font-mono text-[11px] font-bold text-amber-300 mt-1\">WHITE</span>\n                  </motion.div>\n\n                  <div className=\"flex flex-col items-center\">\n                    <span className=\"font-display font-black text-xl sm:text-3xl text-amber-400 tracking-wider\">VS</span>\n                    <span className=\"text-[10px] font-mono text-slate-400 uppercase tracking-widest mt-1\">GAME 3</span>\n                  </div>\n\n                  <motion.div\n                    animate={{ scale: [1, 1.06, 1], y: [0, 4, 0] }}\n                    transition={{ duration: 3, repeat: Infinity, delay: 0.5 }}\n                    className=\"p-4 rounded-2xl bg-violet-500/10 border border-violet-400/40 text-violet-400 shadow-lg shadow-violet-500/20\"\n                  >\n                    <QueenIcon className=\"w-14 h-14 sm:w-20 sm:h-20\" glow />\n                    <span className=\"block text-center font-mono text-[11px] font-bold text-violet-300 mt-1\">BLACK</span>\n                  </motion.div>\n                </div>\n\n                {/* Bottom Overlay: Move Notation */}\n                <div className=\"absolute bottom-3 left-8 right-8 flex items-center justify-between px-4 py-1.5 rounded-lg bg-slate-950/90 border border-violet-500/30 text-xs font-mono\">\n                  <span className=\"text-violet-300\">Move 34: <strong>Nf6+ (Check!)</strong></span>\n                  <span className=\"text-emerald-400 font-bold\">Eval: +3.2 (Decisive Attack)</span>\n                </div>\n              </div>\n\n              {/* Player 1 Footer (White) */}\n              <div className=\"flex items-center justify-between p-3 rounded-xl bg-slate-900/80 border border-slate-800 mt-4\">\n                <div className=\"flex items-center gap-3\">\n                  <div className=\"w-9 h-9 rounded-lg bg-amber-500/20 border border-amber-400/40 flex items-center justify-center font-bold text-amber-300 text-sm font-mono\">\n                    AR\n                  </div>\n                  <div>\n                    <span className=\"font-display font-bold text-white text-sm sm:text-base\">Aarav &apos;Grandmaster&apos; R.</span>\n                    <span className=\"block text-[11px] font-mono text-slate-400\">Rating: 2210 \342\200\242 BITS Pilani</span>\n                  </div>\n                </div>\n\n                <div className=\"font-mono text-lg font-black text-amber-400 bg-slate-950 px-3 py-1 rounded-lg border border-slate-800\">\n                  03:15\n                </div>\n              </div>\n            </div>\n\n            {/* Right: Live Caster Desk & Audience Prediction Feed */}\n            <div className=\"lg:col-span-4 flex flex-col justify-between h-full space-y-4\">\n              \n              {/* Caster Voice Panel */}\n              <div className=\"p-4 rounded-2xl bg-slate-950/80 border border-violet-500/30\">\n                <div className=\"flex items-center justify-between mb-3 pb-2 border-b border-slate-800\">\n                  <div className=\"flex items-center gap-2 text-violet-400 font-display font-bold text-sm uppercase\">\n                    <Mic className=\"w-4 h-4 text-amber-400\" />\n                    <span>Caster Desk Commentary</span>\n                  </div>\n                  <span className=\"w-2 h-2 rounded-full bg-emerald-400 animate-ping\" />\n                </div>\n\n                <div className=\"space-y-3\">\n                  {commentaryFeed.map((item, idx) => (\n                    <motion.div\n                      key={idx}\n                      initial={{ opacity: 0, y: 5 }}\n                      animate={{ opacity: 1, y: 0 }}\n                      className={`p-2.5 rounded-xl border text-xs transition-all ${\n                        idx === commentaryLine\n                          ? \'bg-violet-950/60 border-violet-400 shadow-md\'\n                          : \'bg-slate-900/40 border-slate-800/80\'\n                      }`}\n                    >\n                      <div className=\"flex items-center justify-between text-[11px] font-mono mb-1\">\n                        <span className=\"text-amber-300 font-bold\">{item.caster}</span>\n                        <span className=\"text-slate-500\">{item.time}</span>\n                      </div>\n                      <p className=\"text-slate-200 leading-relaxed\">{item.text}</p>\n                    </motion.div>\n                  ))}\n                </div>\n              </div>\n\n              {/* Interactive Move Prediction Widget */}\n              <div className=\"p-4 rounded-2xl bg-gradient-to-br from-slate-950 to-indigo-950/40 border border-amber-500/30\">\n                <div className=\"flex items-center justify-between mb-2\">\n                  <span className=\"text-xs font-mono text-amber-400 font-bold uppercase flex items-center gap-1.5\">\n                    <Sparkles className=\"w-3.5 h-3.5\" />\n                    Audience Move Poll\n                  </span>\n                  <span className=\"text-[10px] font-mono text-slate-400\">Live</span>\n                </div>\n                <div className=\"text-xs text-slate-300 font-semibold mb-2\">\n                  Will Aarav find the Queen Sacrifice on move 35?\n                </div>\n                <div className=\"space-y-1.5\">\n                  <div className=\"flex items-center justify-between text-xs font-mono\">\n                    <span className=\"text-emerald-400\">YES (82%)</span>\n                    <span className=\"text-rose-400\">NO (18%)</span>\n                  </div>\n                  <div className=\"w-full h-2 rounded-full bg-slate-800 overflow-hidden flex\">\n                    <div className=\"bg-emerald-500 h-full w-[82%]\" />\n                    <div className=\"bg-rose-500 h-full w-[18%]\" />\n                  </div>\n                </div>\n              </div>\n\n            </div>\n\n          </div>\n        </div>\n\n        {/* 4 Feature Columns from Flyer */}\n        <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6\">\n          {ESPORTS_HIGHLIGHTS.map((item, idx) => (\n            <motion.div\n              key={item.id}\n              initial={{ opacity: 0, y: 20 }}\n              whileInView={{ opacity: 1, y: 0 }}\n              viewport={{ once: true }}\n              transition={{ duration: 0.4, delay: idx * 0.1 }}\n              className=\"p-6 rounded-2xl glass-panel border-slate-800 hover:border-violet-500/40 transition-all duration-300 flex flex-col justify-between group\"\n            >\n              <div>\n                <div className=\"w-12 h-12 rounded-xl bg-slate-900 border border-slate-700/80 group-hover:border-violet-500/40 flex items-center justify-center text-violet-300 mb-4 transition-colors\">\n                  {item.id === \'live_boards\' && <Tv className=\"w-6 h-6 text-violet-400\" />}\n                  {item.id === \'live_commentary\' && <Mic className=\"w-6 h-6 text-amber-400\" />}\n                  {item.id === \'audience_engagement\' && <Users className=\"w-6 h-6 text-cyan-400\" />}\n                  {item.id === \'esports_feel\' && <BarChart3 className=\"w-6 h-6 text-pink-400\" />}\n                </div>\n\n                <span className=\"text-xs font-mono uppercase tracking-wider text-violet-400 font-semibold block mb-1\">\n                  {item.subtitle}\n                </span>\n\n                <h3 className=\"text-xl font-display font-bold text-white uppercase tracking-wide group-hover:text-amber-300 transition-colors mb-2\">\n                  {item.title}\n                </h3>\n\n                <p className=\"text-xs sm:text-sm text-slate-300 leading-relaxed\">\n                  {item.description}\n                </p>\n              </div>\n\n              <div className=\"mt-5 pt-3 border-t border-slate-800 text-[11px] font-mono text-slate-400 flex items-center justify-between\">\n                <span>Production Standard</span>\n                <span className=\"text-emerald-400 font-bold\">HD 1080p60</span>\n              </div>\n            </motion.div>\n          ))}\n        </div>\n\n      </div>\n    </section>\n  );\n};\n"
    }
