roup-hover:text-amber-300 transition-colors mb-2\">\n                    {award.title}\n                  </h4>\n\n                  <p className=\"text-xs sm:text-sm text-slate-300 leading-relaxed\">\n                    {award.description}\n                  </p>\n                </div>\n\n                <div className=\"mt-5 pt-3 border-t border-slate-800/80 flex items-center justify-between text-xs font-mono text-slate-400\">\n                  <span className=\"flex items-center gap-1 text-violet-400\">\n                    <Star className=\"w-3.5 h-3.5\" />\n                    <span>Official Trophy Category</span>\n                  </span>\n                </div>\n              </motion.div>\n            );\n          })}\n        </div>\n\n      </div>\n    </section>"
