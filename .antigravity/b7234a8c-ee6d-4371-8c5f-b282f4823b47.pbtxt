  file_change {
    absolute_path_uri: "file:///src/components/Navbar.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState, useEffect } from \'react\';\nimport { motion, AnimatePresence } from \'motion/react\';\nimport { Trophy, Calendar, Award, Shield, Menu, X, Flame, Sparkles, ChevronRight } from \'lucide-react\';\nimport { KingIcon } from \'./ChessGraphics\';\n\ninterface NavbarProps {\n  onOpenRegister: () => void;\n}\n\nexport const Navbar: React.FC<NavbarProps> = ({ onOpenRegister }) => {\n  const [scrolled, setScrolled] = useState(false);\n  const [mobileMenuOpen, setMobileMenuOpen] = useState(false);\n\n  useEffect(() => {\n    const handleScroll = () => {\n      setScrolled(window.scrollY > 20);\n    };\n    window.addEventListener(\'scroll\', handleScroll);\n    return () => window.removeEventListener(\'scroll\', handleScroll);\n  }, []);\n\n  const navLinks = [\n    { name: \'About\', href: \'#about\' },\n    { name: \'Overview & Format\', href: \'#overview\' },\n    { name: \'Schedule\', href: \'#schedule\' },\n    { name: \'Awards\', href: \'#awards\' },\n    { name: \'eSports Arena\', href: \'#arena\' },\n    { name: \'Rules\', href: \'#rules\' },\n  ];\n\n  return (\n    <header\n      id=\"main-navigation\"\n      className={`fixed top-0 left-0 right-0 z-50 transition-all duration-300 ${\n        scrolled\n          ? \'bg-[#0b0f19]/90 backdrop-blur-md border-b border-violet-500/20 py-3 shadow-lg shadow-black/50\'\n          : \'bg-transparent py-5\'\n      }`}\n    >\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <div className=\"flex items-center justify-between\">\n          {/* Brand Logo */}\n          <a\n            href=\"#\"\n            id=\"brand-logo-link\"\n            className=\"flex items-center gap-3 group focus:outline-none\"\n          >\n            <div className=\"w-10 h-10 rounded-xl bg-gradient-to-br from-violet-600 to-indigo-800 p-0.5 shadow-lg shadow-violet-600/30 group-hover:shadow-violet-500/50 transition-all duration-300\">\n              <div className=\"w-full h-full bg-[#0b0f19] rounded-[10px] flex items-center justify-center text-amber-400 group-hover:scale-105 transition-transform\">\n                <KingIcon className=\"w-6 h-6\" glow />\n              </div>\n            </div>\n            <div>\n              <span className=\"font-display font-black text-xl sm:text-2xl tracking-wider text-white flex items-center gap-1.5\">\n                CHESS <span className=\"text-violet-400\">eSPORTS</span>\n              </span>\n              <span className=\"block text-[10px] font-mono tracking-widest text-amber-400 uppercase -mt-1 font-semibold\">\n                Compete \342\200\242 Think \342\200\242 Conquer\n              </span>\n            </div>\n          </a>\n\n          {/* Desktop Navigation Links */}\n          <nav id=\"desktop-nav-menu\" className=\"hidden md:flex items-center gap-1 lg:gap-2\">\n            {navLinks.map((link) => (\n              <a\n                key={link.name}\n                href={link.href}\n                className=\"px-3 py-2 text-sm font-medium text-slate-300 hover:text-violet-300 hover:bg-violet-950/40 rounded-lg transition-colors duration-200\"\n              >\n                {link.name}\n              </a>\n            ))}\n          </nav>\n\n          {/* Right Action CTA */}\n          <div className=\"hidden md:flex items-center gap-3\">\n            <div className=\"hidden lg:flex items-center gap-1.5 px-3 py-1 rounded-full bg-violet-950/60 border border-violet-500/30 text-xs font-mono text-violet-300\">\n              <span className=\"w-2 h-2 rounded-full bg-emerald-400 animate-ping\" />\n              <span>100 SLOTS \342\200\242 18 LEFT</span>\n            </div>\n\n            <button\n              id=\"nav-register-btn\"\n              onClick={onOpenRegister}\n              className=\"relative group overflow-hidden rounded-xl bg-gradient-to-r from-violet-600 via-indigo-600 to-purple-600 p-[1px] font-semibold text-white shadow-lg shadow-violet-600/30 hover:shadow-violet-500/60 transition-all duration-300 active:scale-95\"\n            >\n              <div className=\"px-5 py-2.5 rounded-[11px] bg-gradient-to-r from-violet-600 to-indigo-700 group-hover:from-violet-500 group-hover:to-indigo-600 flex items-center gap-2 text-sm\">\n                <Flame className=\"w-4 h-4 text-amber-300 group-hover:animate-bounce\" />\n                <span>Register Now</span>\n                <ChevronRight className=\"w-4 h-4 group-hover:translate-x-0.5 transition-transform\" />\n              </div>\n            </button>\n          </div>\n\n          {/* Mobile Menu Toggle Button */}\n          <div className=\"flex md:hidden items-center gap-2\">\n            <button\n              id=\"mobile-register-mini-btn\"\n              onClick={onOpenRegister}\n              className=\"px-3 py-1.5 rounded-lg bg-gradient-to-r from-violet-600 to-indigo-600 text-xs font-bold text-white shadow-md shadow-violet-600/30\"\n            >\n              Register\n            </button>\n            <button\n              id=\"mobile-menu-toggle-btn\"\n              onClick={() => setMobileMenuOpen(!mobileMenuOpen)}\n              className=\"p-2 rounded-lg bg-slate-800/80 border border-slate-700 text-slate-200 hover:text-white hover:bg-slate-700 transition-colors\"\n              aria-label=\"Toggle navigation menu\"\n            >\n              {mobileMenuOpen ? <X className=\"w-6 h-6\" /> : <Menu className=\"w-6 h-6\" />}\n            </button>\n          </div>\n        </div>\n      </div>\n\n      {/* Mobile Dropdown Menu */}\n      <AnimatePresence>\n        {mobileMenuOpen && (\n          <motion.div\n            id=\"mobile-nav-panel\"\n            initial={{ opacity: 0, height: 0 }}\n            animate={{ opacity: 1, height: \'auto\' }}\n            exit={{ opacity: 0, height: 0 }}\n            transition={{ duration: 0.25 }}\n            className=\"md:hidden bg-[#0f172a]/95 backdrop-blur-xl border-b border-violet-500/20 px-4 pt-3 pb-6 space-y-2 mt-3\"\n          >\n            <div className=\"flex items-center justify-between px-2 py-2 mb-2 rounded-lg bg-violet-950/40 border border-violet-500/30 text-xs font-mono text-violet-300\">\n              <span className=\"flex items-center gap-1.5\">\n                <span className=\"w-2 h-2 rounded-full bg-emerald-400 animate-pulse\" />\n                <span>2 Days \342\200\242 100 Players</span>\n              </span>\n              <span className=\"text-amber-400 font-bold\">18 Spots Left</span>\n            </div>\n\n            {navLinks.map((link) => (\n              <a\n                key={link.name}\n                href={link.href}\n                onClick={() => setMobileMenuOpen(false)}\n                className=\"block px-4 py-2.5 rounded-lg text-base font-medium text-slate-200 hover:bg-violet-900/30 hover:text-violet-300 transition-colors\"\n              >\n                {link.name}\n              </a>\n            ))}\n\n            <div className=\"pt-2\">\n              <button\n                id=\"mobile-menu-register-btn\"\n                onClick={() => {\n                  setMobileMenuOpen(false);\n                  onOpenRegister();\n                }}\n                className=\"w-full py-3 rounded-xl bg-gradient-to-r from-violet-600 via-indigo-600 to-purple-600 text-white font-bold text-center shadow-lg shadow-violet-600/40 flex items-center justify-center gap-2\"\n              >\n                <Flame className=\"w-5 h-5 text-amber-300\" />\n                <span>Register for Tournament</span>\n              </button>\n            </div>\n          </motion.div>\n        )}\n      </AnimatePresence>\n    </header>\n  );\n};\n"
    }
