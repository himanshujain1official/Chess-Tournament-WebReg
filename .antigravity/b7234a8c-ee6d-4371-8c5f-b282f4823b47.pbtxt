    replacement_infos {
      original_chunk {
        target_content: "  return (\n    <section id=\"schedule\" className=\"py-20 relative overflow-hidden bg-[#0b0f19] border-t border-b border-violet-950/40\">\n      \n      {/* Ambient background glows */}\n      <div className=\"absolute top-1/3 left-10 w-96 h-96 bg-violet-600/10 blur-[130px] rounded-full pointer-events-none\" />\n      <div className=\"absolute bottom-10 right-10 w-96 h-96 bg-amber-500/10 blur-[130px] rounded-full pointer-events-none\" />\n\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10\">\n        \n        {/* Section Header */}\n        <div className=\"flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-10 pb-4 border-b border-slate-800\">\n          <div>\n            <div className=\"inline-flex items-center gap-2 px-3 py-1 rounded-full bg-violet-950/80 border border-violet-500/40 text-violet-300 text-xs font-mono uppercase tracking-widest mb-2 font-semibold\">\n              <Calendar className=\"w-3.5 h-3.5 text-amber-400\" />\n              Real-Time Event Roadmap\n            </div>\n            <h2 className=\"text-3xl sm:text-5xl font-display font-extrabold text-white tracking-wide uppercase\">\n              INTERACTIVE <span className=\"text-transparent bg-clip-text bg-gradient-to-r from-violet-400 via-indigo-300 to-amber-300\">SCHEDULE</span>\n            </h2>\n          </div>\n\n          <div className=\"flex items-center gap-3\">\n            <span className=\"text-xs font-mono tracking-widest text-slate-400 uppercase\">Stages</span>\n            <span className=\"px-2.5 py-1 rounded bg-violet-900/60 border border-violet-500/40 text-violet-300 font-mono font-bold text-sm\">\n              04 / 05\n            </span>\n          </div>\n        </div>\n\n        {/* Top Control Bar: Day Tabs, Search & Filters */}\n        <div className=\"flex flex-col lg:flex-row items-stretch lg:items-center justify-between gap-6 mb-10\">\n          \n          {/* Main Day 1 vs Day 2 Switcher */}\n          <div className=\"flex items-center p-1.5 rounded-2xl bg-slate-900/90 border border-violet-500/30 w-full sm:w-auto\">\n            <button\n              id=\"schedule-day1-tab\"\n              onClick={() => {\n                setActiveDay(1);\n                setSelectedCategory(\'all\');\n              }}\n              className={`flex-1 sm:flex-initial px-6 sm:px-8 py-3 rounded-xl font-display font-black text-base tracking-wider uppercase transition-all duration-300 flex items-center justify-center gap-2.5 ${\n                activeDay === 1\n                  ? \'bg-gradient-to-r from-violet-600 to-indigo-600 text-white shadow-lg shadow-violet-600/40 ring-1 ring-violet-400\'\n                  : \'text-slate-400 hover:text-white hover:bg-slate-800/60\'\n              }`}\n            >\n              <Calendar className=\"w-5 h-5 text-violet-300\" />\n              <span>DAY 1 SCHEDULE</span>\n              <span className={`text-[10px] font-mono px-2 py-0.5 rounded ${activeDay === 1 ? \'bg-violet-950 text-amber-300\' : \'bg-slate-800 text-slate-400\'}`}>\n                12 Sessions\n              </span>\n            </button>\n\n            <button\n              id=\"schedule-day2-tab\"\n              onClick={() => {\n                setActiveDay(2);\n                setSelectedCategory(\'all\');\n              }}\n              className={`flex-1 sm:flex-initial px-6 sm:px-8 py-3 rounded-xl font-display font-black text-base tracking-wider uppercase transition-all duration-300 flex items-center justify-center gap-2.5 ${\n                activeDay === 2\n                  ? \'bg-gradient-to-r from-amber-500 to-yellow-500 text-slate-950 shadow-lg shadow-amber-500/30 ring-1 ring-amber-300\'\n                  : \'text-slate-400 hover:text-white hover:bg-slate-800/60\'\n              }`}\n            >\n              <Trophy className=\"w-5 h-5 text-slate-950\" />\n              <span>DAY 2 SCHEDULE</span>\n              <span className={`text-[10px] font-mono px-2 py-0.5 rounded ${activeDay === 2 ? \'bg-slate-950 text-amber-400 font-bold\' : \'bg-slate-800 text-slate-400\'}`}>\n                Finals Day\n              </span>\n            </button>\n          </div>\n\n          {/* Search & Category Filter */}\n          <div className=\"flex flex-col sm:flex-row items-stretch sm:items-center gap-3\">\n            {/* Search Input */}\n            <div className=\"relative\">\n              <Search className=\"w-4 h-4 text-slate-400 absolute left-3.5 top-1/2 -translate-y-1/2\" />\n              <input\n                id=\"schedule-search-input\"\n                type=\"text\"\n                value={searchQuery}\n                onChange={(e) => setSearchQuery(e.target.value)}\n                placeholder=\"Search schedule (e.g., Swiss, Final, Lunch)...\"\n                className=\"w-full sm:w-64 pl-10 pr-4 py-2.5 rounded-xl bg-slate-900/80 border border-slate-700/80 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-violet-500 focus:ring-1 focus:ring-violet-500\"\n              />\n            </div>\n\n            {/* Category Dropdown/Pills */}\n            <div className=\"flex items-center gap-1.5 overflow-x-auto pb-1 sm:pb-0\">\n              {[\'all\', \'match\', \'ceremony\', \'break\', \'special\'].map((cat) => (\n                <button\n                  key={cat}\n                  onClick={() => setSelectedCategory(cat)}\n                  className={`px-3 py-1.5 rounded-lg text-xs font-mono font-medium capitalize tracking-wider whitespace-nowrap transition-colors ${\n                    selectedCategory === cat\n                      ? \'bg-violet-600 text-white shadow-sm\'\n                      : \'bg-slate-900/70 text-slate-400 border border-slate-800 hover:text-white hover:bg-slate-800\'\n                  }`}\n                >\n                  {cat === \'all\' ? \'All Activities\' : cat}\n                </button>\n              ))}\n            </div>\n          </div>\n        </div>\n\n        {/* Day Theme Banner */}\n        <div className=\"mb-6 p-4 rounded-2xl bg-gradient-to-r from-slate-900/90 via-violet-950/40 to-slate-900/90 border border-violet-500/20 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3\">\n          <div className=\"flex items-center gap-3\">\n            <div className={`w-3 h-3 rounded-full ${activeDay === 1 ? \'bg-violet-400 animate-pulse\' : \'bg-amber-400 animate-pulse\'}`} />\n            <span className=\"font-display font-bold text-white text-base uppercase\">\n              {activeDay === 1 ? \'Day 1 Focus: Swiss System 5-Round Battle & Round of 32 Cut-off\' : \'Day 2 Focus: Knockout Stage, Audience Challenges, and Grand Final Crowning\'}\n            </span>\n          </div>\n          <span className=\"text-xs font-mono text-slate-400\">\n            {filteredSchedule.length} session{filteredSchedule.length !== 1 ? \'s\' : \'\'} listed\n          </span>\n        </div>\n\n        {/* Timeline Grid with Fluid Animation */}\n        <AnimatePresence mode=\"wait\">\n          <motion.div\n            key={`day-${activeDay}-${selectedCategory}-${searchQuery}`}\n            initial={{ opacity: 0, y: 15 }}\n            animate={{ opacity: 1, y: 0 }}\n            exit={{ opacity: 0, y: -15 }}\n            transition={{ duration: 0.3 }}\n            className=\"space-y-3.5\"\n          >\n            {filteredSchedule.length === 0 ? (\n              <div className=\"text-center py-16 rounded-2xl glass-panel border-slate-800\">\n                <Calendar className=\"w-10 h-10 text-slate-600 mx-auto mb-3\" />\n                <p className=\"text-slate-400 font-mono text-sm\">No schedule items match your current filter.</p>\n                <button\n                  onClick={() => {\n                    setSelectedCategory(\'all\');\n                    setSearchQuery(\'\');\n                  }}\n                  className=\"mt-3 px-4 py-2 rounded-lg bg-violet-600 text-white text-xs font-mono\"\n                >\n                  Reset Filters\n                </button>\n              </div>\n            ) : (\n              filteredSchedule.map((item, index) => {\n                const badgeInfo = categoryBadges[item.category] || {\n                  label: item.category,\n                  bg: \'bg-slate-800\',\n                  text: \'text-slate-300\'\n                };\n                const isSaved = savedReminders[item.id];\n\n                return (\n                  <motion.div\n                    key={item.id}\n                    initial={{ opacity: 0, x: -10 }}\n                    animate={{ opacity: 1, x: 0 }}\n                    transition={{ duration: 0.25, delay: index * 0.03 }}\n                    className=\"p-4 sm:p-5 rounded-2xl glass-panel hover:glass-panel-glow border-slate-800 hover:border-violet-500/40 transition-all duration-300 group flex flex-col md:flex-row items-start md:items-center justify-between gap-4\"\n                  >\n                    {/* Left: Time & Icon */}\n                    <div className=\"flex items-center gap-4 min-w-[240px]\">\n                      <div className=\"w-12 h-12 rounded-xl bg-slate-900/90 border border-slate-700/80 group-hover:border-violet-500/50 flex items-center justify-center shrink-0 transition-colors shadow-md\">\n                        {item.iconName && iconRegistry[item.iconName] ? iconRegistry[item.iconName] : <Clock className=\"w-5 h-5 text-violet-400\" />}\n                      </div>\n\n                      <div>\n                        <div className=\"flex items-center gap-2 font-mono text-amber-400 font-bold text-sm sm:text-base\">\n                          <Clock className=\"w-3.5 h-3.5 text-slate-500\" />\n                          <span>{item.time}</span>\n                        </div>\n                        <span className={`inline-block mt-0.5 px-2 py-0.5 rounded text-[10px] font-mono uppercase font-semibold border ${badgeInfo.bg} ${badgeInfo.text}`}>\n                          {badgeInfo.label}\n                        </span>\n                      </div>\n                    </div>\n\n                    {/* Center: Activity Name & Description */}\n                    <div className=\"flex-1\">\n                      <h4 className=\"font-display font-bold text-base sm:text-lg text-white group-hover:text-amber-300 transition-colors uppercase tracking-wide\">\n                        {item.activity}\n                      </h4>\n                      {item.description && (\n                        <p className=\"text-xs sm:text-sm text-slate-400 mt-1 leading-relaxed\">\n                          {item.description}\n                        </p>\n                      )}\n                    </div>\n\n                    {/* Right: Quick Interactive Actions */}\n                    <div className=\"flex items-center gap-2 shrink-0 self-end md:self-center\">\n                      <button\n                        onClick={() => toggleReminder(item.id)}\n                        className={`px-3 py-1.5 rounded-lg text-xs font-mono font-semibold transition-all flex items-center gap-1.5 ${\n                          isSaved\n                            ? \'bg-emerald-950/80 border border-emerald-500/60 text-emerald-300 shadow-sm\'\n                            : \'bg-slate-900 border border-slate-700/80 text-slate-300 hover:text-white hover:border-violet-500/50\'\n                        }`}\n                        title={isSaved ? \'Reminder set\' : \'Save reminder\'}\n                      >\n                        {isSaved ? <Check className=\"w-3.5 h-3.5 text-emerald-400\" /> : <Clock className=\"w-3.5 h-3.5 text-slate-400\" />}\n                        <span>{isSaved ? \'Saved\' : \'Reminder\'}</span>\n                      </button>\n                    </div>\n                  </motion.div>\n                );\n              })\n            )}\n          </motion.div>\n        </AnimatePresence>\n\n      </div>\n    </section>\n  );"
        replacement_content: "  return (\n    <section id=\"schedule\" className=\"py-20 relative overflow-hidden\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10\">\n        \n        {/* Section Header */}\n        <div className=\"flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-10 pb-4 border-b border-white/10\">\n          <div>\n            <div className=\"inline-flex items-center gap-2 px-3 py-1 rounded-full bg-violet-950/80 border border-violet-500/40 text-violet-300 text-xs font-mono uppercase tracking-widest mb-2 font-semibold\">\n              <Calendar className=\"w-3.5 h-3.5 text-amber-400\" />\n              Real-Time Event Roadmap\n            </div>\n            <h2 className=\"text-3xl sm:text-5xl font-display font-extrabold text-white tracking-wide uppercase\">\n              INTERACTIVE <span className=\"text-gradient-violet\">SCHEDULE</span>\n            </h2>\n          </div>\n\n          <div className=\"flex items-center gap-3\">\n            <span className=\"text-xs font-mono tracking-widest text-slate-400 uppercase\">Stages</span>\n            <span className=\"px-2.5 py-1 rounded bg-violet-900/60 border border-violet-500/40 text-violet-300 font-mono font-bold text-sm\">\n              04 / 06\n            </span>\n          </div>\n        </div>\n\n        {/* Top Control Bar: Day Tabs, Search & Filters */}\n        <div className=\"flex flex-col lg:flex-row items-stretch lg:items-center justify-between gap-6 mb-8\">\n          \n          {/* Main Day 1 vs Day 2 Switcher */}\n          <div className=\"flex items-center p-1.5 rounded-xl glass border border-white/10 w-full sm:w-auto\">\n            <button\n              id=\"schedule-day1-tab\"\n              onClick={() => {\n                setActiveDay(1);\n                setSelectedCategory(\'all\');\n              }}\n              className={`flex-1 sm:flex-initial px-6 py-2.5 rounded-lg font-bold text-xs sm:text-sm tr