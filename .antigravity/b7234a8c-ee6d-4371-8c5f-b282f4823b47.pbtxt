          text: "                      {generatedPass.playerData.ratingType} {generatedPass.playerData.ratingValue ? `(${generatedPass.playerData.ratingValue})` : \'\'}"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
