    instruction: "Apply Shadowed Black and White minimalist style to AboutSection"
    replacement_infos {
      original_chunk {
        target_content: "import React from \'react\';\nimport { motion } from \'motion/react\';\nimport { Globe, Tv, Sparkles, Trophy, Flame, ChevronRight, Zap, Target, Users } from \'lucide-react\';\nimport { ABOUT_FEATURES } from \'../data/tournamentData\';\n\ninterface AboutSectionProps {\n  onOpenRegister: () => void;\n}\n\nexport const AboutSection: React.FC<AboutSectionProps> = ({ onOpenRegister }) => {\n  const iconMap: Record<string, React.ReactNode> = {\n    Globe: <Globe className=\"w-6 h-6 text-cyan-400\" />,\n    Tv: <Tv className=\"w-6 h-6 text-violet-400\" />,\n    Sparkles: <Sparkles className=\"w-6 h-6 text-amber-400\" />,\n    Trophy: <Trophy className=\"w-6 h-6 text-yellow-300\" />\n  };\n\n  const borderColors: Record<string, string> = {\n    global_vibes: \'hover:border-cyan-500/50 hover:shadow-cyan-500/20\',\n    esports_exp: \'hover:border-violet-500/50 hover:shadow-violet-500/20\',\n    fun_engagement: \'hover:border-amber-500/50 hover:shadow-amber-500/20\',\n    one_goal: \'hover:border-yellow-500/50 hover:shadow-yellow-500/20\'\n  };\n\n  return (\n    <section id=\"about\" className=\"py-20 relative overflow-hidden\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10\">\n        \n        {/* Section Header & Stage Badge */}\n        <div className=\"flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-10 pb-4 border-b border-white/10\">\n          <div>\n            <div className=\"inline-flex items-center gap-2 px-3 py-1 rounded-full bg-violet-950/80 border border-violet-500/40 text-violet-300 text-xs font-mono uppercase tracking-widest mb-2 font-semibold\">\n              <Zap className=\"w-3.5 h-3.5 text-amber-400\" />\n              Tournament Blueprint\n            </div>\n            <h2 className=\"text-3xl sm:text-5xl font-display font-extrabold text-white tracking-wide uppercase\">\n              ABOUT THE <span className=\"text-gradient-violet\">EVENT</span>\n            </h2>\n          </div>\n\n          <div className=\"flex items-center gap-3\">\n            <span className=\"text-xs font-mono tracking-widest text-slate-400 uppercase\">Inter-College Showdown</span>\n            <span className=\"px-2.5 py-1 rounded bg-violet-900/60 border border-violet-500/40 text-violet-300 font-mono font-bold text-sm\">\n              02\n            </span>\n          </div>\n        </div>\n\n        {/* Narrative Box from Flyer */}\n        <motion.div\n          initial={{ opacity: 0, y: 20 }}\n          whileInView={{ opacity: 1, y: 0 }}\n          viewport={{ once: true }}\n          transition={{ duration: 0.6 }}\n          className=\"rounded-2xl p-6 sm:p-8 glass glow-violet border-white/10 mb-10 relative overflow-hidden\"\n        >\n          <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-6 items-center\">\n            <div className=\"lg:col-span-8\">\n              <p className=\"text-lg sm:text-xl text-slate-200 font-medium leading-relaxed mb-4\">\n                <strong className=\"text-white font-semibold\">Chess eSports</strong> is an exciting inter-college chess tournament that brings together <span className=\"text-amber-300 font-bold\">100 players</span> to compete, think strategically, and fight for the ultimate title.\n              </p>\n              <p className=\"text-base sm:text-lg text-violet-300 font-display font-bold tracking-wide uppercase flex items-center gap-2\">\n                <Target className=\"w-5 h-5 text-amber-400\" />\n                <span>It&apos;s more than a game \342\200\224 it&apos;s a battle of minds!</span>\n              </p>\n            </div>\n\n            <div className=\"lg:col-span-4 flex flex-col sm:flex-row lg:flex-col gap-3 justify-center\">\n              <div className=\"flex items-center gap-3 p-3 rounded-xl bg-black/40 border border-white/5\">\n                <div className=\"w-10 h-10 rounded-lg bg-violet-900/40 border border-violet-500/30 flex items-center justify-center text-violet-300\">\n                  <Users className=\"w-5 h-5\" />\n                </div>\n                <div>\n                  <div className=\"text-xs text-slate-400 font-mono\">Competitor Cap</div>\n                  <div className=\"text-sm font-bold text-white font-mono\">100 Collegiate Players</div>\n                </div>\n              </div>\n\n              <div className=\"flex items-center gap-3 p-3 rounded-xl bg-black/40 border border-white/5\">\n                <div className=\"w-10 h-10 rounded-lg bg-amber-900/30 border border-amber-500/30 flex items-center justify-center text-amber-300\">\n                  <Flame className=\"w-5 h-5 text-amber-400\" />\n                </div>\n                <div>\n                  <div className=\"text-xs text-slate-400 font-mono\">Championship Crown</div>\n                  <div className=\"text-sm font-bold text-amber-300 font-mono\">1 Undisputed King</div>\n                </div>\n              </div>\n            </div>\n          </div>\n        </motion.div>\n\n        {/* 4 Core Features Grid from Flyer */}\n        <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6\">\n          {ABOUT_FEATURES.map((feature, index) => {\n            const leftBorders = [\n              \'border-l-4 border-l-cyan-500\',\n              \'border-l-4 border-l-violet-500\',\n              \'border-l-4 border-l-amber-500\',\n              \'border-l-4 border-l-yellow-400\'\n            ];\n\n            return (\n              <motion.div\n                key={feature.id}\n                initial={{ opacity: 0, y: 25 }}\n                whileInView={{ opacity: 1, y: 0 }}\n                viewport={{ once: true }}\n                transition={{ duration: 0.5, delay: index * 0.1 }}\n                whileHover={{ y: -6 }}\n                className={`rounded-2xl p-6 glass ${leftBorders[index % 4]} transition-all duration-300 flex flex-col justify-between group shadow-xl`}\n              >\n                <div>\n                  {/* Header Icon + Stage tag */}\n                  <div className=\"flex items-center justify-between mb-4\">\n                    <div className=\"w-12 h-12 rounded-xl bg-white/5 border border-white/10 group-hover:border-violet-500/40 flex items-center justify-center transition-colors\">\n                      {iconMap[feature.icon]}\n                    </div>\n                    <span className=\"text-[11px] font-mono font-bold text-slate-400 px-2 py-0.5 rounded bg-black/40 border border-white/5\">\n                      {feature.badge}\n                    </span>\n                  </div>\n\n                  <div className=\"text-xs font-mono font-semibold uppercase tracking-wider text-violet-400 mb-1\">\n                    {feature.tagline}\n                  </div>\n\n                  <h3 className=\"text-xl font-display font-bold text-white uppercase tracking-wide mb-2 group-hover:text-amber-300 transition-colors\">\n                    {feature.title}\n                  </h3>\n\n                  <p className=\"text-sm text-slate-300 leading-relaxed\">\n                    {feature.description}\n                  </p>\n                </div>\n\n                <div className=\"mt-6 pt-4 border-t border-white/5 flex items-center justify-between text-xs text-slate-400 font-mono group-hover:text-violet-300 transition-colors\">\n                  <span>Explore Feature</span>\n                  <ChevronRight className=\"w-4 h-4 group-hover:translate-x-1 transition-transform\" />\n                </div>\n              </motion.div>\n            );\n          })}\n        </div>\n\n      </div>\n    </section>\n  );\n};"
        replacement_content: "import React from \'react\';\nimport { motion } from \'motion/react\';\nimport { Globe, Tv, Sparkles, Trophy, ArrowRight, Target, Users } from \'lucide-react\';\nimport { ABOUT_FEATURES } from \'../data/tournamentData\';\n\ninterface AboutSectionProps {\n  onOpenRegister: () => void;\n}\n\nexport const AboutSection: React.FC<AboutSectionProps> = ({ onOpenRegister }) => {\n  const iconMap: Record<string, React.ReactNode> = {\n    Globe: <Globe className=\"w-5 h-5 text-white\" />,\n    Tv: <Tv className=\"w-5 h-5 text-white\" />,\n    Sparkles: <Sparkles className=\"w-5 h-5 text-white\" />,\n    Trophy: <Trophy className=\"w-5 h-5 text-white\" />\n  };\n\n  return (\n    <section id=\"about\" className=\"py-24 relative overflow-hidden bg-black\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10\">\n        \n        {/* Section Header */}\n        <div className=\"flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-12 pb-4 border-b border-zinc-800\">\n          <div>\n            <div className=\"text-zinc-400 text-xs font-mono uppercase tracking-widest mb-1\">\n              Event Blueprint\n            </div>\n            <h2 className=\"text-3xl sm:text-4xl font-display font-black text-white tracking-wide uppercase\">\n              ABOUT THE <span className=\"text-zinc-400 font-light\">EVENT</span>\n            </h2>\n          </div>\n\n          <div className=\"flex items-center gap-3\">\n            <span className=\"text-xs font-mono tracking-widest text-zinc-400 uppercase\">Inter-College Showdown</span>\n            <span className=\"px-2.5 py-1 rounded bg-zinc-900 border border-zinc-800 text-zinc-300 font-mono font-bold text-xs\">\n              STAGE 01\n            </span>\n          </div>\n        </div>\n\n        {/* Narrative Box */}\n        <motion.div\n          initial={{ opacity: 0, y: 15 }}\n          whileInView={{ opacity: 1, y: 0 }}\n          viewport={{ once: true }}\n          transition={{ duration: 0.5 }}\n          className=\"bw-panel-deep rounded-xl p-6 sm:p-8 mb-10 relative overflow-hidden\"\n        >\n          <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8 items-center\">\n            <div className=\"lg:col-span-8\">\n              <p className=\"text-lg sm:text-xl text-zinc-200 font-normal leading-relaxed mb-4\">\n                <strong className=\"text-white font-bold\">Chess eSports</strong> is an inter-college championship bringing together <span className=\"text-white font-bold\">100 players</span> to compete, calculate under clock duress, and battle for the grand title.\n              </p>\n              <p className=\"text-sm sm:text-base text-zinc-400 font-mono flex items-center gap-2\">\n                <Target className=\"w-4 h-4 text-white\" />\n                <span>It&apos;s more than a game \342\200\224 it&apos;s a battle of minds.</span>\n              </p>\n            </div>\n\n            <div className=\"lg:col-span-4 flex flex-col sm:flex-row lg:flex-col gap-3\">\n              <div className=\"flex items-center gap-3 p-3.5 rounded-lg bg-zinc-900 border border-zinc-800\">\n                <div className=\"w-9 h-9 rounded bg-black border border-zinc-700 flex items-center justify-center text-white shrink-0\">\n                  <Users className=\"w-4 h-4\" />\n                </div>\n                <div>\n                  <div className=\"text-[10px] text-zinc-400 font-mono uppercase tracking-wider\">Tournament Field</div>\n                  <div className=\"text-sm font-bold text-white font-mono\">100 Collegiate Players</div>\n                </div>\n              </div>\n\n              <div className=\"flex items-center gap-3 p-3.5 rounded-lg bg-zinc-900 border border-zinc-800\">\n                <div className=\"w-9 h-9 rounded bg-black border border-zinc-700 flex items-center justify-center text-white shrink-0\">\n                  <Trophy className=\"w-4 h-4\" />\n                </div>\n                <div>\n                  <div className=\"text-[10px] text-zinc-400 font-mono uppercase tracking-wider\">Championship Crown</div>\n                  <div className=\"text-sm font-bold text-white font-mono\">1 Grand Champion</div>\n                </div>\n              </div>\n            </div>\n          </div>\n        </motion.div>\n\n        {/* 4 Core Features Grid */}\n        <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4\">\n          {ABOUT_FEATURES.map((feature, index) => {\n            return (\n              <motion.div\n                key={feature.id}\n                initial={{ opacity: 0, y: 15 }}\n                whileInView={{ opacity: 1, y: 0 }}\n                viewport={{ once: true }}\n                transition={{ duration: 0.4, delay: index * 0.08 }}\n                className=\"bw-card bw-card-hover rounded-xl p-6 flex flex-col justify-between\"\n              >\n                <div>\n                  <div className=\"flex items-center justify-between mb-4\">\n                    <div className=\"w-10 h-10 rounded-lg bg-zinc-900 border border-zinc-800 flex items-center justify-center text-white\">\n                      {iconMap[feature.icon]}\n                    </div>\n                    <span className=\"text-[10px] font-mono font-bold text-zinc-400 px-2 py-0.5 rounded bg-zinc-900 border border-zinc-800\">\n                      {feature.badge}\n                    </span>\n                  </div>\n\n                  <div className=\"text-[10px] font-mono uppercase tracking-widest text-zinc-400 mb-1\">\n                    {feature.tagline}\n                  </div>\n\n                  <h3 className=\"text-lg font-display font-bold text-white uppercase tracking-wider mb-2\">\n                    {feature.title}\n                  </h3>\n\n                  <p className=\"text-xs text-zinc-400 leading-relaxed\">\n                    {feature.description}\n                  </p>\n                </div>\n\n                <div className=\"mt-6 pt-4 border-t border-zinc-800/80 flex items-center justify-between text-[11px] text-zinc-400 font-mono\">\n                  <span>Explore Spec</span>\n                  <ArrowRight className=\"w-3.5 h-3.5\" />\n                </div>\n              </motion.div>\n            );\n          })}\n        </div>\n\n      </div>\n    </section>\n  );\n};"
