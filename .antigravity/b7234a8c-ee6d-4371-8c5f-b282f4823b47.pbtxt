    replacement_chunks {
      target_content: "    <section id=\"about\" className=\"py-20 relative overflow-hidden bg-[#0b0f19]\">\n      {/* Subtle Background Glows */}\n      <div className=\"absolute top-1/2 left-0 w-96 h-96 bg-violet-600/10 blur-[130px] rounded-full pointer-events-none\" />\n      <div className=\"absolute bottom-0 right-0 w-96 h-96 bg-amber-500/10 blur-[130px] rounded-full pointer-events-none\" />\n\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10\">\n        \n        {/* Section Header */}\n        <div className=\"flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-16 pb-4 border-b border-slate-800\">\n          <div>\n            <div className=\"inline-flex items-center gap-2 px-3 py-1 rounded-full bg-violet-950/80 border border-violet-500/40 text-violet-300 text-xs font-mono uppercase tracking-widest mb-2 font-semibold\">\n              <Sparkles className=\"w-3.5 h-3.5 text-amber-400\" />\n              Next-Gen Competitive Standard\n            </div>\n            <h2 className=\"text-3xl sm:text-5xl font-display font-extrabold text-white tracking-wide uppercase\">\n              THE <span className=\"text-transparent bg-clip-text bg-gradient-to-r from-violet-400 via-purple-300 to-amber-300\">eSPORTS EXPERIENCE</span>\n            </h2>\n          </div>\n\n          <div className=\"flex items-center gap-3\">\n            <span className=\"text-xs font-mono tracking-widest text-slate-400 uppercase\">Architecture</span>\n            <span className=\"px-2.5 py-1 rounded bg-violet-900/60 border border-violet-500/40 text-violet-300 font-mono font-bold text-sm\">\n              02 / 05\n            </span>\n          </div>\n        </div>\n\n        {/* Feature Cards Grid */}\n        <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6\">\n          {features.map((feature, index) => (\n            <motion.div\n              key={feature.title}\n              initial={{ opacity: 0, y: 20 }}\n              whileInView={{ opacity: 1, y: 0 }}\n              viewport={{ once: true }}\n              transition={{ duration: 0.5, delay: index * 0.1 }}\n              whileHover={{ y: -6 }}\n              className=\"p-6 sm:p-7 rounded-2xl glass-panel hover:glass-panel-glow border-slate-800 hover:border-violet-500/40 transition-all duration-300 flex flex-col justify-between group\"\n            >\n              <div>\n                <div className=\"flex items-center justify-between mb-6\">\n                  <div className=\"w-12 h-12 rounded-xl bg-slate-900/90 border border-slate-700/80 group-hover:border-violet-500/40 flex items-center justify-center text-white transition-colors\">\n                    {feature.icon}\n                  </div>\n                  <span className=\"text-xs font-mono text-slate-400 uppercase px-2 py-1 rounded bg-slate-900 border border-slate-800\">\n                    0{index + 1}\n                  </span>\n                </div>\n\n                <span className=\"text-xs font-mono uppercase tracking-wider text-violet-400 font-semibold block mb-1\">\n                  {feature.tagline}\n                </span>\n\n                <h3 className=\"text-xl font-display font-bold text-white uppercase tracking-wide group-hover:text-amber-300 transition-colors mb-3\">\n                  {feature.title}\n                </h3>\n\n                <p className=\"text-slate-300 text-sm leading-relaxed\">\n                  {feature.description}\n                </p>\n              </div>\n\n              <div className=\"mt-8 pt-4 border-t border-slate-800/80 flex items-center justify-between text-xs text-slate-400\">\n                <span className=\"font-mono text-xs\">Arena Spec</span>\n                <span className=\"text-violet-400 font-semibold\">Active</span>\n              </div>\n            </motion.div>\n          ))}\n        </div>\n\n      </div>\n    </section>"
      replacement_content: "    <section id=\"about\" className=\"py-20 relative overflow-hidden\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10\">\n        \n        {/* Section Header */}\n        <div className=\"flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-12 pb-4 border-b border-white/10\">\n          <div>\n            <div className=\"inline-flex items-center gap-2 px-3 py-1 rounded-full bg-violet-950/80 border border-violet-500/40 text-violet-300 text-xs font-mono uppercase tracking-widest mb-2 font-semibold\">\n              <Sparkles className=\"w-3.5 h-3.5 text-amber-400\" />\n              Next-Gen Competitive Standard\n            </div>\n            <h2 className=\"text-3xl sm:text-5xl font-display font-extrabold text-white tracking-wide uppercase\">\n              THE <span className=\"text-gradient-violet\">eSPORTS EXPERIENCE</span>\n            </h2>\n          </div>\n\n          <div className=\"flex items-center gap-3\">\n            <span className=\"text-xs font-mono tracking-widest text-slate-400 uppercase\">Architecture</span>\n            <span className=\"px-2.5 py-1 rounded bg-violet-900/60 border border-violet-500/40 text-violet-300 font-mono font-bold text-sm\">\n              02 / 06\n            </span>\n          </div>\n        </div>\n\n        {/* Feature Cards Grid */}\n        <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6\">\n          {features.map((feature, index) => {\n            const borderAccents = [\n              \'border-l-4 border-l-violet-500\',\n              \'border-l-4 border-l-amber-500\',\n              \'border-l-4 border-l-cyan-500\',\n              \'border-l-4 border-l-purple-500\'\n            ];\n\n            return (\n              <motion.div\n                key={feature.title}\n                initial={{ opacity: 0, y: 20 }}\n                whileInView={{ opacity: 1, y: 0 }}\n                viewport={{ once: true }}\n                transition={{ duration: 0.5, delay: index * 0.1 }}\n                whileHover={{ y: -6 }}\n                className={`p-6 rounded-2xl glass ${borderAccents[index % 4]} hover:glow-violet transition-all duration-300 flex flex-col justify-between group`}\n              >\n                <div>\n                  <div className=\"flex items-center justify-between mb-4\">\n                    <div className=\"w-12 h-12 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center text-white group-hover:scale-105 transition-transform\">\n                      {feature.icon}\n                    </div>\n                    <span className=\"text-[10px] font-mono text-slate-400 uppercase px-2 py-1 rounded bg-black/40 border border-white/5\">\n                      0{index + 1}\n                    </span>\n                  </div>\n\n                  <span className=\"text-xs font-mono uppercase tracking-wider text-violet-400 font-semibold block mb-1\">\n                    {feature.tagline}\n                  </span>\n\n                  <h3 className=\"text-lg sm:text-xl font-display font-bold text-white uppercase tracking-wide group-hover:text-amber-300 transition-colors mb-3\">\n                    {feature.title}\n                  </h3>\n\n                  <p className=\"text-slate-300 text-xs sm:text-sm leading-relaxed\">\n                    {feature.description}\n                  </p>\n                </div>\n\n                <div className=\"mt-6 pt-4 border-t border-white/5 flex items-center justify-between text-xs text-slate-400\">\n                  <span className=\"font-mono text-[11px] text-slate-400\">Live Stage Ready</span>\n                  <span className=\"w-2 h-2 rounded-full bg-violet-400 group-hover:bg-amber-400 transition-colors\" />\n                </div>\n              </motion.div>\n            );\n          })}\n        </div>\n\n      </div>\n    </section>"
    }
