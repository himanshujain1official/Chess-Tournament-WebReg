    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "import React, { useState } from \'react\';\nimport { motion, AnimatePresence } from \'motion/react\';\nimport { \n  Calendar, \n  Clock, \n  Swords, \n  Flame, \n  Coffee, \n  Trophy, \n  Award, \n  Zap, \n  Search, \n  Filter, \n  Sparkles, \n  Check, \n  Share2, \n  UserCheck, \n  FileText, \n  ListOrdered, \n  ShieldAlert,\n  Crown\n} from \'lucide-react\';\nimport { DAY1_SCHEDULE, DAY2_SCHEDULE } from \'../data/tournamentData\';\nimport { ScheduleItem } from \'../types\';\n\nexport const InteractiveSchedule: React.FC = () => {\n  const [activeDay, setActiveDay] = useState<1 | 2>(1);\n  const [selectedCategory, setSelectedCategory] = useState<string>(\'all\');\n  const [searchQuery, setSearchQuery] = useState<string>(\'\');\n  const [savedReminders, setSavedReminders] = useState<Record<string, boolean>>({});\n\n  const iconRegistry: Record<string, React.ReactNode> = {\n    UserCheck: <UserCheck className=\"w-5 h-5 text-indigo-400\" />,\n    Flame: <Flame className=\"w-5 h-5 text-amber-400\" />,\n    FileText: <FileText className=\"w-5 h-5 text-violet-400\" />,\n    Swords: <Swords className=\"w-5 h-5 text-rose-400\" />,\n    Coffee: <Coffee className=\"w-5 h-5 text-emerald-400\" />,\n    ListOrdered: <ListOrdered className=\"w-5 h-5 text-cyan-400\" />,\n    Zap: <Zap className=\"w-5 h-5 text-yellow-400\" />,\n    Award: <Award className=\"w-5 h-5 text-purple-400\" />,\n    ShieldAlert: <ShieldAlert className=\"w-5 h-5 text-pink-400\" />,\n    Sparkles: <Sparkles className=\"w-5 h-5 text-cyan-300\" />,\n    Crown: <Crown className=\"w-5 h-5 text-amber-300\" />,\n    Trophy: <Trophy className=\"w-5 h-5 text-amber-400\" />\n  };\n\n  const scheduleList = activeDay === 1 ? DAY1_SCHEDULE : DAY2_SCHEDULE;\n\n  const filteredSchedule = scheduleList.filter((item: ScheduleItem) => {\n    const matchesCategory = selectedCategory === \'all\' || item.category === selectedCategory;\n    const matchesSearch = item.activity.toLowerCase().includes(searchQuery.toLowerCase()) ||\n                          item.time.toLowerCase().includes(searchQuery.toLowerCase()) ||\n                          (item.description && item.description.toLowerCase().includes(searchQuery.toLowerCase()));\n    return matchesCategory && matchesSearch;\n  });\n\n  const toggleReminder = (id: string) => {\n    setSavedReminders(prev => ({\n      ...prev,\n      [id]: !prev[id]\n    }));\n  };\n\n  const categoryBadges: Record<string, { label: string; bg: string; text: string }> = {\n    ceremony: { label: \'Ceremony\', bg: \'bg-indigo-950/60 border-indigo-500/40\', text: \'text-indigo-300\' },\n    match: { label: \'Match Round\', bg: \'bg-rose-950/60 border-rose-500/40\', text: \'text-rose-300\' },\n    break: { label: \'Break & Rest\', bg: \'bg-emerald-950/60 border-emerald-500/40\', text: \'text-emerald-300\' },\n    results: { label: \'Standings\', bg: \'bg-cyan-950/60 border-cyan-500/40\', text: \'text-cyan-300\' },\n    special: { label: \'Audience Event\', bg: \'bg-amber-950/60 border-amber-500/40\', text: \'text-amber-300\' }\n  };\n\n  return (\n    <section id=\"schedule\" className=\"py-20 relative overflow-hidden\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10\">\n        \n        {/* Section Header */}\n        <div className=\"flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-10 pb-4 border-b border-white/10\">\n          <div>\n            <div className=\"inline-flex items-center gap-2 px-3 py-1 rounded-full bg-violet-950/80 border border-violet-500/40 text-violet-300 text-xs font-mono uppercase tracking-widest mb-2 font-semibold\">\n              <Calendar className=\"w-3.5 h-3.5 text-amber-400\" />\n              Real-Time Event Roadmap\n            </div>\n            <h2 className=\"text-3xl sm:text-5xl font-display font-extrabold text-white tracking-wide uppercase\">\n              INTERACTIVE <span className=\"text-gradient-violet\">SCHEDULE</span>\n            </h2>\n          </div>\n\n          <div className=\"flex items-center gap-3\">\n            <span className=\"text-xs font-mono tracking-widest text-slate-400 uppercase\">Stages</span>\n            <span className=\"px-2.5 py-1 rounded bg-violet-900/60 border border-violet-500/40 text-violet-300 font-mono font-bold text-sm\">\n              04 / 06\n            </span>\n          </div>\n        </div>\n\n        {/* Top Control Bar: Day Tabs, Search & Filters */}\n        <div className=\"flex flex-col lg:flex-row items-stretch lg:items-center justify-between gap-6 mb-8\">\n          \n          {/* Main Day 1 vs Day 2 Switcher */}\n          <div className=\"flex items-center p-1.5 rounded-xl glass border border-white/10 w-full sm:w-auto\">\n            <button\n              id=\"schedule-day1-tab\"\n              onClick={() => {\n                setActiveDay(1);\n                setSelectedCategory(\'all\');\n              }}\n              className={`flex-1 sm:flex-initial px-6 py-2.5 rounded-lg font-bold text-xs sm:text-sm tracking-wider uppercase transition-all duration-300 flex items-center justify-center gap-2 ${\n                activeDay === 1\n                  ? \'bg-violet-600 text-white shadow-lg shadow-violet-600/30\'\n                  : \'text-slate-400 hover:text-white hover:bg-white/5\'\n              }`}\n            >\n              <Calendar className=\"w-4 h-4 text-violet-300\" />\n              <span>DAY 1 SCHEDULE</span>\n              <span className={`text-[10px] font-mono px-2 py-0.5 rounded ${activeDay === 1 ? \'bg-violet-950 text-amber-300\' : \'bg-black/40 text-slate-400\'}`}>\n                12 Sessions\n              </span>\n            </button>\n\n            <button\n              id=\"schedule-day2-tab\"\n              onClick={() => {\n                setActiveDay(2);\n                setSelectedCategory(\'all\');\n              }}\n              className={`flex-1 sm:flex-initial px-6 py-2.5 rounded-lg font-bold text-xs sm:text-sm tracking-wider uppercase transition-all duration-300 flex items-center justify-center gap-2 ${\n                activeDay === 2\n                  ? \'bg-amber-400 text-slate-950 shadow-lg shadow-amber-500/30\'\n                  : \'text-slate-400 hover:text-white hover:bg-white/5\'\n              }`}\n            >\n              <Trophy className=\"w-4 h-4 text-slate-950\" />\n              <span>DAY 2 SCHEDULE</span>\n              <span className={`text-[10px] font-mono px-2 py-0.5 rounded ${activeDay === 2 ? \'bg-slate-950 text-amber-400 font-bold\' : \'bg-black/40 text-slate-400\'}`}>\n                Finals Day\n              </span>\n            </button>\n          </div>\n\n          {/* Search & Category Filter */}\n          <div className=\"flex flex-col sm:flex-row items-stretch sm:items-center gap-3\">\n            {/* Search Input */}\n            <div className=\"relative\">\n              <Search className=\"w-4 h-4 text-slate-400 absolute left-3.5 top-1/2 -translate-y-1/2\" />\n              <input\n                id=\"schedule-search-input\"\n                type=\"text\"\n                value={searchQuery}\n                onChange={(e) => setSearchQuery(e.target.value)}\n                placeholder=\"Search schedule (e.g., Swiss, Final, Lunch)...\"\n                className=\"w-full sm:w-64 pl-10 pr-4 py-2.5 rounded-xl bg-black/40 border border-white/10 text-xs text-white placeholder-slate-500 focus:outline-none focus:border-violet-500 focus:ring-1 focus:ring-violet-500\"\n              />\n            </div>\n\n            {/* Category Dropdown/Pills */}\n            <div className=\"flex items-center gap-1.5 overflow-x-auto pb-1 sm:pb-0\">\n              {[\'all\', \'match\', \'ceremony\', \'break\', \'special\'].map((cat) => (\n                <button\n                  key={cat}\n                  onClick={() => setSelectedCategory(cat)}\n                  className={`px-3 py-1.5 rounded-lg text-xs font-mono font-medium capitalize tracking-wider whitespace-nowrap transition-colors ${\n                    selectedCategory === cat\n                      ? \'bg-violet-600 text-white shadow-sm\'\n                      : \'bg-black/40 text-slate-400 border border-white/5 hover:text-white hover:bg-white/5\'\n                  }`}\n                >\n                  {cat === \'all\' ? \'All Activities\' : cat}\n                </button>\n              ))}\n            </div>\n          </div>\n        </div>\n\n        {/* Day Theme Banner */}\n        <div className=\"mb-6 p-4 rounded-xl glass border-white/10 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3\">\n          <div className=\"flex items-center gap-3\">\n            <div className={`w-2.5 h-2.5 rounded-full ${activeDay === 1 ? \'bg-violet-400 animate-pulse\' : \'bg-amber-400 animate-pulse\'}`} />\n            <span className=\"font-bold text-white text-sm sm:text-base uppercase\">\n              {activeDay === 1 ? \'Day 1 Focus: Swiss System 5-Round Battle & Round of 32 Cut-off\' : \'Day 2 Focus: Knockout Stage, Audience Challenges, and Grand Final Crowning\'}\n            </span>\n          </div>\n          <span className=\"text-xs font-mono text-slate-400\">\n            {filteredSchedule.length} session{filteredSchedule.length !== 1 ? \'s\' : \'\'} listed\n          </span>\n        </div>\n\n        {/* Timeline Grid with Fluid Animation */}\n        <AnimatePresence mode=\"wait\">\n          <motion.div\n            key={`day-${activeDay}-${selectedCategory}-${searchQuery}`}\n            initial={{ opacity: 0, y: 15 }}\n            animate={{ opacity: 1, y: 0 }}\n            exit={{ opacity: 0, y: -15 }}\n            transition={{ duration: 0.3 }}\n            className=\"space-y-3\"\n          >\n            {filteredSchedule.length === 0 ? (\n              <div className=\"text-center py-16 rounded-2xl glass border-white/10\">\n                <Calendar className=\"w-10 h-10 text-slate-600 mx-auto mb-3\" />\n                <p className=\"text-slate-400 font-mono text-sm\">No schedule items match your current filter.</p>\n                <button\n                  onClick={() => {\n                    setSelectedCategory(\'all\');\n                    setSearchQuery(\'\');\n                  }}\n                  className=\"mt-3 px-4 py-2 rounded-lg bg-violet-600 text-white text-xs font-mono\"\n                >\n                  Reset Filters\n                </button>\n              </div>\n            ) : (\n              filteredSchedule.map((item, index) => {\n                const badgeInfo = categoryBadges[item.category] || {\n                  label: item.category,\n                  bg: \'bg-slate-800\',\n                  text: \'text-slate-300\'\n                };\n                const isSaved = savedReminders[item.id];\n\n                return (\n                  <motion.div\n                    key={item.id}\n                    initial={{ opacity: 0, x: -10 }}\n                    animate={{ opacity: 1, x: 0 }}\n                    transition={{ duration: 0.25, delay: index * 0.02 }}\n                    className=\"p-4 rounded-xl glass hover:glow-violet border-white/5 hover:border-violet-500/30 transition-all duration-300 group flex flex-col md:flex-row items-start md:items-center justify-between gap-4\"\n                  >\n                    {/* Left: Time & Icon */}\n                    <div className=\"flex items-center gap-4 min-w-[220px]\">\n                      <div className=\"w-10 h-10 rounded-lg bg-white/5 border border-white/10 group-hover:border-violet-500/40 flex items-center justify-center shrink-0 transition-colors\">\n                        {item.iconName && iconRegistry[item.iconName] ? iconRegistry[item.iconName] : <Clock className=\"w-4 h-4 text-violet-400\" />}\n                      </div>\n\nContentType:"
      replacement_content: "import React, { useState } from \'react\';\nimport { motion, AnimatePresence } from \'motion/react\';\nimport { \n  Calendar, \n  Clock, \n  Search, \n  Check, \n  Trophy,\n  Activity\n} from \'lucide-react\';\nimport { DAY1_SCHEDULE, DAY2_SCHEDULE } from \'../data/tournamentData\';\nimport { ScheduleItem } from \'../types\';\n\nexport const InteractiveSchedule: React.FC = () => {\n  const [activeDay, setActiveDay] = useState<1 | 2>(1);\n  const [selectedCategory, setSelectedCategory] = useState<string>(\'all\');\n  const [searchQuery, setSearchQuery] = useState<string>(\'\');\n  const [savedReminders, setSavedReminders] = useState<Record<string, boolean>>({});\n\n  const scheduleList = activeDay === 1 ? DAY1_SCHEDULE : DAY2_SCHEDULE;\n\n  const filteredSchedule = scheduleList.filter((item: ScheduleItem) => {\n    const matchesCategory = selectedCategory === \'all\' || item.category === selectedCategory;\n    const matchesSearch = item.activity.toLowerCase().includes(searchQuery.toLowerCase()) ||\n                          item.time.toLowerCase().includes(searchQuery.toLowerCase()) ||\n                          (item.description && item.description.toLowerCase().includes(searchQuery.toLowerCase()));\n    return matchesCategory && matchesSearch;\n  });\n\n  const toggleReminder = (id: string) => {\n    setSavedReminders(prev => ({\n      ...prev,\n      [id]: !prev[id]\n    }));\n  };\n\n  return (\n    <section id=\"schedule\" className=\"py-24 relative overflow-hidden bg-black\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10\">\n        \n        {/* Section Header */}\n        <div className=\"flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-12 pb-4 border-b border-zinc-800\">\n          <div>\n            <div className=\"text-zinc-400 text-xs font-mono uppercase tracking-widest mb-1\">\n              Event Roadmap\n            </div>\n            <h2 className=\"text-3xl sm:text-4xl font-display font-black text-white tracking-wide uppercase\">\n              TOURNAMENT <span className=\"text-zinc-400 font-light\">SCHEDULE</span>\n            </h2>\n          </div>\n\n          <div className=\"flex items-center gap-3\">\n            <span className=\"text-xs font-mono tracking-widest text-zinc-400 uppercase\">Interactive Timeline</span>\n            <span className=\"px-2.5 py-1 rounded bg-zinc-900 border border-zinc-800 text-zinc-300 font-mono font-bold text-xs\">\n              STAGE 03\n            </span>\n          </div>\n        </div>\n\n        {/* Top Control Bar: Day Tabs, Search & Filters */}\n        <div className=\"flex flex-col lg:flex-row items-stretch lg:items-center justify-between gap-6 mb-8\">\n          \n          {/* Main Day 1 vs Day 2 Switcher */}\n          <div className=\"flex items-center p-1 rounded-lg bg-zinc-900 border border-zinc-800 w-full sm:w-auto\">\n            <button\n              id=\"schedule-day1-tab\"\n              onClick={() => {\n                setActiveDay(1);\n                setSelectedCategory(\'all\');\n              }}\n              className={`flex-1 sm:flex-initial px-6 py-2.5 rounded font-mono font-bold text-xs tracking-wider uppercase transition-all duration-200 flex items-center justify-center gap-2 ${\n                activeDay === 1\n                  ? \'bg-white text-black shadow-md\'\n                  : \'text-zinc-400 hover:text-white hover:bg-zinc-800\'\n              }`}\n            >\n              <Calendar className=\"w-3.5 h-3.5\" />\n              <span>DAY 1</span>\n              <span className={`text-[10px] font-mono px-1.5 py-0.5 rounded ${activeDay === 1 ? \'bg-zinc-200 text-black\' : \'bg-black text-zinc-400\'}`}>\n                Swiss & R32\n              </span>\n            </button>\n\n            <button\n              id=\"schedule-day2-tab\"\n              onClick={() => {\n                setActiveDay(2);\n                setSelectedCategory(\'all\');\n              }}\n              className={`flex-1 sm:flex-initial px-6 py-2.5 rounded font-mono font-bold text-xs tracking-wider uppercase transition-all duration-200 flex items-center justify-center gap-2 ${\n                activeDay === 2\n                  ? \'bg-white text-black shadow-md\'\n                  : \'text-zinc-400 hover:text-white hover:bg-zinc-800\'\n              }`}\n            >\n              <Trophy className=\"w-3.5 h-3.5\" />\n              <span>DAY 2</span>\n              <span className={`text-[10px] font-mono px-1.5 py-0.5 rounded ${activeDay === 2 ? \'bg-zinc-200 text-black\' : \'bg-black text-zinc-400\'}`}>\n                Knockouts & Finals\n              </span>\n            </button>\n          </div>\n\n          {/* Search & Category Filter */}\n          <div className=\"flex flex-col sm:flex-row items-stretch sm:items-center gap-3\">\n            {/* Search Input */}\n            <div className=\"relative\">\n              <Search className=\"w-3.5 h-3.5 text-zinc-400 absolute left-3.5 top-1/2 -translate-y-1/2\" />\n              <input\n                id=\"schedule-search-input\"\n                type=\"text\"\n                value={searchQuery}\n                onChange={(e) => setSearchQuery(e.target.value)}\n                placeholder=\"Search sessions (e.g., Swiss, Final)...\"\n                className=\"w-full sm:w-64 pl-9 pr-4 py-2.5 rounded-lg bg-zinc-900 border border-zinc-800 text-xs font-mono text-white placeholder-zinc-500 focus:outline-none focus:border-zinc-500\"\n              />\n            </div>\n\n            {/* Category Dropdown/Pills */}\n            <div className=\"flex items-center gap-1.5 overflow-x-auto pb-1 sm:pb-0\">\n              {[\'all\', \'match\', \'ceremony\', \'break\', \'special\'].map((cat) => (\n                <button\n                  key={cat}\n                  onClick={() => setSelectedCategory(cat)}\n                  className={`px-3 py-1.5 rounded text-xs font-mono capitalize tracking-wider whitespace-nowrap transition-colors ${\n                    selectedCategory === cat\n                      ? \'bg-white text-black font-bold\'\n                      : \'bg-zinc-900 text-zinc-400 border border-zinc-800 hover:text-white hover:bg-zinc-800\'\n                  }`}\n                >\n                  {cat === \'all\' ? \'All Activities\' : cat}\n                </button>\n              ))}\n            </div>\n          </div>\n        </div>\n\n        {/* Day Summary Indicator */}\n        <div className=\"mb-6 p-4 rounded-lg bw-panel-deep flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 text-xs font-mono\">\n          <div className=\"flex items-center gap-2 text-zinc-300\">\n            <span className=\"w-2 h-2 rounded-full bg-white\" />\n            <span className=\"uppercase font-semibold\">\n              {activeDay === 1 ? \'Day 1: Swiss 5-Round Battle & Round of 32 Qualification\' : \'Day 2: Knockouts, Quarter/Semi Finals, and Grand Championship\'}\n            </span>\n          </div>\n          <span className=\"text-zinc-400\">\n            {filteredSchedule.length} session{filteredSchedule.length !== 1 ? \'s\' : \'\'} shown\n          </span>\n        </div>\n\n        {/* Timeline Grid */}\n        <AnimatePresence mode=\"wait\">\n          <motion.div\n            key={`day-${activeDay}-${selectedCategory}-${searchQuery}`}\n            initial={{ opacity: 0, y: 10 }}\n            animate={{ opacity: 1, y: 0 }}\n            exit={{ opacity: 0, y: -10 }}\n            transition={{ duration: 0.2 }}\n            className=\"space-y-2.5\"\n          >\n            {filteredSchedule.length === 0 ? (\n              <div className=\"text-center py-16 rounded-xl bw-panel-deep\">\n                <Calendar className=\"w-8 h-8 text-zinc-600 mx-auto mb-2\" />\n                <p className=\"text-zinc-400 font-mono text-xs\">No sessions matching this criteria.</p>\n                <button\n                  onClick={() => {\n                    setSelectedCategory(\'all\');\n                    setSearchQuery(\'\');\n                  }}\n                  className=\"mt-3 px-4 py-2 rounded bg-white text-black font-mono text-xs font-bold\"\n                >\n                  Reset Filters\n                </button>\n              </div>\n            ) : (\n              filteredSchedule.map((item, index) => {\n                const isSaved = savedReminders[item.id];\n\n                return (\n                  <motion.div\n                    key={item.id}\n                    initial={{ opacity: 0, x: -5 }}\n                    animate={{ opacity: 1, x: 0 }}\n                    transition={{ duration: 0.15, delay: index * 0.015 }}\n                    className=\"p-4 rounded-lg bw-card bw-card-hover flex flex-col md:flex-row items-start md:items-center justify-between gap-4\"\n                  >\n                    {/* Left: Time & Badge */}\n                    <div className=\"flex items-center gap-3 min-w-[200px]\">\n                      <div className=\"w-9 h-9 rounded bg-zinc-900 border border-zinc-800 flex items-center justify-center text-white shrink-0 font-mono text-xs\">\n                        <Clock className=\"w-4 h-4 text-zinc-400\" />\n                      </div>\n\n                      <div>\n                        <div className=\"font-mono text-white font-bold text-sm\">\n                          {item.time}\n                        </div>\n                        <span className=\"inline-block mt-0.5 px-2 py-0.5 rounded text-[10px] font-mono uppercase bg-zinc-900 border border-zinc-800 text-zinc-400 font-semibold\">\n                          {item.category}\n                        </span>\n                      </div>\n                    </div>\n\n                    {/* Center: Activity Name & Description */}\n                    <div className=\"flex-1\">\n                      <h4 className=\"font-bold text-sm text-white uppercase tracking-wider font-mono\">\n                        {item.activity}\n                      </h4>\n                      {item.description && (\n                        <p className=\"text-xs text-zinc-400 mt-0.5 font-mono leading-relaxed\">\n                          {item.description}\n                        </p>\n                      )}\n                    </div>\n\n                    {/* Right: Quick Action */}\n                    <div className=\"flex items-center gap-2 shrink-0 self-end md:self-center\">\n                      <button\n                        onClick={() => toggleReminder(item.id)}\n                        className={`px-3 py-1.5 rounded text-xs font-mono font-semibold transition-colors flex items-center gap-1.5 ${\n                          isSaved\n                            ? \'bg-white text-black font-bold\'\n                            : \'bg-zinc-900 border border-zinc-800 text-zinc-400 hover:text-white hover:border-zinc-700\'\n                        }`}\n                        title={isSaved ? \'Reminder set\' : \'Save reminder\'}\n                      >\n                        {isSaved ? <Check className=\"w-3.5 h-3.5\" /> : <Activity className=\"w-3.5 h-3.5\" />}\n                        <span>{isSaved ? \'Saved\' : \'Pin\'}</span>\n                      </button>\n                    </div>\n                  </motion.div>\n                );\n              })\n            )}\n          </motion.div>\n        </AnimatePresence>\n\n      </div>\n    </section>\n  );\n};"
    }
    instruction: "Apply Shadowed Black and White styling to InteractiveSchedule"
  }
}
