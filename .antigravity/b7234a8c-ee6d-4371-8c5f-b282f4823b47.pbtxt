        }
        lines {
          text: "                <div className=\"pt-2 border-t border-zinc-800 flex items-center justify-between text-[10px] text-zinc-500\">"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                  <span>Day 1 Check-in: 09:00 AM</span>"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
