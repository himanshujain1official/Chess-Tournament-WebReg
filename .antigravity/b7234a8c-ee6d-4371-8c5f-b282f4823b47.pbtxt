    instruction: "Apply Shadowed Black and White styling to AwardsGallery"
    replacement_infos {
      original_chunk {
        target_content: "import React, { useState } from \'react\';\nimport { motion } from \'motion/react\';\nimport { \n  Trophy, \n  Crown, \n  Shield, \n  Zap, \n  Crosshair, \n  Timer, \n  Sparkles, \n  TrendingUp, \n  Heart,\n  Award,\n  Star\n} from \'lucide-react\';\nimport { AWARDS_LIST } from \'../data/tournamentData\';\nimport { KingIcon, QueenIcon, KnightIcon, BishopIcon } from \'./ChessGraphics\';\n\nexport const AwardsGallery: React.FC = () => {\n  const [selectedAward, setSelectedAward] = useState<string | null>(null);\n\n  const iconComponents: Record<string, React.ReactNode> = {\n    Crown: <Crown className=\"w-8 h-8 text-amber-400\" />,\n    Shield: <Shield className=\"w-8 h-8 text-violet-400\" />,\n    Zap: <Zap className=\"w-8 h-8 text-cyan-400\" />,\n    Crosshair: <Crosshair className=\"w-8 h-8 text-violet-400\" />,\n    Timer: <Timer className=\"w-8 h-8 text-amber-400\" />,\n    Sparkles: <Sparkles className=\"w-8 h-8 text-cyan-400\" />,\n    TrendingUp: <TrendingUp className=\"w-8 h-8 text-emerald-400\" />,\n    Heart: <Heart className=\"w-8 h-8 text-pink-400\" />\n  };\n\n  return (\n    <section id=\"awards\" className=\"py-20 relative overflow-hidden\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10\">\n        \n        {/* Section Header */}\n        <div className=\"flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-10 pb-4 border-b border-white/10\">\n          <div>\n            <div className=\"inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-950/60 border border-amber-500/40 text-amber-300 text-xs font-mono uppercase tracking-widest mb-2 font-semibold\">\n              <Trophy className=\"w-3.5 h-3.5 text-amber-400\" />\n              Hall of Glory & Recognition\n            </div>\n            <h2 className=\"text-3xl sm:text-5xl font-display font-extrabold text-white tracking-wide uppercase\">\n              AWARDS & <span className=\"text-gradient-violet\">RECOGNITION</span>\n            </h2>\n          </div>\n\n          <div className=\"flex items-center gap-3\">\n            <span className=\"text-xs font-mono tracking-widest text-slate-400 uppercase\">Honors & Titles</span>\n            <span className=\"px-2.5 py-1 rounded bg-violet-900/60 border border-violet-500/40 text-violet-300 font-mono font-bold text-sm\">\n              06 / 06\n            </span>\n          </div>\n        </div>\n\n        {/* Top Tier: Champion & Runner-Up Spotlight */}\n        <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-6 mb-8\">\n          \n          {/* Champion Crown Card (Flyer: \"CHAMPION - Take the crown!\") */}\n          <motion.div\n            initial={{ opacity: 0, scale: 0.95 }}\n            whileInView={{ opacity: 1, scale: 1 }}\n            viewport={{ once: true }}\n            transition={{ duration: 0.5 }}\n            whileHover={{ y: -6 }}\n            className=\"lg:col-span-7 rounded-2xl p-6 sm:p-8 glass glow-gold border-amber-500/40 border-l-4 border-l-amber-500 relative overflow-hidden group\"\n          >\n            <div className=\"flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-6\">\n              <div className=\"flex items-center gap-3\">\n                <div className=\"w-14 h-14 rounded-xl bg-amber-500/20 border border-amber-400/50 flex items-center justify-center shadow-lg shadow-amber-500/30 group-hover:scale-105 transition-transform\">\n                  <KingIcon className=\"w-9 h-9 text-amber-400\" glow />\n                </div>\n                <div>\n                  <span className=\"px-2.5 py-0.5 rounded bg-amber-400 text-slate-950 text-[10px] font-mono font-black uppercase tracking-wider\">\n                    Grand Champion\n                  </span>\n                  <h3 className=\"text-2xl sm:text-3xl font-display font-black text-white uppercase tracking-wide mt-1 group-hover:text-amber-300 transition-colors\">\n                    CHAMPION\n                  </h3>\n                </div>\n              </div>\n\n              <div className=\"px-3 py-1.5 rounded-xl bg-amber-950/80 border border-amber-400/40 font-mono text-amber-300 font-bold text-xs uppercase tracking-wider\">\n                Take the crown! \360\237\221\221\n              </div>\n            </div>\n\n            <p className=\"text-slate-200 text-sm sm:text-base mb-6 leading-relaxed\">\n              Awarded to the ultimate chess master who conquers 5 Swiss rounds and every single knockout elimination match to lift the undisputed Chess eSports Championship Trophy.\n            </p>\n\n            <div className=\"grid grid-cols-2 sm:grid-cols-3 gap-3 pt-4 border-t border-amber-500/30 font-mono text-xs text-amber-200\">\n              <div className=\"p-2.5 rounded-lg bg-black/40 border border-amber-500/20\">\n                <span className=\"text-slate-400 block text-[10px]\">Trophy</span>\n                <span className=\"font-bold text-white\">Grand Cup</span>\n              </div>\n              <div className=\"p-2.5 rounded-lg bg-black/40 border border-amber-500/20\">\n                <span className=\"text-slate-400 block text-[10px]\">Title</span>\n                <span className=\"font-bold text-amber-400\">eSports King</span>\n              </div>\n              <div className=\"p-2.5 rounded-lg bg-black/40 border border-amber-500/20 col-span-2 sm:col-span-1\">\n                <span className=\"text-slate-400 block text-[10px]\">Recognition</span>\n                <span className=\"font-bold text-emerald-400\">Immortal Roster</span>\n              </div>\n            </div>\n          </motion.div>\n\n          {/* Runner-Up Card (Flyer: \"RUNNER-UP - The valiant contender.\") */}\n          <motion.div\n            initial={{ opacity: 0, scale: 0.95 }}\n            whileInView={{ opacity: 1, scale: 1 }}\n            viewport={{ once: true }}\n            transition={{ duration: 0.5, delay: 0.1 }}\n            whileHover={{ y: -6 }}\n            className=\"lg:col-span-5 rounded-2xl p-6 sm:p-8 glass glow-violet border-violet-500/40 border-l-4 border-l-violet-500 relative overflow-hidden group flex flex-col justify-between\"\n          >\n            <div>\n              <div className=\"flex items-center justify-between gap-4 mb-6\">\n                <div className=\"flex items-center gap-3\">\n                  <div className=\"w-14 h-14 rounded-xl bg-violet-900/40 border border-violet-500/40 flex items-center justify-center text-violet-300 shadow-md\">\n                    <Shield className=\"w-7 h-7\" />\n                  </div>\n                  <div>\n                    <span className=\"px-2 py-0.5 rounded bg-violet-900/80 border border-violet-500/40 text-violet-300 text-[10px] font-mono font-bold uppercase tracking-wider\">\n                      Vice-Champion\n                    </span>\n                    <h3 className=\"text-2xl font-display font-black text-white uppercase tracking-wide mt-0.5 group-hover:text-violet-300 transition-colors\">\n                      RUNNER-UP\n                    </h3>\n                  </div>\n                </div>\n\n                <span className=\"px-2.5 py-1 rounded-lg bg-violet-950/80 border border-violet-500/30 text-xs font-mono text-violet-300\">\n                  Valiant Contender\n                </span>\n              </div>\n\n              <p className=\"text-slate-300 text-xs sm:text-sm leading-relaxed mb-6\">\n                Honoring the grand finalist who battled through 100 contenders to the ultimate deciding board.\n              </p>\n            </div>\n\n            <div className=\"grid grid-cols-2 gap-3 pt-4 border-t border-violet-500/30 font-mono text-xs text-violet-200\">\n              <div className=\"p-2.5 rounded-lg bg-black/40 border border-violet-500/20\">\n                <span className=\"text-slate-400 block text-[10px]\">Reward</span>\n                <span className=\"font-bold text-white\">Silver Cup</span>\n              </div>\n              <div className=\"p-2.5 rounded-lg bg-black/40 border border-violet-500/20\">\n                <span className=\"text-slate-400 block text-[10px]\">Medal</span>\n                <span className=\"font-bold text-violet-300\">Valiant Shield</span>\n              </div>\n            </div>\n          </motion.div>\n\n        </div>\n\n        {/* 6 Specialty Awards Grid from Flyer */}\n        <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6\">\n          {AWARDS_LIST.slice(2).map((award, index) => {\n            const borders = [\n              \'border-l-4 border-l-cyan-500\',\n              \'border-l-4 border-l-violet-500\',\n              \'border-l-4 border-l-amber-500\',\n              \'border-l-4 border-l-emerald-500\',\n              \'border-l-4 border-l-purple-500\',\n              \'border-l-4 border-l-pink-500\'\n            ];\n\n            return (\n              <motion.div\n                key={award.id}\n                initial={{ opacity: 0, y: 20 }}\n                whileInView={{ opacity: 1, y: 0 }}\n                viewport={{ once: true }}\n                transition={{ duration: 0.4, delay: index * 0.08 }}\n                whileHover={{ y: -5 }}\n                className={`p-6 rounded-2xl glass ${borders[index % 6]} hover:glow-violet transition-all duration-300 flex flex-col justify-between group shadow-xl`}\n              >\n                <div>\n                  <div className=\"flex items-center justify-between mb-4\">\n                    <div className=\"w-12 h-12 rounded-xl bg-white/5 border border-white/10 group-hover:border-violet-500/40 flex items-center justify-center transition-colors\">\n                      {iconComponents[award.icon] || <Award className=\"w-6 h-6 text-violet-400\" />}\n                    </div>\n                    <span className=\"text-[11px] font-mono font-semibold text-amber-400 bg-amber-950/40 border border-amber-500/30 px-2 py-0.5 rounded\">\n                      {award.rewardHighlight}\n                    </span>\n                  </div>\n\n                  <span className=\"text-xs font-mono uppercase tracking-wider text-slate-400 font-semibold block mb-1\">\n                    {award.subtitle}\n                  </span>\n\n                  <h4 className=\"text-lg font-display font-bold text-white uppercase tracking-wide group-hover:text-amber-300 transition-colors mb-2\">\n                    {award.title}\n                  </h4>\n\n                  <p className=\"text-xs sm:text-sm text-slate-300 leading-relaxed\">\n                    {award.description}\n                  </p>\n                </div>\n\n                <div className=\"mt-5 pt-3 border-t border-white/5 flex items-center justify-between text-xs font-mono text-slate-400\">\n                  <span className=\"flex items-center gap-1 text-violet-400\">\n                    <Star className=\"w-3.5 h-3.5\" />\n                    <span>Official Trophy Category</span>\n                  </span>\n                </div>\n              </motion.div>\n            );\n          })}\n        </div>\n\n      </div>\n    </section>\n  );\n};"
        replacement_content: "import React from \'react\';\nimport { motion } from \'motion/react\';\nimport { \n  Trophy, \n  Crown, \n  Shield, \n  Zap, \n  Crosshair, \n  Timer, \n  Sparkles, \n  TrendingUp, \n  Heart,\n  Award,\n  Star\n} from \'lucide-react\';\nimport { AWARDS_LIST } from \'../data/tournamentData\';\nimport { KingIcon } from \'./ChessGraphics\';\n\nexport const AwardsGallery: React.FC = () => {\n  const iconComponents: Record<string, React.ReactNode> = {\n    Crown: <Crown className=\"w-5 h-5 text-white\" />,\n    Shield: <Shield className=\"w-5 h-5 text-zinc-300\" />,\n    Zap: <Zap className=\"w-5 h-5 text-zinc-300\" />,\n    Crosshair: <Crosshair className=\"w-5 h-5 text-zinc-300\" />,\n    Timer: <Timer className=\"w-5 h-5 text-zinc-300\" />,\n    Sparkles: <Sparkles className=\"w-5 h-5 text-zinc-300\" />,\n    TrendingUp: <TrendingUp className=\"w-5 h-5 text-zinc-300\" />,\n    Heart: <Heart className=\"w-5 h-5 text-zinc-300\" />\n  };\n\n  return (\n    <section id=\"awards\" className=\"py-24 relative overflow-hidden bg-black\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10\">\n        \n        {/* Section Header */}\n        <div className=\"flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-12 pb-4 border-b border-zinc-800\">\n          <div>\n            <div className=\"text-zinc-400 text-xs font-mono uppercase tracking-widest mb-1\">\n              Hall of Glory & Recognition\n            </div>\n            <h2 className=\"text-3xl sm:text-4xl font-display font-black text-white tracking-wide uppercase\">\n              AWARDS & <span className=\"text-zinc-400 font-light\">RECOGNITION</span>\n            </h2>\n          </div>\n\n          <div className=\"flex items-center gap-3\">\n            <span className=\"text-xs font-mono tracking-widest text-zinc-400 uppercase\">Honors</span>\n            <span className=\"px-2.5 py-1 rounded bg-zinc-900 border border-zinc-800 text-zinc-300 font-mono font-bold text-xs\">\n              STAGE 04\n            </span>\n          </div>\n        </div>\n\n        {/* Top Tier: Champion & Runner-Up Spotlight */}\n        <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-6 mb-8\">\n          \n          {/* Champion Card */}\n          <motion.div\n            initial={{ opacity: 0, y: 10 }}\n            whileInView={{ opacity: 1, y: 0 }}\n            viewport={{ once: true }}\n            transition={{ duration: 0.3 }}\n            className=\"lg:col-span-7 rounded-xl p-6 sm:p-8 bw-card bw-card-hover relative overflow-hidden\"\n          >\n            <div className=\"flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-6\">\n              <div className=\"flex items-center gap-4\">\n                <div className=\"w-14 h-14 rounded-lg bg-white text-black flex items-center justify-center shadow-lg font-mono\">\n                  <KingIcon className=\"w-9 h-9 text-black\" />\n                </div>\n                <div>\n                  <span className=\"px-2 py-0.5 rounded bg-zinc-800 text-zinc-300 text-[10px] font-mono font-bold uppercase tracking-wider\">\n                    Tier 01\n                  </span>\n                  <h3 className=\"text-2xl sm:text-3xl font-display font-black text-white uppercase tracking-wide mt-1\">\n                    CHAMPION\n                  </h3>\n                </div>\n              </div>\n\n              <div className=\"px-3 py-1.5 rounded bg-zinc-900 border border-zinc-800 font-mono text-zinc-300 font-bold text-xs uppercase tracking-wider\">\n                Grand Cup & Title\n              </div>\n            </div>\n\n            <p className=\"text-zinc-300 text-sm font-mono mb-6 leading-relaxed\">\n              Awarded to the tournament victor after surviving 5 Swiss rounds and every single knockout elimination match on the championship board.\n            </p>\n\n            <div className=\"grid grid-cols-2 sm:grid-cols-3 gap-3 pt-4 border-t border-zinc-800 font-mono text-xs\">\n              <div className=\"p-3 rounded bg-zinc-950 border border-zinc-800\">\n                <span className=\"text-zinc-500 block text-[10px] uppercase\">Trophy</span>\n                <span className=\"font-bold text-white\">Grand Cup</span>\n              </div>\n              <div className=\"p-3 rounded bg-zinc-950 border border-zinc-800\">\n                <span className=\"text-zinc-500 block text-[10px] uppercase\">Title</span>\n                <span className=\"font-bold text-white\">eSports Champion</span>\n              </div>\n              <div className=\"p-3 rounded bg-zinc-950 border border-zinc-800 col-span-2 sm:col-span-1\">\n                <span className=\"text-zinc-500 block text-[10px] uppercase\">Recognition</span>\n                <span className=\"font-bold text-zinc-300\">Permanent Roster</span>\n              </div>\n            </div>\n          </motion.div>\n\n          {/* Runner-Up Card */}\n          <motion.div\n            initial={{ opacity: 0, y: 10 }}\n            whileInView={{ opacity: 1, y: 0 }}\n            viewport={{ once: true }}\n            transition={{ duration: 0.3, delay: 0.1 }}\n            className=\"lg:col-span-5 rounded-xl p-6 sm:p-8 bw-card bw-card-hover relative overflow-hidden flex flex-col justify-between\"\n          >\n            <div>\n              <div className=\"flex items-center justify-between gap-4 mb-6\">\n                <div className=\"flex items-center gap-3\">\n                  <div className=\"w-12 h-12 rounded-lg bg-zinc-900 border border-zinc-800 flex items-center justify-center text-white\">\n                    <Shield className=\"w-6 h-6\" />\n                  </div>\n                  <div>\n                    <span className=\"px-2 py-0.5 rounded bg-zinc-800 text-zinc-300 text-[10px] font-mono font-bold uppercase tracking-wider\">\n                      Tier 02\n                    </span>\n                    <h3 className=\"text-2xl font-display font-black text-white uppercase tracking-wide mt-0.5\">\n                      RUNNER-UP\n                    </h3>\n                  </div>\n                </div>\n\n                <span className=\"px-2.5 py-1 rounded bg-zinc-900 border border-zinc-800 text-xs font-mono text-zinc-400\">\n                  Finalist\n                </span>\n              </div>\n\n              <p className=\"text-zinc-400 text-xs sm:text-sm font-mono leading-relaxed mb-6\">\n                Honoring the grand finalist who battled through 100 contenders to the ultimate deciding match.\n              </p>\n            </div>\n\n            <div className=\"grid grid-cols-2 gap-3 pt-4 border-t border-zinc-800 font-mono text-xs\">\n              <div className=\"p-3 rounded bg-zinc-950 border border-zinc-800\">\n                <span className=\"text-zinc-500 block text-[10px] uppercase\">Trophy</span>\n                <span className=\"font-bold text-white\">Silver Cup</span>\n              </div>\n              <div className=\"p-3 rounded bg-zinc-950 border border-zinc-800\">\n                <span className=\"text-zinc-500 block text-[10px] uppercase\">Title</span>\n                <span className=\"font-bold text-zinc-300\">Vice-Champion</span>\n              </div>\n            </div>\n          </motion.div>\n\n        </div>\n\n        {/* Specialty Awards Grid */}\n        <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6\">\n          {AWARDS_LIST.slice(2).map((award, index) => (\n            <motion.div\n              key={award.id}\n              initial={{ opacity: 0, y: 10 }}\n              whileInView={{ opacity: 1, y: 0 }}\n              viewport={{ once: true }}\n              transition={{ duration: 0.25, delay: index * 0.05 }}\n              className=\"p-6 rounded-xl bw-card bw-card-hover flex flex-col justify-between group\"\n            >\n              <div>\n                <div className=\"f