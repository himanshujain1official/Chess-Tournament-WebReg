    replacement_chunks {
      target_content: "import React, { useState, useEffect } from \'react\';\nimport { motion } from \'motion/react\';\nimport { \n  Tv, \n  Mic, \n  Users, \n  BarChart3, \n  Radio, \n  Volume2, \n  Maximize2, \n  Play, \n  Eye, \n  Flame, \n  Sparkles,\n  MessageSquare\n} from \'lucide-react\';\nimport { ESPORTS_HIGHLIGHTS } from \'../data/tournamentData\';\nimport { KingIcon, QueenIcon } from \'./ChessGraphics\';\n\nexport const ESportsArenaSection: React.FC = () => {\n  const [activeTab, setActiveTab] = useState<\'board1\' | \'board2\'>(\'board1\');\n  const [commentaryLine, setCommentaryLine] = useState(0);\n\n  const commentaryFeed = [\n    { caster: \"GM Alex Vance\", time: \"14:22\", text: \"Look at that Knight sacrifice on e5! Absolute tactical audacity in Round 4!\", tag: \"Brilliant !!\" },\n    { caster: \"IM Sarah Chen\", time: \"14:23\", text: \"Black has only 35 seconds on the clock. The King is forced out into the open!\", tag: \"Time Trouble\" },\n    { caster: \"GM Alex Vance\", time: \"14:24\", text: \"Rook to d8 with check! The arena crowd is on their feet!\", tag: \"Decisive Move\" },\n    { caster: \"Host Desk\", time: \"14:25\", text: \"Audience poll: 78% predicted Qxh7#. Let\'s see if the engine confirms mate in 3!\", tag: \"Crowd Poll\" }\n  ];\n\n  useEffect(() => {\n    const timer = setInterval(() => {\n      setCommentaryLine(prev => (prev + 1) % commentaryFeed.length);\n    }, 4000);\n    return () => clearInterval(timer);\n  }, [commentaryFeed.length]);\n\n  return (\n    <section id=\"arena\" className=\"py-20 relative overflow-hidden\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10\">\n        \n        {/* Section Header */}\n        <div className=\"flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-10 pb-4 border-b border-white/10\">\n          <div>\n            <div className=\"inline-flex items-center gap-2 px-3 py-1 rounded-full bg-violet-950/80 border border-violet-500/40 text-violet-300 text-xs font-mono uppercase tracking-widest mb-2 font-semibold\">\n              <Radio className=\"w-3.5 h-3.5 text-rose-400 animate-pulse\" />\n              Arena Production & Broadcast\n            </div>\n            <h2 className=\"text-3xl sm:text-5xl font-display font-extrabold text-white tracking-wide uppercase\">\n              eSPORTS <span className=\"text-gradient-violet\">EXPERIENCE</span>\n            </h2>\n          </div>\n\n          <div className=\"flex items-center gap-3\">\n            <span className=\"text-xs font-mono tracking-widest text-slate-400 uppercase\">Broadcast Specs</span>\n            <span className=\"px-2.5 py-1 rounded bg-violet-900/60 border border-violet-500/40 text-violet-300 font-mono font-bold text-sm\">\n              05 / 06\n            </span>\n          </div>\n        </div>\n\n        {/* Live Broadcast Arena Preview Mockup */}\n        <div className=\"rounded-2xl p-4 sm:p-6 glass glow-violet border-white/10 mb-10 shadow-2xl relative\">\n          \n          {/* Top Broadcast Bar */}\n          <div className=\"flex items-center justify-between px-3 py-2 mb-4 bg-black/40 rounded-xl border border-white/5\">\n            <div className=\"flex items-center gap-3\">\n              <span className=\"flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-rose-600 text-white font-mono text-xs font-black uppercase tracking-wider animate-pulse\">\n                <Radio className=\"w-3.5 h-3.5\" />\n                LIVE ARENA STREAM\n              </span>\n              <span className=\"hidden sm:inline-block text-xs font-mono text-slate-400\">\n                Board 1: Grand Final Spotlight \342\200\242 Best of 5\n              </span>\n            </div>\n\n            <div className=\"flex items-center gap-2\">\n              <div className=\"flex items-center gap-1 text-xs font-mono text-amber-300 px-2.5 py-1 rounded bg-amber-950/40 border border-amber-500/30\">\n                <Eye className=\"w-3.5 h-3.5 text-amber-400\" />\n                <span>1,420 Spectators</span>\n              </div>\n            </div>\n          </div>\n\n          {/* Broadcast Stage Layout */}\n          <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-6 items-center\">\n            \n            {/* Visual Chess Stream Arena View */}\n            <div className=\"lg:col-span-8 bg-black/50 rounded-2xl p-4 sm:p-6 border border-white/10 relative overflow-hidden\">\n              \n              {/* Player 2 Header (Black) */}\n              <div className=\"flex items-center justify-between p-3 rounded-xl bg-white/5 border border-white/5 mb-4\">\n                <div className=\"flex items-center gap-3\">\n                  <div className=\"w-9 h-9 rounded-lg bg-black/40 border border-white/10 flex items-center justify-center font-bold text-white text-sm font-mono\">\n                    VK\n                  </div>\n                  <div>\n                    <span className=\"font-bold text-white text-sm sm:text-base\">Vikram &apos;Tactician&apos; K.</span>\n                    <span className=\"block text-[11px] font-mono text-slate-400\">Rating: 2140 \342\200\242 IIT Delhi</span>\n                  </div>\n                </div>\n\n                <div className=\"font-mono text-lg font-black text-rose-400 bg-black/40 px-3 py-1 rounded-lg border border-white/5\">\n                  01:42\n                </div>\n              </div>\n\n              {/* Center Chessboard Visual Simulation */}\n              <div className=\"aspect-video w-full rounded-xl bg-gradient-to-br from-black/60 via-violet-950/40 to-black/60 border border-white/10 flex flex-col items-center justify-center relative p-4\">\n                \n                {/* Simulated Eval Bar on Left */}\n                <div className=\"absolute left-3 top-4 bottom-4 w-3 bg-black/60 rounded-full overflow-hidden border border-white/10 hidden sm:flex flex-col justify-end\">\n                  <div className=\"w-full bg-gradient-to-t from-violet-400 to-amber-300 h-[68%]\" />\n                </div>\n\n                {/* Animated Chess Clash Graphic */}\n                <div className=\"relative flex items-center justify-center gap-6 sm:gap-12\">\n                  <motion.div\n                    animate={{ scale: [1, 1.06, 1], y: [0, -4, 0] }}\n                    transition={{ duration: 3, repeat: Infinity }}\n                    className=\"p-4 rounded-2xl bg-amber-500/10 border border-amber-400/40 text-amber-400 shadow-lg glow-gold\"\n                  >\n                    <KingIcon className=\"w-12 h-12 sm:w-16 sm:h-16\" glow />\n                    <span className=\"block text-center font-mono text-[11px] font-bold text-amber-300 mt-1\">WHITE</span>\n                  </motion.div>\n\n                  <div className=\"flex flex-col items-center\">\n                    <span className=\"font-display font-black text-xl sm:text-3xl text-amber-400 tracking-wider\">VS</span>\n                    <span className=\"text-[10px] font-mono text-slate-400 uppercase tracking-widest mt-1\">GAME 3</span>\n                  </div>\n\n                  <motion.div\n                    animate={{ scale: [1, 1.06, 1], y: [0, 4, 0] }}\n                    transition={{ duration: 3, repeat: Infinity, delay: 0.5 }}\n                    className=\"p-4 rounded-2xl bg-violet-500/10 border border-violet-400/40 text-violet-400 shadow-lg glow-violet\"\n                  >\n                    <QueenIcon className=\"w-12 h-12 sm:w-16 sm:h-16\" glow />\n                    <span className=\"block text-center font-mono text-[11px] font-bold text-violet-300 mt-1\">BLACK</span>\n                  </motion.div>\n                </div>\n\n                {/* Bottom Overlay: Move Notation */}\n                <div className=\"absolute bottom-3 left-8 right-8 flex items-center justify-between px-4 py-1.5 rounded-lg bg-black/80 border border-white/10 text-xs font-mono\">\n                  <span className=\"text-violet-300\">Move 34: <strong>Nf6+ (Check!)</strong></span>\n                  <span className=\"text-emerald-400 font-bold\">Eval: +3.2 (Decisive Attack)</span>\n                </div>\n              </div>\n\n              {/* Player 1 Footer (White) */}\n              <div className=\"flex items-center justify-between p-3 rounded-xl bg-white/5 border border-white/5 mt-4\">\n                <div className=\"flex items-center gap-3\">\n                  <div className=\"w-9 h-9 rounded-lg bg-amber-500/20 border border-amber-400/40 flex items-center justify-center font-bold text-amber-300 text-sm font-mono\">\n                    AR\n                  </div>\n                  <div>\n                    <span className=\"font-bold text-white text-sm sm:text-base\">Aarav &apos;Grandmaster&apos; R.</span>\n                    <span className=\"block text-[11px] font-mono text-slate-400\">Rating: 2210 \342\200\242 BITS Pilani</span>\n                  </div>\n                </div>\n\n                <div className=\"font-mono text-lg font-black text-amber-400 bg-black/40 px-3 py-1 rounded-lg border border-white/5\">\n                  03:15\n                </div>\n              </div>\n            </div>\n\n            {/* Right: Live Caster Desk & Audience Prediction Feed */}\n            <div className=\"lg:col-span-4 flex flex-col justify-between h-full space-y-4\">\n              \n              {/* Caster Voice Panel */}\n              <div className=\"p-4 rounded-xl bg-black/40 border border-white/10\">\n                <div className=\"flex items-center justify-between mb-3 pb-2 border-b border-white/10\">\n                  <div className=\"flex items-center gap-2 text-violet-400 font-bold text-sm uppercase\">\n                    <Mic className=\"w-4 h-4 text-amber-400\" />\n                    <span>Caster Desk Commentary</span>\n                  </div>\n                  <span className=\"w-2 h-2 rounded-full bg-emerald-400 animate-ping\" />\n                </div>\n\n                <div className=\"space-y-2.5\">\n                  {commentaryFeed.map((item, idx) => (\n                    <motion.div\n                      key={idx}\n                      initial={{ opacity: 0, y: 5 }}\n                      animate={{ opacity: 1, y: 0 }}\n                      className={`p-2.5 rounded-lg border text-xs transition-all ${\n                        idx === commentaryLine\n                          ? \'bg-violet-950/60 border-violet-400 shadow-md\'\n                          : \'bg-white/5 border-white/5\'\n                      }`}\n                    >\n                      <div className=\"flex items-center justify-between text-[11px] font-mono mb-1\">\n                        <span className=\"text-amber-300 font-bold\">{item.caster}</span>\n                        <span className=\"text-slate-400\">{item.time}</span>\n                      </div>\n                      <p className=\"text-slate-200 leading-relaxed\">{item.text}</p>\n                    </motion.div>\n                  ))}\n                </div>\n              </div>\n\n              {/* Interactive Move Prediction Widget */}\n              <div className=\"p-4 rounded-xl bg-black/40 border border-amber-500/30\">\n                <div className=\"flex items-center justify-between mb-2\">\n                  <span className=\"text-xs font-mono text-amber-400 font-bold uppercase flex items-center gap-1.5\">\n                    <Sparkles className=\"w-3.5 h-3.5\" />\n                    Audience Move Poll\n                  </span>\n                  <span className=\"text-[10px] font-mono text-slate-400\">Live</span>\n                </div>\n                <div className=\"text-xs text-slate-300 font-semibold mb-2\">\n                  Will Aarav find the Queen Sacrifice on move 35?\n                </div>\n                <div className=\"space-y-1.5\">\n                  <div className=\"flex items-center justify-between text-xs font-mono\">\n                    <span className=\"text-emerald-400\">YES (82%)</span>\n                    <span className=\"text-rose-400\">NO (18%)</span>\n                  </div>\n                  <div className=\"w-full h-2 rounded-full bg-white/10 overflow-hidden flex\">\n                    <div className=\"bg-emerald-500 h-full w-[82%]\" />\n                    <div className=\"bg-rose-500 h-full w-[18%]\" />\n                  </div>\n                </div>\n              </div>\n\n            </div>\n\n          </div>\n        </div>\n\n        {/* 4 Feature Columns from Flyer */}\n        <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6\">\n          {ESPORTS_HIGHLIGHTS.map((item, idx) => {\n            const borders = [\n              \'border-l-4 border-l-violet-500\',\n              \'border-l-4 border-l-amber-500\',\n              \'border-l-4 border-l-cyan-500\',\n              \'border-l-4 border-l-pink-500\'\n            ];\n\n            return (\n              <motion.div\n                key={item.id}\n                initial={{ opacity: 0, y: 20 }}\n                whileInView={{ opacity: 1, y: 0 }}\n                viewport={{ once: true }}\n                transition={{ duration: 0.4, delay: idx * 0.1 }}\n                className={`p-6 rounded-2xl glass ${borders[idx % 4]} hover:glow-violet transition-all duration-300 flex flex-col justify-between group`}\n              >\n                <div>\n                  <div className=\"w-12 h-12 rounded-xl bg-white/5 border border-white/10 group-hover:border-violet-500/40 flex items-center justify-center text-violet-300 mb-4 transition-colors\">\n                    {item.id === \'live_boards\' && <Tv className=\"w-6 h-6 text-violet-400\" />}\n                    {item.id === \'live_commentary\' && <Mic className=\"w-6 h-6 text-amber-400\" />}\n                    {item.id === \'audience_engagement\' && <Users className=\"w-6 h-6 text-cyan-400\" />}\n                    {item.id === \'esports_feel\' && <BarChart3 className=\"w-6 h-6 text-pink-400\" />}\n                  </div>\n\n                  <span className=\"text-xs font-mono uppercase tracking-wider text-violet-400 font-semibold block mb-1\">\n                    {item.subtitle}\n                  </span>\n\n                  <h3 className=\"text-xl font-display font-bold text-white uppercase tracking-wide group-hover:text-amber-300 transition-colors mb-2\">\n                    {item.title}\n                  </h3>\n\n                  <p className=\"text-xs sm:text-sm text-slate-300 leading-relaxed\">\n                    {item.description}\n                  </p>\n                </div>\n\n                <div className=\"mt-5 pt-3 border-t border-white/5 text-[11px] font-mono text-slate-400 flex items-center justify-between\">\n                  <span>Production Standard</span>\n                  <span className=\"text-emerald-400 font-bold\">HD 1080p60</span>\n                </div>\n              </motion.div>\n            );\n          })}\n        </div>\n\n      </div>\n    </section>\n  );\n};"
      replacement_content: "import React from \'react\';\nimport { motion } from \'motion/react\';\nimport { \n  Tv, \n  Mic, \n  Users, \n  BarChart3, \n  Radio\n} from \'lucide-react\';\nimport { ESPORTS_HIGHLIGHTS } from \'../data/tournamentData\';\nimport { KingIcon, QueenIcon } from \'./ChessGraphics\';\n\nexport const ESportsArenaSection: React.FC = () => {\n  return (\n    <section id=\"arena\" className=\"py-24 relative overflow-hidden bg-black\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10\">\n        \n        {/* Section Header */}\n        <div className=\"flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-12 pb-4 border-b border-zinc-800\">\n          <div>\n            <div className=\"text-zinc-400 text-xs font-mono uppercase tracking-widest mb-1\">\n              Arena Production & Setup\n            </div>\n            <h2 className=\"text-3xl sm:text-4xl font-display font-black text-white tracking-wide uppercase\">\n              eSPORTS <span className=\"text-zinc-400 font-light\">EXPERIENCE</span>\n            </h2>\n          </div>\n\n          <div className=\"flex items-center gap-3\">\n            <span className=\"text-xs font-mono tracking-widest text-zinc-400 uppercase\">Arena Standards</span>\n            <span className=\"px-2.5 py-1 rounded bg-zinc-900 border border-zinc-800 text-zinc-300 font-mono font-bold text-xs\">\n              STAGE 05\n            </span>\n          </div>\n        </div>\n\n        {/* Live Broadcast Arena Telemetry Layout */}\n        <div className=\"rounded-xl p-6 bw-panel-deep mb-10\">\n          \n          {/* Top Broadcast Bar */}\n          <div className=\"flex items-center justify-between px-3 py-2 mb-6 bg-zinc-950 rounded-lg border border-zinc-800\">\n            <div className=\"flex items-center gap-3\">\n              <span className=\"flex items-center gap-1.5 px-2.5 py-1 rounded bg-white text-black font-mono text-xs font-bold uppercase tracking-wider\">\n                <Radio className=\"w-3.5 h-3.5\" />\n                CENTER BOARD BROADCAST\n              </span>\n              <span className=\"hidden sm:inline-block text-xs font-mono text-zinc-400\">\n                Championship Stage \342\200\242 DGT Sensor Live Relays\n              </span>\n            </div>\n\n            <div className=\"text-xs font-mono text-zinc-400 px-2.5 py-1 rounded bg-zinc-900 border border-zinc-800\">\n              Live Engine Feed: 60 FPS\n            </div>\n          </div>\n\n          {/* Broadcast Stage Layout */}\n          <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-6 items-center\">\n            \n            {/* Visual Chess Arena View */}\n            <div className=\"lg:col-span-8 bg-zinc-950 rounded-xl p-6 border border-zinc-800\">\n              \n              {/* Player 2 Header */}\n              <div className=\"flex items-center justify-between p-3 rounded-lg bg-zinc-900 border border-zinc-800 mb-4 font-mono\">\n                <div className=\"flex items-center gap-3\">\n                  <div className=\"w-8 h-8 rounded bg-black border border-zinc-800 flex items-center justify-center font-bold text-white text-xs\">\n                    02\n                  </div>\n                  <div>\n                    <span className=\"font-bold text-white text-sm\">BLACK POSITION</span>\n                    <span className=\"block text-[10px] text-zinc-500\">Official Tournament Board</span>\n                  </div>\n                </div>\n\n                <div className=\"text-sm font-bold text-white bg-black px-2.5 py-1 rounded border border-zinc-800\">\n                  10:00 + 5s\n                </div>\n              </div>\n\n              {/* Center Arena Visualization */}\n              <div className=\"aspect-video w-full rounded-lg bg-black border border-zinc-800 flex flex-col items-center justify-center relative p-4\">\n                \n                {/* Visual Chess Piece Duo */}\n                <div className=\"flex items-center justify-center gap-8 sm:gap-16\">\n                  <div className=\"p-4 rounded-xl bg-zinc-900 border border-zinc-800 text-white flex flex-col items-center\">\n                    <KingIcon className=\"w-12 h-12\" />\n                    <span className=\"font-mono text-[11px] font-bold text-white mt-2 tracking-wider\">WHITE</span>\n                  </div>\n\n                  <div className=\"flex flex-col items-center\">\n                    <span className=\"font-display font-black text-2xl text-white tracking-widest font-mono\">VS</span>\n                    <span className=\"text-[10px] font-mono text-zinc-500 uppercase tracking-widest mt-1\">SWISS MATCH</span>\n                  </div>\n\n                  <div className=\"p-4 rounded-xl bg-zinc-900 border border-zinc-800 text-zinc-400 flex flex-col items-center\">\n                    <QueenIcon className=\"w-12 h-12\" />\n                    <span className=\"font-mono text-[11px] font-bold text-zinc-400 mt-2 tracking-wider\">BLACK</span>\n                  </div>\n                </div>\n\n                {/* Bottom Overlay: Move Notation */}\n                <div className=\"absolute bottom-3 left-4 right-4 flex items-center justify-between px-3 py-1.5 rounded bg-zinc-900/90 border border-zinc-800 text-xs font-mono\">\n                  <span className=\"text-zinc-300\">DGT Smartboard Link: <strong className=\"text-white\">Active</strong></span>\n                  <span className=\"text-zinc-400\">Time Control: 10m + 5s</span>\n                </div>\n              </div>\n\n              {/* Player 1 Footer */}\n              <div className=\"flex items-center justify-between p-3 rounded-lg bg-zinc-900 border border-zinc-800 mt-4 font-mono\">\n                <div className=\"flex items-center gap-3\">\n                  <div className=\"w-8 h-8 rounded bg-white text-black flex items-center justify-center font-bold text-xs\">\n                    01\n                  </div>\n                  <div>\n                    <span className=\"font-bold text-white text-sm\">WHITE POSITION</span>\n                    <span className=\"block text-[10px] text-zinc-500\">Official Tournament Board</span>\n                  </div>\n                </div>\n\n                <div className=\"text-sm font-bold text-white bg-black px-2.5 py-1 rounded border border-zinc-800\">\n                  10:00 + 5s\n                </div>\n              </div>\n            </div>\n\n            {/* Right: Telemetry & Production Specs */}\n            <div className=\"lg:col-span-4 flex flex-col justify-between h-full space-y-4\">\n              \n              {/* Production Console */}\n              <div className=\"p-5 rounded-xl bg-zinc-950 border border-zinc-800 font-mono\">\n                <div className=\"text-xs uppercase font-bold text-white mb-3 pb-2 border-b border-zinc-800 flex items-center justify-between\">\n                  <span>Arena Infrastructure</span>\n                  <span className=\"text-zinc-500\">STATUS: OK</span>\n                </div>\n\n                <div className=\"space-y-3 text-xs\">\n                  <div className=\"flex justify-between items-center py-1 border-b border-zinc-900\">\n                    <span className=\"text-zinc-400\">Projection System</span>\n                    <span className=\"text-white font-bold\">4K Large Displays</span>\n                  </div>\n                  <div className=\"flex justify-between items-center py-1 border-b border-zinc-900\">\n                    <span className=\"text-zinc-400\">Board Sensors</span>\n                    <span className=\"text-white font-bold\">DGT Smart Boards</span>\n                  </div>\n                  <div className=\"flex justify-between items-center py-1 border-b border-zinc-900\">\n                    <span className=\"text-zinc-400\">Audio Desk</span>\n                    <span className=\"text-white font-bold\">Dual Casters</span>\n                  </div>\n                  <div className=\"flex justify-between items-center py-1 border-b border-zinc-900\">\n                    <span className=\"text-zinc-400\">Clocks</span>\n                    <span className=\"text-white font-bold\">Digital FIDE Clocks</span>\n                  </div>\n                </div>\n              </div>\n\n              {/* Live Spec Notice */}\n              <div className=\"p-5 rounded-xl bg-zinc-950 border border-zinc-800 font-mono text-xs\">\n                <div className=\"text-zinc-300 font-bold uppercase mb-1\">\n                  Spectator Seating\n                </div>\n                <p className=\"text-zinc-500 leading-relaxed text-[11px]\">\n                  Audience members can follow top board evaluations, grandmaster commentary, and key tactical moments live in the arena.\n                </p>\n              </div>\n\n            </div>\n\n          </div>\n        </div>\n\n        {/* 4 Feature Columns from Flyer */}\n        <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6\">\n          {ESPORTS_HIGHLIGHTS.map((item, idx) => (\n            <motion.div\n              key={item.id}\n              initial={{ opacity: 0, y: 10 }}\n              whileInView={{ opacity: 1, y: 0 }}\n              viewport={{ once: true }}\n              transition={{ duration: 0.25, delay: idx * 0.05 }}\n              className=\"p-6 rounded-xl bw-card bw-card-hover flex flex-col justify-between\"\n            >\n              <div>\n                <div className=\"w-10 h-10 rounded-lg bg-zinc-900 border border-zinc-800 flex items-center justify-center text-white mb-4\">\n                  {item.id === \'live_boards\' && <Tv className=\"w-5 h-5\" />}\n                  {item.id === \'live_commentary\' && <Mic className=\"w-5 h-5\" />}\n                  {item.id === \'audience_engagement\' && <Users className=\"w-5 h-5\" />}\n                  {item.id === \'esports_feel\' && <BarChart3 className=\"w-5 h-5\" />}\n                </div>\n\n                <span className=\"text-[10px] font-mono uppercase tracking-wider text-zinc-400 font-semibold block mb-1\">\n                  {item.subtitle}\n                </span>\n\n                <h3 className=\"text-base font-display font-bold text-white uppercase tracking-wide mb-2 font-mono\">\n                  {item.title}\n                </h3>\n\n                <p className=\"text-xs text-zinc-400 font-mono leading-relaxed\">\n                  {item.description}\n                </p>\n              </div>\n\n              <div className=\"mt-5 pt-3 border-t border-zinc-800 text-[10px] font-mono text-zinc-500 flex items-center justify-between\">\n                <span>Standard</span>\n                <span className=\"text-white font-bold\">Tournament Level</span>\n              </div>\n            </motion.div>\n          ))}\n        </div>\n\n      </div>\n    </section>\n  );\n};"
