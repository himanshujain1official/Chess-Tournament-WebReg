    instruction: "Apply Immersive UI styling and layout to Hero.tsx"
    replacement_infos {
      original_chunk {
        target_content: "        {/* Main Hero Card */}\n        <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center\">\n          \n          {/* Left Column: Headlines & CTA */}\n          <motion.div\n            initial={{ opacity: 0, x: -30 }}\n            animate={{ opacity: 1, x: 0 }}\n            transition={{ duration: 0.7 }}\n            className=\"lg:col-span-7 text-center lg:text-left\"\n          >\n            {/* Live Status Pill */}\n            <div className=\"inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-violet-900/40 border border-violet-500/40 text-violet-300 text-xs sm:text-sm font-medium mb-6 backdrop-blur-sm\">\n              <span className=\"relative flex h-2.5 w-2.5\">\n                <span className=\"animate-ping absolute inline-flex h-full w-full rounded-full bg-amber-400 opacity-75\"></span>\n                <span className=\"relative inline-flex rounded-full h-2.5 w-2.5 bg-amber-400\"></span>\n              </span>\n              <span>Inter-College Championship Arena</span>\n              <span className=\"text-slate-500\">\342\200\242</span>\n              <span className=\"text-amber-300 font-semibold font-mono\">FIDE Rules</span>\n            </div>\n\n            {/* Main Bold Title */}\n            <h1 className=\"text-4xl sm:text-6xl md:text-7xl font-black font-display tracking-tight text-white leading-none mb-4 uppercase\">\n              CHESS <span className=\"text-transparent bg-clip-text bg-gradient-to-r from-violet-400 via-purple-300 to-indigo-300 text-glow-violet\">eSPORTS</span>\n            </h1>\n\n            {/* Slogan Banner */}\n            <div className=\"inline-block relative mb-6\">\n              <div className=\"px-5 py-2 rounded-xl bg-gradient-to-r from-amber-500/20 via-violet-600/20 to-purple-600/20 border border-amber-400/40 text-amber-300 font-display font-extrabold text-lg sm:text-2xl tracking-widest uppercase shadow-lg shadow-amber-500/10\">\n                COMPETE. THINK. CONQUER.\n              </div>\n            </div>\n\n            <p className=\"text-slate-300 text-base sm:text-lg max-w-2xl mx-auto lg:mx-0 leading-relaxed mb-8\">\n              Step into the premier battle of intellect where tactical mastery meets heart-pounding eSports spectacle. 100 collegiate tacticians clash under stadium lights with live broadcast commentary, digital sensor boards, and an electrifying audience showdown.\n            </p>\n\n            {/* Prominent Flyer Stats Pill */}\n            <div className=\"grid grid-cols-3 gap-3 p-3 rounded-2xl glass-panel-glow border-violet-500/30 mb-8 max-w-xl mx-auto lg:mx-0\">\n              <div className=\"flex flex-col items-center justify-center p-3 rounded-xl bg-slate-900/60 border border-slate-800\">\n                <div className=\"flex items-center gap-1.5 text-amber-400 mb-1\">\n                  <Calendar className=\"w-4 h-4\" />\n                  <span className=\"font-mono text-xl sm:text-2xl font-black text-white\">2</span>\n                </div>\n                <span className=\"text-[11px] sm:text-xs font-mono uppercase tracking-wider text-slate-400 font-semibold\">DAYS</span>\n              </div>\n\n              <div className=\"flex flex-col items-center justify-center p-3 rounded-xl bg-slate-900/60 border border-slate-800\">\n                <div className=\"flex items-center gap-1.5 text-violet-400 mb-1\">\n                  <Users className=\"w-4 h-4\" />\n                  <span className=\"font-mono text-xl sm:text-2xl font-black text-white\">100</span>\n                </div>\n                <span className=\"text-[11px] sm:text-xs font-mono uppercase tracking-wider text-slate-400 font-semibold\">PLAYERS</span>\n              </div>\n\n              <div className=\"flex flex-col items-center justify-center p-3 rounded-xl bg-gradient-to-b from-amber-500/10 to-slate-900/80 border border-amber-500/30\">\n                <div className=\"flex items-center gap-1.5 text-amber-300 mb-1\">\n                  <Trophy className=\"w-4 h-4 text-amber-400\" />\n                  <span className=\"font-mono text-xl sm:text-2xl font-black text-amber-300\">1</span>\n                </div>\n                <span className=\"text-[11px] sm:text-xs font-mono uppercase tracking-wider text-amber-300 font-semibold\">CHAMPION</span>\n              </div>\n            </div>\n\n            {/* Action Buttons */}\n            <div className=\"flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4\">\n              <button\n                id=\"hero-register-btn\"\n                onClick={onOpenRegister}\n                className=\"w-full sm:w-auto px-8 py-4 rounded-xl bg-gradient-to-r from-violet-600 via-indigo-600 to-purple-600 text-white font-display font-bold text-lg tracking-wider uppercase shadow-xl shadow-violet-600/40 hover:shadow-violet-500/70 hover:scale-[1.02] active:scale-[0.98] transition-all duration-300 flex items-center justify-center gap-3 border border-violet-400/40 group\"\n              >\n                <Flame className=\"w-5 h-5 text-amber-300 group-hover:scale-125 transition-transform\" />\n                <span>Register Now</span>\n                <ArrowRight className=\"w-5 h-5 group-hover:translate-x-1 transition-transform\" />\n              </button>\n\n              <a\n                href=\"#schedule\"\n                id=\"hero-view-schedule-btn\"\n                className=\"w-full sm:w-auto px-7 py-4 rounded-xl bg-slate-900/80 hover:bg-slate-800 text-slate-200 hover:text-white font-display font-semibold text-lg tracking-wider uppercase border border-slate-700 hover:border-violet-500/50 transition-all duration-300 flex items-center justify-center gap-2\"\n              >\n                <Calendar className=\"w-5 h-5 text-violet-400\" />\n                <span>View Schedule</span>\n              </a>\n            </div>\n          </motion.div>\n\n          {/* Right Column: Visual eSports Trophy & Countdown Card */}\n          <motion.div\n            initial={{ opacity: 0, x: 30 }}\n            animate={{ opacity: 1, x: 0 }}\n            transition={{ duration: 0.7, delay: 0.2 }}\n            className=\"lg:col-span-5\"\n          >\n            <div className=\"relative rounded-3xl p-6 sm:p-8 glass-panel-glow border-violet-500/40 overflow-hidden shadow-2xl\">\n              \n              {/* Corner decorative light */}\n              <div className=\"absolute top-0 right-0 w-32 h-32 bg-amber-400/10 rounded-full blur-2xl\" />\n              <div className=\"absolute bottom-0 left-0 w-32 h-32 bg-violet-600/20 rounded-full blur-2xl\" />\n\n              {/* Tournament Centerpiece Visual */}\n              <div className=\"relative text-center mb-6\">\n                <div className=\"relative inline-block mx-auto mb-3\">\n                  {/* Glowing Trophy Ring */}\n                  <div className=\"w-28 h-28 sm:w-36 sm:h-36 rounded-2xl bg-gradient-to-b from-amber-400/20 via-violet-600/20 to-indigo-900/40 border border-amber-400/40 flex items-center justify-center relative shadow-2xl shadow-amber-500/20 group\">\n                    <KingIcon className=\"w-16 h-16 sm:w-20 sm:h-20 text-amber-400 drop-shadow-[0_0_20px_rgba(251,191,36,0.6)]\" glow />\n                    \n                    {/* Orbiting piece badge */}\n                    <div className=\"absolute -top-2 -right-2 w-8 h-8 rounded-lg bg-violet-600 border border-violet-400 flex items-center justify-center text-white shadow-lg\">\n                      <Swords className=\"w-4 h-4 text-amber-300\" />\n                    </div>\n                  </div>\n                </div>\n\n                <h2 className=\"text-xl sm:text-2xl font-display font-extrabold text-white tracking-wide uppercase\">\n                  Championship Countdown\n                </h2>\n                <p className=\"text-xs text-slate-400 font-mono mt-0.5\">\n                  Official Kickoff & First Board Move\n                </p>\n              </div>\n\n              {/* Live Ticking Countdown Timer */}\n              <div className=\"grid grid-cols-4 gap-2 sm:gap-3 mb-6\">\n                <div className=\"flex flex-col items-center justify-center p-3 rounded-xl bg-slate-950/80 border border-violet-500/30\">\n                  <span className=\"font-mono text-2xl sm:text-3xl font-black text-amber-400\">\n                    {String(timeLeft.days).padStart(2, \'0\')}\n                  </span>\n                  <span className=\"text-[10px] sm:text-xs font-mono uppercase tracking-wider text-slate-400 mt-1\">Days</span>\n                </div>\n\n                <div className=\"flex flex-col items-center justify-center p-3 rounded-xl bg-slate-950/80 border border-violet-500/30\">\n                  <span className=\"font-mono text-2xl sm:text-3xl font-black text-white\">\n                    {String(timeLeft.hours).padStart(2, \'0\')}\n                  </span>\n                  <span className=\"text-[10px] sm:text-xs font-mono uppercase tracking-wider text-slate-400 mt-1\">Hours</span>\n                </div>\n\n                <div className=\"flex flex-col items-center justify-center p-3 rounded-xl bg-slate-950/80 border border-violet-500/30\">\n                  <span className=\"font-mono text-2xl sm:text-3xl font-black text-white\">\n                    {String(timeLeft.minutes).padStart(2, \'0\')}\n                  </span>\n                  <span className=\"text-[10px] sm:text-xs font-mono uppercase tracking-wider text-slate-400 mt-1\">Mins</span>\n                </div>\n\n                <div className=\"flex flex-col items-center justify-center p-3 rounded-xl bg-slate-950/80 border border-violet-500/30\">\n                  <span className=\"font-mono text-2xl sm:text-3xl font-black text-violet-400 animate-pulse\">\n                    {String(timeLeft.seconds).padStart(2, \'0\')}\n                  </span>\n                  <span className=\"text-[10px] sm:text-xs font-mono uppercase tracking-wider text-slate-400 mt-1\">Secs</span>\n                </div>\n              </div>\n\n              {/* Tournament Key Highlights Pill */}\n              <div className=\"space-y-2.5 pt-2 border-t border-slate-800 text-xs text-slate-300\">\n                <div className=\"flex items-center justify-between p-2 rounded-lg bg-slate-900/50\">\n                  <span className=\"text-slate-400 flex items-center gap-2\">\n                    <ShieldCheck className=\"w-4 h-4 text-emerald-400\" />\n                    Tournament Rating Cap\n                  </span>\n                  <span className=\"font-mono font-semibold text-white\">Open to All Tiers</span>\n                </div>\n\n                <div className=\"flex items-center justify-between p-2 rounded-lg bg-slate-900/50\">\n                  <span className=\"text-slate-400 flex items-center gap-2\">\n                    <Clock className=\"w-4 h-4 text-violet-400\" />\n                    Time Control\n                  </span>\n                  <span className=\"font-mono font-semibold text-white\">10m + 5s Rapid</span>\n                </div>\n\n                <div className=\"flex items-center justify-between p-2 rounded-lg bg-slate-900/50\">\n                  <span className=\"text-slate-400 flex items-center gap-2\">\n                    <Trophy className=\"w-4 h-4 text-amber-400\" />\n                    Grand Awards\n                  </span>\n                  <span className=\"font-mono font-semibold text-amber-300\">8 Official Titles</span>\n                </div>\n              </div>\n\n            </div>\n          </motion.div>\n\n        </div>"
        replacement_content: "        {/* Main Hero Grid */}\n        <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-center\">\n          \n          {/* Left Column: Headlines & Stats & CTA */}\n          <motion.div\n            initial={{ opacity: 0, x: -30 }}\n            animate={{ opacity: 1, x: 0 }}\n            transition={{ duration: 0.7 }}\n            className=\"lg:col-span-7 text-center lg:text-left\"\n          >\n            {/* Immersive Subtitle */}\n            <h2 className=\"text-[10px] font-bold tracking-[0.4em] text-violet-400 uppercase mb-3\">\n              Grand Invitational 2026 \342\200\242 Inter-College Championship\n            </h2>\n\n            {/* Main Bold Title */}\n            <h1 className=\"text-5xl sm:text-6xl md:text-7xl font-black leading-[0.9] tracking-tight mb-4 uppercase\">\n              CHESS <span className=\"text-gradient-violet\">eSPORTS</span>\n              <br />\n              <span className=\"text-2xl sm:text-4xl text-white font-extrabold tracking-tight\">\n                COMPETE. THINK. CONQUER.\n              </span>\n            </h1>\n\n            {/* Immersive Stat Cards with Left Accent Borders & Glows */}\n            <div className=\"flex flex-col sm:flex-row gap-4 mb-6\">\n              <div className=\"glass p-4 rounded-xl flex-1 border-l-4 border-l-violet-500 glow-violet text-left\">\n                <div className=\"text-2xl sm:text-3xl font-black text-white\">2 DAYS</div>\n                <div className=\"text-[10px] uppercase text-slate-400 font-bold tracking-wider\">Global Event</div>\n              </div>\n\n              <div className=\"glass p-4 rounded-xl flex-1 border-l-4 border-l-amber-500 glow-gold text-left\">\n                <div className=\"text-2xl sm:text-3xl font-black text-white\">100 PLAYERS</div>\n                <div className=\"text-[10px] uppercase text-slate-400 font-bold tracking-wider\">Swiss System</div>\n              </div>\n\n              <div className=\"glass p-4 rounded-xl flex-1 border-l-4 border-l-emerald-500 text-left\">\n                <div className=\"text-2xl sm:text-3xl font-black text-amber-300\">1 CHAMPION</div>\n                <div className=\"text-[10px] uppercase text-slate-400 font-bold tracking-wider\">Grand Crown</div>\n              </div>\n            </div>\n\n            <p className=\"text-slate-300 text-sm sm:text-base leading-relaxed mb-8 pr-0 lg:pr-8\">\n              Experience the ultimate fusion of classic strategy and modern competitive gaming. 100 collegiate tacticians clash under stadium lights with real-time sensor boards and live grandmaster commentary.\n            </p>\n\n            {/* Action Buttons */}\n            <div className=\"flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 mb-8\">\n              <button\n                id=\"hero-register-btn\"\n                onClick={onOpenRegister}\n                className=\"w-full sm:w-64 py-4 bg-violet-600 hover:bg-violet-500 text-white font-bold rounded-lg uppercase tracking-widest shadow-lg shadow-violet-500/25 hover:shadow-violet-500/40 transition-all flex items-center justify-center gap-2 group\"\n              >\n                <Flame className=\"w-5 h-5 text-amber-300 group-hover:scale-110 transition-transform\" />\n                <span>Register Now</span>\n                <ArrowRight className=\"w-4 h-4 group-hover:translate-x-1 transition-transform\" />\n              </button>\n\n              <a\n                href=\"#schedule\"\n                id=\"hero-view-schedule-btn\"\n                className=\"w-full sm:w-auto px-6 py-4 glass border-white/10 hover:border-violet-500/40 text-slate-300 hover:text-white font-bold text-xs uppercase tracking-widest rounded-lg transition-all flex items-center justify-center gap-2\"\n              >\n                <Calendar className=\"w-4 h-4 text-violet-400\" />\n                <span>Explore Schedule</span>\n              </a>\n            </div>\n\n            {/* Tournament Format Box from Immersive UI Spec */}\n            <div className=\"glass p-5 sm:p-6 rounded-2xl text-left\">\n              <h3 className=\"text-xs font-bold uppercase tracking-widest mb-4 text-slate-300 flex items-center justify-between\">\n                <span>Tournament Format</span>\n                <span className=\"text-[10px] font-mono text-violet-400\">10m + 5s Rapid</span>\n              </h3>\n              <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n                <div className=\"flex items-center gap-3\">\n                  <div className=\"w-8 h-8 rounded-full bg-violet-900/50 flex items-center justify-center text-xs font-mono font-bold text-white border border-violet-500 shrink-0\">\n                    01\n                  </div>\n                  <div>\n                    <p className=\"text-xs font-bold text-white\">Day 1: Swiss Rounds</p>\n                    <p className=\"text-[10px] text-slate-400\">5 Rounds \342\200\242 Top 32 Qualify</p>\n                  </div>\n                </div>\n\n                <div className=\"flex items-center gap-3\">\n                  <div className=\"w-8 h-8 rounded-full bg-slate-800 flex items-center justify-center text-xs font-mono font-bold text-amber-400 border border-slate-700 shrink-0\">\n                    02\n                  </div>\n                  <div>\n                    <p className=\"text-xs font-bold text-white\">Day 2: Knockouts</p>\n                    <p className=\"text-[10px] text-slate-400\">Best of 3 \342\200\242 Blitz / Armageddon</p>\n                  </div>\n                </div>\n              </div>\n            </div>\n          </motion.div>\n\n          {/* Right Column: Visual eSports Trophy & Countdown Card */}\n          <motion.div\n            initial={{ opacity: 0, x: 30 }}\n            animate={{ opacity: 1, x: 0 }}\n            transition={{ duration: 0.7, delay: 0.2 }}\n            className=\"lg:col-span-5\"\n          >\n            <div className=\"relative rounded-2xl p-6 sm:p-8 glass glow-violet border-white/10 overflow-hidden shadow-2xl\">\n              \n              {/* Corner decorative light */}\n              <div className=\"absolute top-0 right-0 w-32 h-32 bg-amber-400/10 rounded-full blur-2xl\" />\n              <div className=\"absolute bottom-0 left-0 w-32 h-32 bg-violet-600/20 rounded-full blur-2xl\" />\n\n              {/* Tournament Centerpiece Visual */}\n              <div className=\"relative text-center mb-6\">\n                <div className=\"relative inline-block mx-auto mb-3\">\n                  {/* Glowing Trophy Ring */}\n                  <div className=\"w-24 h-24 sm:w-28 sm:h-28 rounded-2xl bg-gradient-to-b from-amber-400/20 via-violet-600/20 to-indigo-900/40 border border-amber-400/40 flex items-center justify-center relative shadow-2xl shadow-amber-500/20 group\">\n                    <KingIcon className=\"w-14 h-14 sm:w-16 sm:h-16 text-amber-400 drop-shadow-[0_0_20px_rgba(251,191,36,0.6)]\" glow />\n                    \n                    {/* Orbiting piece badge */}\n                    <div className=\"absolute -top-2 -right-2 w-7 h-7 rounded-lg bg-violet-600 border border-violet-400 flex items-center justify-center text-white shadow-lg\">\n                      <Swords className=\"w-3.5 h-3.5 text-amber-300\" />\n                    </div>\n                  </div>\n                </div>\n\n                <h2 className=\"text-lg sm:text-xl font-display font-extrabold text-white tracking-wide uppercase\">\n                  Championship Countdown\n                </h2>\n                <p className=\"text-[10px] text-slate-400 font-mono mt-0.5\">\n                  Official Kickoff & First Board Move\n                </p>\n              </div>\n\n              {/* Live Ticking Countdown Timer */}\n              <div className=\"grid grid-cols-4 gap-2 sm:gap-3 mb-6\">\n                <div className=\"flex flex-col items-center justify-center p-3 rounded-xl bg-black/40 border border-white/5\">\n                  <span className=\"font-mono text-2xl sm:text-3xl font-black text-amber-400\">\n                    {String(timeLeft.days).padStart(2, \'0\')}\n                  </span>\n                  <span className=\"text-[9px] font-mono uppercase tracking-wider text-slate-400 mt-1\">Days</span>\n                </div>\n\n                <div className=\"flex flex-col items-center justify-center p-3 rounded-xl bg-black/40 border border-white/5\">\n                  <span className=\"font-mono text-2xl sm:text-3xl font-black text-white\">\n                    {String(timeLeft.hours).padStart(2, \'0\')}\n                  </span>\n                  <span className=\"text-[9px] font-mono uppercase tracking-wider text-slate-400 mt-1\">Hours</span>\n                </div>\n\n                <div className=\"flex flex-col items-center justify-center p-3 rounded-xl bg-black/40 border border-white/5\">\n                  <span className=\"font-mono text-2xl sm:text-3xl font-black text-white\">\n                    {String(timeLeft.minutes).padStart(2, \'0\')}\n                  </span>\n                  <span className=\"text-[9px] font-mono uppercase tracking-wider text-slate-400 mt-1\">Mins</span>\n                </div>\n\n                <div className=\"flex flex-col items-center justify-center p-3 rounded-xl bg-black/40 border border-white/5\">\n                  <span className=\"font-mono text-2xl sm:text-3xl font-black text-violet-400 animate-pulse\">\n                    {String(timeLeft.seconds).padStart(2, \'0\')}\n                  </span>\n                  <span className=\"text-[9px] font-mono uppercase tracking-wider text-slate-400 mt-1\">Secs</span>\n                </div>\n              </div>\n\n              {/* Tournament Key Highlights Pill */}\n              <div className=\"space-y-2 pt-2 border-t border-white/10 text-xs text-slate-300\">\n                <div className=\"flex items-center justify-between p-2 rounded-lg bg-white/5 border border-white/5\">\n                  <span className=\"text-slate-400 flex items-center gap-2 text-xs\">\n                    <ShieldCheck className=\"w-3.5 h-3.5 text-emerald-400\" />\n                    Rating Cap\n                  </span>\n                  <span className=\"font-mono font-bold text-xs text-white\">Open to All Tiers</span>\n                </div>\n\n                <div className=\"flex items-center justify-between p-2 rounded-lg bg-white/5 border border-white/5\">\n                  <span className=\"text-slate-400 flex items-center gap-2 text-xs\">\n                    <Clock className=\"w-3.5 h-3.5 text-violet-400\" />\n                    Time Control\n                  </span>\n                  <span className=\"font-mono font-bold text-xs text-white\">10m + 5s Rapid</span>\n                </div>\n\n                <div className=\"flex items-center justify-between p-2 rounded-lg bg-white/5 border border-white/5\">\n                  <span className=\"text-slate-400 flex items-center gap-2 text-xs\">\n                    <Trophy className=\"w-3.5 h-3.5 text-amber-400\" />\n                    Grand Awards\n                  </span>\n                  <span className=\"font-mono font-bold text-xs text-amber-300\">8 Official Titles</span>\n                </div>\n              </div>\n\n            </div>\n          </motion.div>\n\n        </div>"
      }
      num_matches: 1
    }
  }
}
