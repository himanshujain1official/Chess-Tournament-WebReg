      target_content: "import React, { useState } from \'react\';\nimport { motion, AnimatePresence } from \'motion/react\';\nimport { \n  X, \n  Flame, \n  CheckCircle2, \n  User, \n  Mail, \n  Phone, \n  Building, \n  Trophy, \n  ShieldCheck, \n  QrCode, \n  Download, \n  Copy, \n  Check, \n  Sparkles,\n  ArrowRight\n} from \'lucide-react\';\nimport confetti from \'canvas-confetti\';\nimport { RegistrationFormData, RegisteredPlayerPass } from \'../types\';\nimport { KingIcon } from \'./ChessGraphics\';\n\ninterface RegistrationModalProps {\n  isOpen: boolean;\n  onClose: () => void;\n}\n\nexport const RegistrationModal: React.FC<RegistrationModalProps> = ({ isOpen, onClose }) => {\n  const [formData, setFormData] = useState<RegistrationFormData>({\n    fullName: \'\',\n    email: \'\',\n    phone: \'\',\n    collegeOrOrg: \'\',\n    ratingType: \'Chess.com\',\n    ratingValue: \'\',\n    experienceLevel: \'Intermediate (1200-1600)\',\n    favoriteOpening: \'Sicilian Defense\',\n    agreeToRules: true\n  });\n\n  const [isSubmitting, setIsSubmitting] = useState(false);\n  const [generatedPass, setGeneratedPass] = useState<RegisteredPlayerPass | null>(null);\n  const [copiedId, setCopiedId] = useState(false);\n\n  const handleSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    setIsSubmitting(true);\n\n    setTimeout(() => {\n      const pass: RegisteredPlayerPass = {\n        passId: `ESP-2026-CH-${Math.floor(1000 + Math.random() * 9000)}`,\n        playerData: { ...formData },\n        registeredAt: new Date().toLocaleDateString(\'en-US\', { month: \'short\', day: \'numeric\', year: \'numeric\' }),\n        assignedSeed: Math.floor(1 + Math.random() * 100),\n        qrCodeSeed: `https://chessesports.event/pass/${Date.now()}`\n      };\n\n      setGeneratedPass(pass);\n      setIsSubmitting(false);\n\n      try {\n        confetti({\n          particleCount: 100,\n          spread: 80,\n          origin: { y: 0.5 },\n          colors: [\'#8b5cf6\', \'#fbbf24\', \'#06b6d4\', \'#10b981\']\n        });\n      } catch {\n        // Confetti fallback\n      }\n    }, 600);\n  };\n\n  const handleCopyPassId = () => {\n    if (generatedPass) {\n      navigator.clipboard?.writeText(generatedPass.passId);\n      setCopiedId(true);\n      setTimeout(() => setCopiedId(false), 2000);\n    }\n  };\n\n  const handleReset = () => {\n    setGeneratedPass(null);\n    setFormData({\n      fullName: \'\',\n      email: \'\',\n      phone: \'\',\n      collegeOrOrg: \'\',\n      ratingType: \'Chess.com\',\n      ratingValue: \'\',\n      experienceLevel: \'Intermediate (1200-1600)\',\n      favoriteOpening: \'Sicilian Defense\',\n      agreeToRules: true\n    });\n  };\n\n  if (!isOpen) return null;\n\n  return (\n    <AnimatePresence>\n      <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 overflow-y-auto\">\n        \n        {/* Backdrop */}\n        <motion.div\n          initial={{ opacity: 0 }}\n          animate={{ opacity: 1 }}\n          exit={{ opacity: 0 }}\n          onClick={onClose}\n          className=\"fixed inset-0 bg-black/80 backdrop-blur-md\"\n        />\n\n        {/* Modal Container */}\n        <motion.div\n          initial={{ opacity: 0, scale: 0.95, y: 20 }}\n          animate={{ opacity: 1, scale: 1, y: 0 }}\n          exit={{ opacity: 0, scale: 0.95, y: 20 }}\n          className=\"relative w-full max-w-2xl bg-[#0f172a] border border-white/10 glass glow-violet rounded-3xl p-6 sm:p-8 shadow-2xl z-10 my-8 max-h-[90vh] overflow-y-auto\"\n        >\n          {/* Close button */}\n          <button\n            id=\"close-registration-modal-btn\"\n            onClick={onClose}\n            className=\"absolute top-5 right-5 p-2 rounded-xl bg-black/40 border border-white/10 text-slate-400 hover:text-white hover:border-violet-500 transition-colors\"\n          >\n            <X className=\"w-5 h-5\" />\n          </button>\n\n          {!generatedPass ? (\n            <div>\n              {/* Header */}\n              <div className=\"flex items-center gap-3 mb-6 pb-4 border-b border-white/10\">\n                <div className=\"w-12 h-12 rounded-2xl bg-violet-600/30 border border-violet-500/50 flex items-center justify-center text-amber-400\">\n                  <Flame className=\"w-6 h-6\" />\n                </div>\n                <div>\n                  <span className=\"text-[10px] font-mono uppercase font-bold text-amber-400 tracking-wider\">\n                    Limited to 100 Players\n                  </span>\n                  <h3 className=\"text-2xl font-display font-extrabold text-white uppercase tracking-wide\">\n                    Tournament Registration\n                  </h3>\n                </div>\n              </div>\n\n              {/* Registration Form */}\n              <form onSubmit={handleSubmit} className=\"space-y-4\">\n                \n                {/* Full Name & Email */}\n                <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n                  <div>\n                    <label className=\"block text-xs font-mono font-medium text-slate-300 mb-1\">\n                      Full Name *\n                    </label>\n                    <div className=\"relative\">\n                      <User className=\"w-4 h-4 text-slate-500 absolute left-3.5 top-1/2 -translate-y-1/2\" />\n                      <input\n                        type=\"text\"\n                        required\n                        value={formData.fullName}\n                        onChange={(e) => setFormData({ ...formData, fullName: e.target.value })}\n                        placeholder=\"e.g. Magnus Vance\"\n                        className=\"w-full pl-10 pr-4 py-2.5 rounded-xl bg-black/40 border border-white/10 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-violet-500\"\n                      />\n                    </div>\n                  </div>\n\n                  <div>\n                    <label className=\"block text-xs font-mono font-medium text-slate-300 mb-1\">\n                      Email Address *\n                    </label>\n                    <div className=\"relative\">\n                      <Mail className=\"w-4 h-4 text-slate-500 absolute left-3.5 top-1/2 -translate-y-1/2\" />\n                      <input\n                        type=\"email\"\n                        required\n                        value={formData.email}\n                        onChange={(e) => setFormData({ ...formData, email: e.target.value })}\n                        placeholder=\"e.g. player@university.edu\"\n                        className=\"w-full pl-10 pr-4 py-2.5 rounded-xl bg-black/40 border border-white/10 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-violet-500\"\n                      />\n                    </div>\n                  </div>\n                </div>\n\n                {/* College / Organization & Phone */}\n                <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n                  <div>\n                    <label className=\"block text-xs font-mono font-medium text-slate-300 mb-1\">\n                      College / Institute / Team *\n                    </label>\n                    <div className=\"relative\">\n                      <Building className=\"w-4 h-4 text-slate-500 absolute left-3.5 top-1/2 -translate-y-1/2\" />\n                      <input\n                        type=\"text\"\n                        required\n                        value={formData.collegeOrOrg}\n                        onChange={(e) => setFormData({ ...formData, collegeOrOrg: e.target.value })}\n                        placeholder=\"e.g. Delhi University / MIT\"\n                        className=\"w-full pl-10 pr-4 py-2.5 rounded-xl bg-black/40 border border-white/10 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-violet-500\"\n                      />\n                    </div>\n                  </div>\n\n                  <div>\n                    <label className=\"block text-xs font-mono font-medium text-slate-300 mb-1\">\n                      Contact Number *\n                    </label>\n                    <div className=\"relative\">\n                      <Phone className=\"w-4 h-4 text-slate-500 absolute left-3.5 top-1/2 -translate-y-1/2\" />\n                      <input\n                        type=\"tel\"\n                        required\n                        value={formData.phone}\n                        onChange={(e) => setFormData({ ...formData, phone: e.target.value })}\n                        placeholder=\"+91 98765 43210\"\n                        className=\"w-full pl-10 pr-4 py-2.5 rounded-xl bg-black/40 border border-white/10 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-violet-500\"\n                      />\n                    </div>\n                  </div>\n                </div>\n\n                {/* Rating System & Rating Value */}\n                <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n                  <div>\n                    <label className=\"block text-xs font-mono font-medium text-slate-300 mb-1\">\n                      Rating Platform\n                    </label>\n                    <select\n                      value={formData.ratingType}\n                      onChange={(e) => setFormData({ ...formData, ratingType: e.target.value as any })}\n                      className=\"w-full px-4 py-2.5 rounded-xl bg-black/40 border border-white/10 text-sm text-white focus:outline-none focus:border-violet-500\"\n                    >\n                      <option value=\"Chess.com\" className=\"bg-slate-900 text-white\">Chess.com Blitz / Rapid</option>\n                      <option value=\"FIDE\" className=\"bg-slate-900 text-white\">FIDE Official Standard / Rapid</option>\n                      <option value=\"Lichess\" className=\"bg-slate-900 text-white\">Lichess.org Rating</option>\n                      <option value=\"Unrated\" className=\"bg-slate-900 text-white\">Unrated Competitor</option>\n                    </select>\n                  </div>\n\n                  <div>\n                    <label className=\"block text-xs font-mono font-medium text-slate-300 mb-1\">\n                      Current Rating Score\n                    </label>\n                    <input\n                      type=\"text\"\n                      value={formData.ratingValue}\n                      onChange={(e) => setFormData({ ...formData, ratingValue: e.target.value })}\n                      placeholder=\"e.g. 1750 (Leave blank if unrated)\"\n                      className=\"w-full px-4 py-2.5 rounded-xl bg-black/40 border border-white/10 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-violet-500\"\n                    />\n                  </div>\n                </div>\n\n                {/* Experience Tier & Favorite Opening */}\n                <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n                  <div>\n                    <label className=\"block text-xs font-mono font-medium text-slate-300 mb-1\">\n                      Experience Tier\n                    </label>\n                    <select\n                      value={formData.experienceLevel}\n                      onChange={(e) => setFormData({ ...formData, experienceLevel: e.target.value as any })}\n                      className=\"w-full px-4 py-2.5 rounded-xl bg-black/40 border border-white/10 text-sm text-white focus:outline-none focus:border-violet-500\"\n                    >\n                      <option value=\"Beginner (<1200)\" className=\"bg-slate-900 text-white\">Beginner (&lt;1200)</option>\n                      <option value=\"Intermediate (1200-1600)\" className=\"bg-slate-900 text-white\">Intermediate (1200-1600)</option>\n                      <option value=\"Advanced (1600-2000)\" className=\"bg-slate-900 text-white\">Advanced (1600-2000)</option>\n                      <option value=\"Master/Expert (2000+)\" className=\"bg-slate-900 text-white\">Master / Expert (2000+)</option>\n                    </select>\n                  </div>\n\n                  <div>\n                    <label className=\"block text-xs font-mono font-medium text-slate-300 mb-1\">\n                      Favorite Opening / Play Style\n                    </label>\n                    <input\n                      type=\"text\"\n                      value={formData.favoriteOpening}\n                      onChange={(e) => setFormData({ ...formData, favoriteOpening: e.target.value })}\n                      placeholder=\"e.g. Sicilian Defense, Queen\'s Gambit\"\n                      className=\"w-full px-4 py-2.5 rounded-xl bg-black/40 border border-white/10 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-violet-500\"\n                    />\n                  </div>\n                </div>\n\n                {/* Agree to Rules Checkbox */}\n                <div className=\"p-3.5 rounded-xl bg-violet-950/40 border border-violet-500/30 flex items-start gap-3\">\n                  <input\n                    type=\"checkbox\"\n                    id=\"agree-rules\"\n                    required\n                    checked={formData.agreeToRules}\n                    onChange={(e) => setFormData({ ...formData, agreeToRules: e.target.checked })}\n                    className=\"mt-1 rounded border-slate-700 text-violet-600 focus:ring-violet-500\"\n                  />\n                  <label htmlFor=\"agree-rules\" className=\"text-xs text-slate-300 leading-relaxed cursor-pointer\">\n                    I agree to the tournament regulations: FIDE compliance, no electronic devices, punctual presence 10 mins prior to rounds, and arbiters&apos; supreme decisions.\n                  </label>\n                </div>\n\n                {/* Submit button */}\n                <button\n                  type=\"submit\"\n                  disabled={isSubmitting}\n                  className=\"w-full py-3.5 rounded-xl bg-violet-600 hover:bg-violet-500 text-white font-bold text-sm tracking-wider uppercase shadow-lg shadow-violet-600/30 flex items-center justify-center gap-2 transition-all\"\n                >\n                  {isSubmitting ? (\n                    <span>Allocating Bracket Slot...</span>\n                  ) : (\n                    <>\n                      <Flame className=\"w-4 h-4 text-amber-300\" />\n                      <span>Complete Registration & Issue Player Pass</span>\n                    </>\n                  )}\n                </button>\n              </form>\n            </div>\n          ) : (\n            /* Generated Digital Pass */\n            <div className=\"text-center\">\n              \n              <div className=\"w-16 h-16 rounded-full bg-emerald-500/20 border border-emerald-400/40 flex items-center justify-center text-emerald-400 mx-auto mb-4\">\n                <CheckCircle2 className=\"w-8 h-8\" />\n              </div>\n\n              <h3 className=\"text-2xl sm:text-3xl font-display font-extrabold text-white uppercase tracking-wide mb-1\">\n                Registration Confirmed!\n              </h3>\n              <p className=\"text-xs font-mono text-amber-400 uppercase tracking-widest mb-6\">\n                You are officially registered for the 100-Player Championship\n              </p>\n\n              {/* Digital Pass Ticket Card */}\n              <div className=\"rounded-2xl p-6 glass glow-gold border-2 border-amber-400/50 shadow-2xl relative text-left mb-6 overflow-hidden\">\n                \n                {/* Decorative cutouts on ticket sides */}\n                <div className=\"absolute -left-3 top-1/2 -translate-y-1/2 w-6 h-6 rounded-full bg-[#0f172a]\" />\n                <div className=\"absolute -right-3 top-1/2 -translate-y-1/2 w-6 h-6 rounded-full bg-[#0f172a]\" />\n\n\n                <div className=\"flex items-center justify-between pb-4 border-b border-dashed border-white/20 mb-4\">\n                  <div className=\"flex items-center gap-2\">\n                    <KingIcon className=\"w-6 h-6 text-amber-400\" glow />\n                    <span className=\"font-display font-black text-white text-lg tracking-wider\">\n                      CHESS <span className=\"text-violet-400\">eSPORTS PASS</span>\n                    </span>\n                  </div>\n                  <span className=\"px-2.5 py-1 rounded bg-emerald-950/80 border border-emerald-500/40 text-emerald-300 text-[10px] font-mono font-bold uppercase\">\n                    SEEDED & READY\n                  </span>\n                </div>\n\n                <div className=\"grid grid-cols-2 gap-4 text-xs font-mono mb-4\">\n                  <div>\n                    <span className=\"text-slate-400 block text-[10px]\">Competitor Name</span>\n                    <span className=\"font-bold text-white text-sm\">{generatedPass.playerData.fullName}</span>\n                  </div>\n                  <div>\n                    <span className=\"text-slate-400 block text-[10px]\">College / Institute</span>\n                    <span className=\"font-bold text-slate-200\">{generatedPass.playerData.collegeOrOrg}</span>\n                  </div>\n                  <div>\n                    <span className=\"text-slate-400 block text-[10px]\">Pass ID</span>\n                    <span className=\"font-bold text-amber-300 font-mono\">{generatedPass.passId}</span>\n                  </div>\n                  <div>\n                    <span className=\"text-slate-400 block text-[10px]\">Rating System</span>\n                    <span className=\"font-bold text-violet-300\">\n                      {generatedPass.playerData.ratingType} {generatedPass.playerData.ratingValue ? `(${generatedPass.playerData.ratingValue})` : \'\'}\n                    </span>\n                  </div>\n                </div>\n\n                <div className=\"pt-3 border-t border-white/10 flex items-center justify-between text-[11px] font-mono text-slate-400\">\n                  <span>Day 1 Swiss Round 1: 10:00 AM</span>\n                  <span className=\"text-amber-400 font-bold\">Bring Govt ID</span>\n                </div>\n              </div>\n\n              {/* Action Buttons */}\n              <div className=\"flex flex-col sm:flex-row gap-3\">\n                <button\n                  onClick={handleCopyPassId}\n                  className=\"flex-1 py-3 rounded-xl bg-black/40 border border-white/10 hover:border-violet-500 text-slate-200 text-sm font-mono flex items-center justify-center gap-2 transition-colors\"\n                >\n                  {copiedId ? <Check className=\"w-4 h-4 text-emerald-400\" /> : <Copy className=\"w-4 h-4\" />}\n                  <span>{copiedId ? \'Pass ID Copied!\' : \'Copy Pass ID\'}</span>\n                </button>\n\n                <button\n                  onClick={onClose}\n                  className=\"flex-1 py-3 rounded-xl bg-violet-600 hover:bg-violet-500 text-white font-bold text-sm uppercase tracking-wider shadow-lg shadow-violet-600/30\"\n                >\n                  Done\n                </button>\n              </div>\n\n            </div>\n          )}\n\n        </motion.div>\n\n      </div>\n    </AnimatePresence>\n  );\n};"
      replacement_content: "import React, { useState } from \'react\';\nimport { motion, AnimatePresence } from \'motion/react\';\nimport { \n  X, \n  CheckCircle2, \n  User, \n  Mail, \n  Phone, \n  Building, \n  Copy, \n  Check, \n  ArrowRight\n} from \'lucide-react\';\nimport { RegistrationFormData, RegisteredPlayerPass } from \'../types\';\nimport { KingIcon } from \'./ChessGraphics\';\n\ninterface RegistrationModalProps {\n  isOpen: boolean;\n  onClose: () => void;\n}\n\nexport const RegistrationModal: React.FC<RegistrationModalProps> = ({ isOpen, onClose }) => {\n  const [formData, setFormData] = useState<RegistrationFormData>({\n    fullName: \'\',\n    email: \'\',\n    phone: \'\',\n    collegeOrOrg: \'\',\n    ratingType: \'Chess.com\',\n    ratingValue: \'\',\n    experienceLevel: \'Intermediate (1200-1600)\',\n    favoriteOpening: \'Sicilian Defense\',\n    agreeToRules: true\n  });\n\n  const [isSubmitting, setIsSubmitting] = useState(false);\n  const [generatedPass, setGeneratedPass] = useState<RegisteredPlayerPass | null>(null);\n  const [copiedId, setCopiedId] = useState(false);\n\n  const handleSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    setIsSubmitting(true);\n\n    setTimeout(() => {\n      const pass: RegisteredPlayerPass = {\n        passId: `ESP-2026-CH-${Math.floor(1000 + Math.random() * 9000)}`,\n        playerData: { ...formData },\n        registeredAt: new Date().toLocaleDateString(\'en-US\', { month: \'short\', day: \'numeric\', year: \'numeric\' }),\n        assignedSeed: Math.floor(1 + Math.random() * 100),\n        qrCodeSeed: `https://chessesports.event/pass/${Date.now()}`\n      };\n\n      setGeneratedPass(pass);\n      setIsSubmitting(false);\n    }, 400);\n  };\n\n  const handleCopyPassId = () => {\n    if (generatedPass) {\n      navigator.clipboard?.writeText(generatedPass.passId);\n      setCopiedId(true);\n      setTimeout(() => setCopiedId(false), 2000);\n    }\n  };\n\n  const handleReset = () => {\n    setGeneratedPass(null);\n    setFormData({\n      fullName: \'\',\n      email: \'\',\n      phone: \'\',\n      collegeOrOrg: \'\',\n      ratingType: \'Chess.com\',\n      ratingValue: \'\',\n      experienceLevel: \'Intermediate (1200-1600)\',\n      favoriteOpening: \'Sicilian Defense\',\n      agreeToRules: true\n    });\n  };\n\n  if (!isOpen) return null;\n\n  return (\n    <AnimatePresence>\n      <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 overflow-y-auto\">\n        \n        {/* Backdrop */}\n        <motion.div\n          initial={{ opacity: 0 }}\n          animate={{ opacity: 1 }}\n          exit={{ opacity: 0 }}\n          onClick={onClose}\n          className=\"fixed inset-0 bg-black/85 backdrop-blur-sm\"\n        />\n\n        {/* Modal Container */}\n        <motion.div\n          initial={{ opacity: 0, scale: 0.98, y: 10 }}\n          animate={{ opacity: 1, scale: 1, y: 0 }}\n          exit={{ opacity: 0, scale: 0.98, y: 10 }}\n          className=\"relative w-full max-w-xl bg-zinc-950 border border-zinc-800 rounded-xl p-6 sm:p-8 shadow-2xl z-10 my-8 max-h-[90vh] overflow-y-auto font-mono text-zinc-300\"\n        >\n          {/* Close button */}\n          <button\n            id=\"close-registration-modal-btn\"\n            onClick={onClose}\n            className=\"absolute top-5 right-5 p-2 rounded bg-zinc-900 border border-zinc-800 text-zinc-400 hover:text-white hover:border-zinc-600 transition-colors\"\n          >\n            <X className=\"w-4 h-4\" />\n          </button>\n\n          {!generatedPass ? (\n            <div>\n              {/* Header */}\n              <div className=\"flex items-center gap-3 mb-6 pb-4 border-b border-zinc-800\">\n                <div className=\"w-10 h-10 rounded-lg bg-zinc-900 border border-zinc-800 flex items-center justify-center text-white\">\n                  <KingIcon className=\"w-5 h-5\" />\n                </div>\n                <div>\n                  <span className=\"text-[10px] uppercase font-bold text-zinc-400 tracking-widest block\">\n                    Tournament Registration\n                  </span>\n                  <h3 className=\"text-xl font-display font-black text-white uppercase tracking-wide\">\n                    Player Entry Form\n                  </h3>\n                </div>\n              </div>\n\n              {/* Registration Form */}\n              <form onSubmit={handleSubmit} className=\"space-y-4 text-xs\">\n                \n                {/* Full Name & Email */}\n                <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n                  <div>\n                    <label className=\"block text-[11px] uppercase font-semibold text-zinc-400 mb-1.5\">\n                      Full Name *\n                    </label>\n                    <div className=\"relative\">\n                      <User className=\"w-3.5 h-3.5 text-zinc-500 absolute left-3 top-1/2 -translate-y-1/2\" />\n                      <input\n                        type=\"text\"\n                        required\n                        value={formData.fullName}\n                        onChange={(e) => setFormData({ ...formData, fullName: e.target.value })}\n                        placeholder=\"Player Name\"\n                        className=\"w-full pl-9 pr-3 py-2 rounded bg-zinc-900 border border-zinc-800 text-white placeholder-zinc-600 focus:outline-none focus:border-zinc-500\"\n                      />\n                    </div>\n                  </div>\n\n                  <div>\n                    <label className=\"block text-[11px] uppercase font-semibold text-zinc-400 mb-1.5\">\n                      Email Address *\n                    </label>\n                    <div className=\"relative\">\n                      <Mail className=\"w-3.5 h-3.5 text-zinc-500 absolute left-3 top-1/2 -translate-y-1/2\" />\n                      <input\n                        type=\"email\"\n                        required\n                        value={formData.email}\n                        onChange={(e) => setFormData({ ...formData, email: e.target.value })}\n                        placeholder=\"player@domain.com\"\n                        className=\"w-full pl-9 pr-3 py-2 rounded bg-zinc-900 border border-zinc-800 text-white placeholder-zinc-600 focus:outline-none focus:border-zinc-500\"\n                      />\n                    </div>\n                  </div>\n                </div>\n\n                {/* College / Organization & Phone */}\n                <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n                  <div>\n                    <label className=\"block text-[11px] uppercase font-semibold text-zinc-400 mb-1.5\">\n                      College / Organization *\n                    </label>\n                    <div className=\"relative\">\n                      <Building className=\"w-3.5 h-3.5 text-zinc-500 absolute left-3 top-1/2 -translate-y-1/2\" />\n                      <input\n                        type=\"text\"\n                        required\n                        value={formData.collegeOrOrg}\n                        onChange={(e) => setFormData({ ...formData, collegeOrOrg: e.target.value })}\n                        placeholder=\"Institution / Team\"\n                        className=\"w-full pl-9 pr-3 py-2 rounded bg-zinc-900 border border-zinc-800 text-white placeholder-zinc-600 focus:outline-none focus:border-zinc-500\"\n                      />\n                    </div>\n                  </div>\n\n                  <div>\n                    <label className=\"block text-[11px] uppercase font-semibold text-zinc-400 mb-1.5\">\n                      Contact Number *\n                    </label>\n                    <div className=\"relative\">\n                      <Phone className=\"w-3.5 h-3.5 text-zinc-500 absolute left-3 top-1/2 -translate-y-1/2\" />\n                      <input\n                        type=\"tel\"\n                        required\n                        value={formData.phone}\n                        onChange={(e) => setFormData({ ...formData, phone: e.target.value })}\n                        placeholder=\"+1 555-0199\"\n                        className=\"w-full pl-9 pr-3 py-2 rounded bg-zinc-900 border border-zinc-800 text-white placeholder-zinc-600 focus:outline-none focus:border-zinc-500\"\n                      />\n                    </div>\n                  </div>\n                </div>\n\n                {/* Rating System & Rating Value */}\n                <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n                  <div>\n                    <label className=\"block text-[11px] uppercase font-semibold text-zinc-400 mb-1.5\">\n                      Rating Platform\n                    </label>\n                    <select\n                      value={formData.ratingType}\n                      onChange={(e) => setFormData({ ...formData, ratingType: e.target.value as any })}\n                      className=\"w-full px-3 py-2 rounded bg-zinc-900 border border-zinc-800 text-white focus:outline-none focus:border-zinc-500\"\n                    >\n                      <option value=\"Chess.com\">Chess.com</option>\n                      <option value=\"FIDE\">FIDE Standard/Rapid</option>\n                      <option value=\"Lichess\">Lichess.org</option>\n                      <option value=\"Unrated\">Unrated</option>\n                    </select>\n                  </div>\n\n                  <div>\n                    <label className=\"block text-[11px] uppercase font-semibold text-zinc-400 mb-1.5\">\n                      Rating Score\n                    </label>\n                    <input\n                      type=\"text\"\n                      value={formData.ratingValue}\n                      onChange={(e) => setFormData({ ...formData, ratingValue: e.target.value })}\n                      placeholder=\"Optional\"\n                      className=\"w-full px-3 py-2 rounded bg-zinc-900 border border-zinc-800 text-white placeholder-zinc-600 focus:outline-none focus:border-zinc-500\"\n                    />\n                  </div>\n                </div>\n\n                {/* Agree to Rules Checkbox */}\n                <div className=\"p-3 rounded bg-zinc-900 border border-zinc-800 flex items-start gap-3\">\n                  <input\n                    type=\"checkbox\"\n                    id=\"agree-rules\"\n                    required\n                    checked={formData.agreeToRules}\n                    onChange={(e) => setFormData({ ...formData, agreeToRules: e.target.checked })}\n                    className=\"mt-0.5 rounded border-zinc-700 text-white focus:ring-0\"\n                  />\n                  <label htmlFor=\"agree-rules\" className=\"text-[11px] text-zinc-400 leading-relaxed cursor-pointer\">\n                    I confirm adherence to the tournament rules, fair-play guidelines, and arbiter decisions.\n                  </label>\n                </div>\n\n                {/* Submit button */}\n                <button\n                  type=\"submit\"\n                  disabled={isSubmitting}\n                  className=\"w-full py-3 rounded bw-btn-primary font-bold text-xs uppercase tracking-wider flex items-center justify-center gap-2 transition-all mt-2\"\n                >\n                  {isSubmitting ? (\n                    <span>Registering...</span>\n                  ) : (\n                    <>\n                      <span>Complete Registration</span>\n                      <ArrowRight className=\"w-3.5 h-3.5\" />\n                    </>\n                  )}\n                </button>\n              </form>\n            </div>\n          ) : (\n            /* Generated Digital Pass */\n            <div className=\"text-center font-mono\">\n              \n              <div className=\"w-12 h-12 rounded-full bg-zinc-900 border border-zinc-700 flex items-center justify-center text-white mx-auto mb-3\">\n                <CheckCircle2 className=\"w-6 h-6\" />\n              </div>\n\n              <h3 className=\"text-xl font-display font-black text-white uppercase tracking-wide mb-1\">\n                Registration Confirmed\n              </h3>\n              <p className=\"text-xs text-zinc-400 mb-6\">\n                Your entry has been recorded for the tournament.\n              </p>\n\n              {/* Digital Pass Ticket Card */}\n              <div className=\"rounded-lg p-5 bg-zinc-900 border border-zinc-800 text-left mb-6 text-xs\">\n                <div className=\"flex items-center justify-between pb-3 border-b border-zinc-800 mb-3\">\n                  <div className=\"flex items-center gap-2\">\n                    <KingIcon className=\"w-4 h-4 text-white\" />\n                    <span className=\"font-bold text-white uppercase tracking-wider\">\n                      PLAYER PASS\n                    </span>\n                  </div>\n                  <span className=\"px-2 py-0.5 rounded bg-white text-black text-[10px] font-bold uppercase\">\n                    CONFIRMED\n                  </span>\n                </div>\n\n                <div className=\"grid grid-cols-2 gap-3 mb-3\">\n                  <div>\n                    <span className=\"text-zinc-500 block text-[10px] uppercase\">Competitor</span>\n                    <span className=\"font-bold text-white\">{generatedPass.playerData.fullName}</span>\n                  </div>\n                  <div>\n                    <span className=\"text-zinc-500 block text-[10px] uppercase\">Institution</span>\n                    <span className=\"font-bold text-zinc-300\">{generatedPass.playerData.collegeOrOrg}</span>\n                  </div>\n                  <div>\n                    <span className=\"text-zinc-500 block text-[10px] uppercase\">Pass ID</span>\n                    <span className=\"font-bold text-white\">{generatedPass.passId}</span>\n                  </div>\n                  <div>\n                    <span className=\"text-zinc-500 block text-[10px] uppercase\">Rating</span>\n                    <span className=\"font-bold text-zinc-300\">\n                      {generatedPass.playerData.ratingType} {generatedPass.playerData.ratingValue ? `(${generatedPass.playerData.ratingValue})` : \'\'}\n                    </span>\n                  </div>\n                </div>\n\n                <div className=\"pt-2 border-t border-zinc-800 flex items-center justify-between text-[10px] text-zinc-500\">\n                  <span>Day 1 Check-in: 09:00 AM</span>\n                  <span className=\"text-zinc-300\">Valid ID Required</span>\n                </div>\n              </div>\n\n              {/* Action Buttons */}\n              <div className=\"flex flex-col sm:flex-row gap-2\">\n                <button\n                  onClick={handleCopyPassId}\n                  className=\"flex-1 py-2.5 rounded bw-btn-secondary text-xs flex items-center justify-center gap-1.5\"\n                >\n                  {copiedId ? <Check className=\"w-3.5 h-3.5\" /> : <Copy className=\"w-3.5 h-3.5\" />}\n                  <span>{copiedId ? \'Copied\' : \'Copy Pass ID\'}</span>\n                </button>\n\n                <button\n                  onClick={onClose}\n                  className=\"flex-1 py-2.5 rounded bw-btn-primary text-xs font-bold uppercase tracking-wider\"\n                >\n                  Done\n                </button>\n              </div>\n\n            </div>\n          )}\n\n        </motion.div>\n\n      </div>\n    </AnimatePresence>\n  );\n};"
    }
